<!-- ===== SCRIPTS ===== -->
<script>
(function(){
    // Intersection Observer for fade animations
    var obs = new IntersectionObserver(function(entries){
        entries.forEach(function(entry, i){
            if(entry.isIntersecting){
                setTimeout(function(){ entry.target.classList.add('t-visible'); }, i * 80);
                obs.unobserve(entry.target);
            }
        });
    }, {threshold: 0.1, rootMargin: '0px 0px -40px 0px'});
    document.querySelectorAll('.mcm-truck .t-fade').forEach(function(el){ obs.observe(el); });

    // FAQ accordion
    document.querySelectorAll('.mcm-truck .t-faq-q').forEach(function(q){
        q.addEventListener('click', function(){
            var item = this.closest('.t-faq-item');
            var wasActive = item.classList.contains('active');
            document.querySelectorAll('.mcm-truck .t-faq-item').forEach(function(i){ i.classList.remove('active'); });
            if(!wasActive) item.classList.add('active');
        });
    });

    // Form modals
    function openForm(type){
        if(type === 'host') {
            document.getElementById('host-form-overlay').classList.add('active');
            document.body.style.overflow = 'hidden';
        }
    }
    function closeForm(){
        document.querySelectorAll('.mcm-truck .t-form-overlay').forEach(function(o){ o.classList.remove('active'); });
        document.body.style.overflow = '';
    }
    document.querySelectorAll('.mcm-truck [data-form]').forEach(function(btn){
        btn.addEventListener('click', function(e){
            e.preventDefault();
            openForm(this.getAttribute('data-form'));
        });
    });
    document.querySelectorAll('.mcm-truck a[href="#booking-section"]').forEach(function(link){
        link.addEventListener('click', function(e){
            e.preventDefault();
            document.getElementById('booking-section').scrollIntoView({ behavior: 'smooth' });
        });
    });
    document.querySelectorAll('.mcm-truck .t-form-close').forEach(function(btn){
        btn.addEventListener('click', closeForm);
    });
    document.querySelectorAll('.mcm-truck .t-form-overlay').forEach(function(overlay){
        overlay.addEventListener('click', function(e){
            if(e.target === this) closeForm();
        });
    });
})();
</script>

