<div class="mcm-truck">

<!-- ===== HERO ===== -->
<section class="t-hero">
    <div class="t-hero-bg">
        <img src="https://cdn.shopify.com/s/files/1/0813/4036/7096/files/truck-couple-trial.png" alt="Massage Chairs and More Mobile Showroom Truck — We Bring the Showroom to Your Driveway" loading="eager">
    </div>
    <div class="t-container">
        <div class="t-hero-content">
            <span class="t-eyebrow">MC Massage and More · Bay Area Mobile Showroom</span>
            <h1>We Bring the Showroom<br>to Your Driveway</h1>
            <p>Book a massage chair demo — we bring premium chairs to your home, workplace, or community so you can try before you decide. Rest for the soul &amp; body.</p>
            <div class="t-hero-btns">
                <a href="#booking-section" class="t-btn t-btn-primary">Book a Mobile Demo</a>
                <a href="#" class="t-btn t-btn-white" data-form="host" id="hero-host-truck">Host the Truck at Your Event</a>
            </div>
            <div class="t-hero-trust">(408) 889-1188 <span>·</span> massagechairsandmore.com <span>·</span> Bay Area</div>
        </div>
    </div>
</section>

<!-- ===== EMBEDDED BOOKING SECTION ===== -->
<section id="booking-section" class="t-section t-booking-section">
    <div class="t-container">
        <div class="t-booking-grid">
            
            <div class="t-booking-info t-fade">
                <span class="t-eyebrow">Special Couple Trial</span>
                <h2>Because Great Decisions Are Made Together</h2>
                <div class="t-booking-info-content">
                    <p>Buying a premium massage chair is a shared decision. We believe you and your partner should experience the comfort side by side, right in your own driveway.</p>
                    <ul class="t-booking-benefits">
                        <li>
                            <div class="t-benefit-icon"><svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 15l-5-5 1.41-1.41L11 14.17l7.59-7.59L20 8l-9 9z"/></svg></div>
                            <div><strong>Try Side-by-Side:</strong> Test multiple premium models together and compare the differences.</div>
                        </li>
                        <li>
                            <div class="t-benefit-icon"><svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 15l-5-5 1.41-1.41L11 14.17l7.59-7.59L20 8l-9 9z"/></svg></div>
                            <div><strong>Zero Pressure:</strong> Enjoy an expert-guided demo with no obligations to purchase.</div>
                        </li>
                        <li>
                            <div class="t-benefit-icon"><svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 15l-5-5 1.41-1.41L11 14.17l7.59-7.59L20 8l-9 9z"/></svg></div>
                            <div><strong>Ultimate Convenience:</strong> Forget driving to a showroom. We bring the showroom and the espresso directly to you.</div>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="t-booking-form-wrapper t-fade">
                <div class="t-booking-form-box">
                    <h3>Book Your Mobile Demo</h3>
                    <p>Fill out the form below to request a visit anywhere in the Bay Area.</p>
                    {% form 'contact' %}
                    <div class="t-form">
                        <input type="hidden" name="contact[subject]" value="Mobile Demo Request">
                        <div class="t-form-row">
                            <div class="t-fg"><label for="demo-name">Your Name *</label><input type="text" id="demo-name" name="contact[name]" placeholder="John Doe" required></div>
                            <div class="t-fg"><label for="demo-email">Email *</label><input type="email" id="demo-email" name="contact[email]" placeholder="john@example.com" required></div>
                        </div>
                        <div class="t-form-row">
                            <div class="t-fg"><label for="demo-phone">Phone *</label><input type="tel" id="demo-phone" name="contact[phone]" placeholder="+1 (xxx) xxx-xxxx" required></div>
                            <div class="t-fg"><label for="demo-zip">Zip Code</label><input type="text" id="demo-zip" name="contact[zip]" placeholder="e.g. 95050"></div>
                        </div>
                        <div class="t-fg"><label for="demo-pref">Preferred Date &amp; Time</label><input type="text" id="demo-pref" name="contact[preferred_time]" placeholder="e.g. Saturday morning, weekday after 5pm"></div>
                        <div class="t-fg"><label for="demo-notes">Anything Else?</label><textarea id="demo-notes" name="contact[body]" placeholder="Who will be trying the chairs? Models you want to see?"></textarea></div>
                        <button type="submit" class="t-form-submit">Request My Demo</button>
                    </div>
                    {% endform %}
                </div>
            </div>

        </div>
    </div>
</section>

<!-- ===== HOW IT WORKS ===== -->
<section class="t-section t-section-alt">
