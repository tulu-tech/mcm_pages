<script>
(function () {
  var pins = document.querySelectorAll('.m8m1__zone-mpin');
  if (!pins.length) return;
  pins.forEach(function (pin) {
    var listId = pin.getAttribute('data-target');
    var pinId = pin.getAttribute('data-pin');
    var list = document.getElementById(listId);
    if (!list) return;
    var items = list.querySelectorAll('li');
    var siblings = pin.parentElement.querySelectorAll('.m8m1__zone-mpin');

    function activate() {
      siblings.forEach(function (s) { s.classList.remove('is-active'); });
      pin.classList.add('is-active');
      list.classList.add('is-filtering');
      items.forEach(function (li) {
        li.classList.toggle('is-active', li.getAttribute('data-pin') === pinId);
      });
    }
    function deactivate() {
      pin.classList.remove('is-active');
      list.classList.remove('is-filtering');
      items.forEach(function (li) { li.classList.remove('is-active'); });
    }
    pin.addEventListener('mouseenter', activate);
    pin.addEventListener('mouseleave', deactivate);
    pin.addEventListener('focus', activate);
    pin.addEventListener('blur', deactivate);
    pin.addEventListener('click', function () { activate(); });
  });
})();
</script>

