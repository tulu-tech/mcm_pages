  position: relative;
  padding-left: 22px;
  color: var(--muted);
  font-size: 14px;
  line-height: 1.55;
}

.m8m1__zone-note li::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0.62em;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--gold);
}

.m8m1__zone-note--green li::before {
  background: var(--green);
}

.m8m1__quick-grid,
.m8m1__product-grid,
.m8m1__feel-grid,
.m8m1__price-grid,
.m8m1__demo-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22px;
}

.m8m1__quick {
  position: relative;
  padding: 28px;
  border: 1px solid var(--line);
  border-left: 5px solid var(--gold);
  border-radius: var(--r);
  background: var(--white);
  box-shadow: var(--soft-shadow);
}

.m8m1__quick--panasonic {
  border-left-color: var(--green);
}

.m8m1__label {
  display: inline-flex;
  margin-bottom: 14px;
  padding: 6px 10px;
  border-radius: 999px;
  background: rgba(167, 123, 53, 0.1);
  color: var(--gold);
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.m8m1__label--green {
  background: rgba(82, 107, 96, 0.1);
  color: var(--green);
}

.m8m1__quick h2,
.m8m1__quick h3,
.m8m1__product h3,
.m8m1__feature-copy h3,
.m8m1__demo-card h3,
.m8m1__value-copy h3 {
  margin: 0 0 12px;
  color: var(--ink);
  font-size: 22px;
  line-height: 1.2;
}

.m8m1__bullets {
  display: grid;
  gap: 9px;
  margin: 18px 0 0;
  padding: 0;
  list-style: none;
}

.m8m1__bullets li {
  position: relative;
  padding-left: 24px;
  color: var(--muted);
  font-size: 14px;
  line-height: 1.65;
}

.m8m1__bullets li::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0.68em;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--gold);
}

.m8m1__quick--panasonic .m8m1__bullets li::before {
  background: var(--green);
}

.m8m1__note {
  margin-top: 24px;
  padding: 18px 20px;
  border: 1px solid var(--line);
  border-left: 5px solid var(--gold);
  border-radius: var(--r);
  background: var(--paper);
}

.m8m1__product {
  border: 1px solid var(--line);
  border-radius: var(--r);
  background: var(--white);
  box-shadow: var(--soft-shadow);
}

.m8m1__product-media {
  position: relative;
  display: block;
  background: transparent;
  border-top-left-radius: var(--r);
  border-top-right-radius: var(--r);
}

.m8m1__product-media img {
  width: 100%;
  aspect-ratio: 4 / 3;
  object-fit: cover;
  transition: transform 0.28s ease;
  border-top-left-radius: var(--r);
  border-top-right-radius: var(--r);
}

.m8m1__hotspot {
  position: absolute;
  display: grid;
  place-items: center;
  width: 34px;
  height: 34px;
  border: 2px solid rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  background: rgba(167, 123, 53, 0.86);
  color: var(--white);
  font-size: 12px;
  font-weight: 900;
  box-shadow: 0 8px 18px rgba(20, 21, 22, 0.24);
  cursor: help;
  transition: transform 0.18s ease, box-shadow 0.18s ease;
  z-index: 4;
}

.m8m1__hotspot--green {
  background: rgba(82, 107, 96, 0.88);
}

.m8m1__hotspot::after {
  content: attr(data-tip);
  position: absolute;
  bottom: calc(100% + 14px);
  left: 50%;
  transform: translateX(-50%);
  padding: 8px 14px;
  background: rgba(20, 21, 22, 0.94);
  color: #fff;
  font-size: 12px;
  font-weight: 700;
  white-space: nowrap;
  border-radius: 6px;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.18s ease;
  box-shadow: 0 10px 26px rgba(0, 0, 0, 0.32);
  z-index: 5;
}

.m8m1__hotspot::before {
  content: "";
  position: absolute;
  bottom: calc(100% + 1px);
  left: 50%;
  transform: translateX(-50%);
  border: 7px solid transparent;
  border-top-color: rgba(20, 21, 22, 0.94);
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.18s ease;
  z-index: 5;
}

.m8m1__hotspot:hover::after,
.m8m1__hotspot:hover::before {
  opacity: 1;
}

.m8m1__hotspot:hover {
  transform: scale(1.15);
  box-shadow: 0 0 0 6px rgba(167, 123, 53, 0.20), 0 8px 18px rgba(20, 21, 22, 0.32);
}

.m8m1__hotspot--green:hover {
  box-shadow: 0 0 0 6px rgba(82, 107, 96, 0.20), 0 8px 18px rgba(20, 21, 22, 0.32);
}

.m8m1__product-body {
  padding: 26px;
}

.m8m1__product-top {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  align-items: flex-start;
  margin-bottom: 14px;
}

.m8m1__brand {
  display: block;
  color: var(--gold);
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.m8m1__price {
  color: var(--ink);
  font-size: 18px;
  font-weight: 900;
  line-height: 1.15;
  text-align: right;
  white-space: nowrap;
}

.m8m1__price s {
  display: block;
  color: var(--muted);
  font-size: 13px;
}

.m8m1__pills {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 18px;
}

.m8m1__pill {
  display: inline-flex;
  align-items: center;
  min-height: 30px;
  padding: 6px 10px;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: var(--paper);
  color: var(--ink);
  font-size: 12px;
  font-weight: 800;
}

.m8m1__visual {
  position: relative;
  overflow: hidden;
  border-radius: var(--r);
  background: var(--ink);
  box-shadow: var(--shadow);
}

.m8m1__visual img {
  width: 100%;
  min-height: 420px;
  object-fit: cover;
}

.m8m1__visual--split {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.m8m1__visual--split img {
  min-height: 420px;
}

.m8m1__overlay {
  position: absolute;
  left: 20px;
  right: 20px;
  bottom: 20px;
  display: grid;
  gap: 8px;
  padding: 16px;
  border: 1px solid rgba(255, 255, 255, 0.16);
  border-radius: var(--r);
  background: rgba(17, 19, 21, 0.72);
  color: var(--white);
  backdrop-filter: blur(10px);
}

.m8m1__overlay p,
.m8m1__overlay span {
  color: rgba(255, 255, 255, 0.74) !important;
  font-size: 13px;
}

.m8m1__meters {
  display: grid;
  gap: 13px;
}

.m8m1__meter {
  padding: 16px;
  border: 1px solid var(--line);
  border-radius: var(--r);
  background: var(--white);
  box-shadow: var(--soft-shadow);
}

.m8m1__meter-head {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 9px;
  color: var(--ink);
  font-size: 13px;
  font-weight: 900;
}

.m8m1__track {
  height: 10px;
  overflow: hidden;
  border-radius: 999px;
  background: #e1ddd5;
}

.m8m1__fill {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, var(--gold), var(--clay));
}

.m8m1__fill--green {
  background: linear-gradient(90deg, var(--green), var(--blue));
}

.m8m1__value-copy {
  padding: 30px;
  border: 1px solid var(--line);
  border-radius: var(--r);
  background: var(--white);
  box-shadow: var(--soft-shadow);
}

.m8m1__savings {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  margin-top: 20px;
}

.m8m1__saving {
  padding: 18px;
  border-radius: var(--r);
  background: var(--paper);
}

.m8m1__saving strong {
  display: block;
  font-size: 32px;
  line-height: 1;
}

.m8m1__saving span {
  display: block;
  margin-top: 6px;
  color: var(--muted);
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.m8m1__chapters {
  display: grid;
  gap: 26px;
}

.m8m1__chapter {
  display: grid;
  grid-template-columns: minmax(280px, 0.8fr) minmax(0, 1fr);
  gap: 0;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: var(--r);
  background: var(--white);
  box-shadow: var(--soft-shadow);
}

.m8m1__chapter:nth-child(even) {
  grid-template-columns: minmax(0, 1fr) minmax(280px, 0.8fr);
}

.m8m1__chapter:nth-child(even) .m8m1__chapter-visual {
  order: 2;
}

.m8m1__chapter:not(:has(.m8m1__chapter-visual)),
.m8m1__chapter:nth-child(even):not(:has(.m8m1__chapter-visual)) {
  grid-template-columns: minmax(0, 1fr);
}

.m8m1__chapter-visual {
  position: relative;
  min-height: 360px;
  overflow: hidden;
  background: var(--warm);
}

.m8m1__chapter-visual img {
  width: 100%;
  height: 100%;
  min-height: 360px;
  object-fit: cover;
}

.m8m1__chapter-visual--contain img {
  object-fit: contain;
  padding: 18px;
  background: linear-gradient(180deg, #fffaf2, #ebe4da);
}

.m8m1__chapter-body {
  padding: 30px;
}

.m8m1__chapter-body h3 {
  margin: 0 0 14px;
  color: var(--ink);
  font-size: 24px;
  line-height: 1.18;
}

.m8m1__compare-mini {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
  margin-top: 20px;
}

.m8m1__mini {
  padding: 18px;
  border: 1px solid var(--line);
  border-radius: var(--r);
  background: var(--paper);
}

.m8m1__mini b {
  display: block;
  margin-bottom: 8px;
  color: var(--ink);
  font-size: 13px;
}

.m8m1__mini p {
  font-size: 13px;
  line-height: 1.65;
}

.m8m1__demo-flow {
  display: grid;
  grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
  gap: 26px;
  align-items: center;
}

.m8m1__demo-flow:not(:has(> *:nth-child(2))) {
  grid-template-columns: minmax(0, 1fr);
  max-width: 760px;
  margin-left: auto;
  margin-right: auto;
}

.m8m1__steps {
  display: grid;
  gap: 12px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.m8m1__step {
  display: grid;
  grid-template-columns: 58px 1fr;
  gap: 16px;
  align-items: start;
  padding: 18px;
  border: 1px solid var(--line);
  border-radius: var(--r);
  background: var(--white);
  box-shadow: var(--soft-shadow);
}

.m8m1__step-num {
  display: grid;
  place-items: center;
  width: 46px;
  height: 46px;
  border-radius: 50%;
  background: var(--ink);
  color: var(--white);
  font-weight: 900;
}

.m8m1__step h3 {
  margin: 0 0 6px;
  color: var(--ink);
  font-size: 17px;
}

.m8m1__table-wrap {
  overflow-x: auto;
  border: 1px solid var(--line);
  border-radius: var(--r);
  background: var(--white);
  box-shadow: var(--soft-shadow);
  -webkit-overflow-scrolling: touch;
}

.m8m1__table {
  width: 100%;
  min-width: 880px;
  border-collapse: collapse;
}

.m8m1__table caption {
  padding: 18px 20px 0;
  color: var(--ink);
  font-size: 13px;
  font-weight: 900;
  letter-spacing: 0.1em;
  text-align: left;
  text-transform: uppercase;
}

.m8m1__table th,
.m8m1__table td {
  padding: 15px 17px;
  border-bottom: 1px solid var(--line);
  vertical-align: top;
  text-align: left;
}

.m8m1__table tr:last-child th,
.m8m1__table tr:last-child td {
  border-bottom: 0;
}

.m8m1__table th {
  width: 205px;
  background: rgba(238, 244, 242, 0.78);
  color: var(--ink);
  font-size: 13px;
  font-weight: 900;
}

.m8m1__table thead th {
  background: var(--ink);
  color: var(--white);
}

.m8m1__table td {
  color: var(--muted);
  font-size: 13px;
  line-height: 1.7;
}

.m8m1__table td a {
  color: var(--gold);
  font-weight: 900;
  border-bottom: 1px solid rgba(167, 123, 53, 0.35);
}

.m8m1__reaction-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
}

.m8m1__reaction {
  padding: 22px;
  border: 1px solid rgba(255, 255, 255, 0.14);
  border-radius: var(--r);
  background: rgba(255, 255, 255, 0.08);
}

.m8m1__reaction span {
  display: inline-flex;
  margin-bottom: 12px;
  padding: 6px 10px;
  border-radius: 999px;
  background: rgba(215, 179, 109, 0.15);
  color: var(--gold-2);
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.m8m1__reaction p {
  color: rgba(255, 255, 255, 0.78) !important;
}

.m8m1__answer {
  max-width: 920px;
  margin: 0 auto;
  padding: 34px;
  border: 1px solid rgba(255, 255, 255, 0.14);
  border-radius: var(--r);
  background: rgba(255, 255, 255, 0.08);
}

.m8m1__answer p {
  color: rgba(255, 255, 255, 0.76) !important;
  font-size: 17px;
}

.m8m1__showroom {
  position: relative;
  min-height: 560px;
  display: flex;
  align-items: center;
  overflow: hidden;
  background: var(--ink);
}

.m8m1__showroom-bg {
  position: absolute;
  inset: 0;
}

.m8m1__showroom-bg img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  filter: brightness(0.46) saturate(0.9);
}

.m8m1__showroom::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, rgba(12, 14, 16, 0.9), rgba(12, 14, 16, 0.58), rgba(12, 14, 16, 0.18));
}

.m8m1__showroom-content {
  position: relative;
  z-index: 1;
  max-width: 720px;
  padding: 76px 0;
}

.m8m1__showroom-list {
  display: grid;
  gap: 10px;
  margin: 24px 0 30px;
  padding: 0;
  list-style: none;
}

.m8m1__showroom-list li {
  position: relative;
  padding-left: 24px;
  color: rgba(255, 255, 255, 0.76);
  font-size: 14px;
}

.m8m1__showroom-list li::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0.65em;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--gold-2);
}

.m8m1__faq {
  display: grid;
  gap: 10px;
}

.m8m1__faq details {
  border: 1px solid var(--line);
  border-radius: var(--r);
  background: var(--white);
  box-shadow: var(--soft-shadow);
}

.m8m1__faq summary {
  display: flex;
  justify-content: space-between;
  gap: 18px;
  align-items: center;
  padding: 20px 22px;
  cursor: pointer;
  color: var(--ink);
  font-size: 15px;
  font-weight: 900;
  list-style: none;
}

.m8m1__faq summary::-webkit-details-marker {
  display: none;
}

.m8m1__faq summary::after {
  content: "+";
  display: grid;
  place-items: center;
  width: 28px;
  height: 28px;
  flex: 0 0 28px;
  border-radius: 50%;
  background: var(--mist);
  color: var(--gold);
  font-size: 18px;
  font-weight: 900;
}

.m8m1__faq details[open] summary::after {
  content: "-";
}

.m8m1__faq p {
  padding: 0 22px 22px;
}

.m8m1__link-map {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
  margin-top: 30px;
}

.m8m1__link-map a {
  display: inline-flex;
  align-items: center;
  min-height: 36px;
  padding: 8px 12px;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: var(--white);
  color: var(--ink);
  font-size: 12px;
  font-weight: 900;
}

.m8m1__sticky {
  position: fixed;
  right: 14px;
  bottom: 14px;
  left: 14px;
  z-index: 30;
  display: none;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  padding: 10px;
  border-radius: var(--r);
  background: rgba(17, 19, 21, 0.92);
  box-shadow: 0 16px 44px rgba(0, 0, 0, 0.28);
  backdrop-filter: blur(14px);
}

.m8m1__sticky a {
  min-height: 44px;
  padding: 10px 12px;
  border-radius: 999px;
  color: var(--white);
  font-size: 12px;
  font-weight: 900;
  text-align: center;
}

.m8m1__sticky a:first-child {
  background: var(--gold);
}

.m8m1__sticky a:last-child {
  background: rgba(255, 255, 255, 0.12);
}

@media (max-width: 1040px) {
  .m8m1__hero-grid,
  .m8m1__feel-grid,
  .m8m1__price-grid,
  .m8m1__demo-flow {
    grid-template-columns: 1fr;
  }

  .m8m1__chapter,
  .m8m1__chapter:nth-child(even) {
    grid-template-columns: 1fr;
  }

  .m8m1__chapter:nth-child(even) .m8m1__chapter-visual {
    order: 0;
  }

  .m8m1__reaction-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 760px) {
  .m8m1 {
    padding-bottom: 82px;
  }

  .m8m1__section {
    padding: 62px 0;
  }

  .m8m1__wrap,
  .m8m1__narrow {
    padding: 0 18px;
  }

  .m8m1__hero {
    min-height: auto;
  }

  .m8m1__hero-inner {
    padding: 72px 0 48px;
  }

  .m8m1__hero h1 {
    font-size: clamp(38px, 12vw, 54px);
  }

  .m8m1__stage,
  .m8m1__zone-top,
  .m8m1__zone-notes,
  .m8m1__quick-grid,
  .m8m1__product-grid,
  .m8m1__demo-grid,
  .m8m1__compare-mini,
  .m8m1__reaction-grid,
  .m8m1__savings {
    grid-template-columns: 1fr;
  }

  .m8m1__stage-item:nth-child(2) {
    transform: none;
  }

  .m8m1__zone-section {
    padding: 56px 0 62px;
  }

  .m8m1__zone-top,
  .m8m1__zone-body {
    padding: 18px;
  }

  .m8m1__zone-card {
    min-height: 410px;
  }

  .m8m1__zone-chair {
    inset: 72px 18px 84px;
  }

  .m8m1__zone-svg {
    inset: 52px 18px 74px;
    width: calc(100% - 36px);
    height: calc(100% - 126px);
  }

  .m8m1__zone-caption {
    left: 16px;
    right: 16px;
    font-size: 18px;
    border-radius: var(--r);
  }

  .m8m1__stage-item img {
    aspect-ratio: 16 / 10;
  }

  .m8m1__actions {
    flex-direction: column;
    align-items: stretch;
  }

  .m8m1__btn {
    width: 100%;
  }

  .m8m1__product-top {
    display: block;
  }

  .m8m1__price {
    margin-top: 10px;
    text-align: left;
  }

  .m8m1__visual--split {
    grid-template-columns: 1fr;
  }

  .m8m1__visual img,
  .m8m1__visual--split img,
  .m8m1__chapter-visual,
  .m8m1__chapter-visual img {
    min-height: 320px;
  }

  .m8m1__step {
    grid-template-columns: 1fr;
  }

  .m8m1__sticky {
    display: grid;
  }
}

.m8m1__zone-top--svg {
  padding: 0;
  background: #0d0d10;
}

.m8m1__zone-top--svg svg {
  display: block;
  width: 100%;
  height: auto;
}

@media (max-width: 760px) {
  .m8m1__zone-top--svg svg {
    min-height: 300px;
  }
}

.m8m1__zone-top--map {
  display: block;
  grid-template-columns: none;
  padding: 40px 32px 36px;
  background: radial-gradient(circle at 50% 30%, #1a1a1e 0%, #0d0d10 100%);
}

.m8m1__zone-mhead {
  text-align: center;
  margin-bottom: 28px;
}

.m8m1__zone-mhead-tag {
  display: block;
  color: #9a7f4a;
