.mcm-home .section-header .eyebrow{display:inline-block;font-size:11px !important;letter-spacing:3px !important;text-transform:uppercase;color:var(--accent) !important;margin-bottom:16px !important;font-weight:700 !important;font-family:'Inter',sans-serif !important}
.mcm-home .section-header h2{font-size:clamp(32px,3.5vw,44px) !important;margin-bottom:16px !important;letter-spacing:-.02em}
.mcm-home .section-header p{font-size:17px !important;color:var(--muted) !important;max-width:620px;margin:0 auto;line-height:1.7 !important}
.mcm-home .brands-strip{display:flex;justify-content:center;align-items:stretch;gap:24px !important;flex-wrap:wrap;padding:0}
.mcm-home .brand-logo{display:flex;align-items:center;justify-content:center;transition:var(--transition);flex:0 0 auto;background:var(--white);border:1px solid var(--border-light);border-radius:var(--radius);padding:28px 40px !important;min-width:160px}
