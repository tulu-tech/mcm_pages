.mcm-home a.btn-primary,.mcm-home a.btn-primary:link,.mcm-home a.btn-primary:visited,.mcm-home a.btn-primary:active{color:#ffffff !important}
.mcm-home a.btn-dark,.mcm-home a.btn-dark:link,.mcm-home a.btn-dark:visited,.mcm-home a.btn-dark:active{color:#ffffff !important}
.mcm-home a.btn-white-outline,.mcm-home a.btn-white-outline:link,.mcm-home a.btn-white-outline:visited{color:#ffffff !important}
.mcm-home .hero{position:relative;min-height:85vh;display:flex;align-items:center;background:var(--dark);overflow:hidden}
.mcm-home .hero-video{position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;z-index:0}
.mcm-home .hero::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(15,12,8,.7) 0%,rgba(15,12,8,.35) 60%,rgba(15,12,8,.2) 100%);z-index:1}
