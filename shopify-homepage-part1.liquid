.mcm-home .product-card:hover{transform:translateY(-6px);box-shadow:var(--card-shadow-hover);border-color:var(--accent)}
.mcm-home .product-card-badge{position:absolute;top:14px;left:14px;background:var(--accent);color:#ffffff !important;font-size:11px !important;font-weight:700 !important;padding:4px 12px;border-radius:50px;text-transform:uppercase;letter-spacing:1px;z-index:2}
.mcm-home .product-card-img{width:100%;height:280px;object-fit:contain;padding:32px !important;background:var(--white);mix-blend-mode:multiply}
