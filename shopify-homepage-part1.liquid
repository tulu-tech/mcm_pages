                {%- assign badge = featured_badges[forloop.index0] -%}
                {%- if badge != blank -%}<span class="product-card-badge">{{ badge }}</span>{%- endif -%}
                <img class="product-card-img" src="{{ p.featured_image | image_url: width: 900 }}" alt="{{ p.featured_image.alt | default: p.title | escape }}">
                <div class="product-card-body">
                    <div class="product-card-brand">{{ p.vendor }}</div>
                    <h3>{{ p.title }}</h3>
                    <div class="product-prices">
                        <span class="price-sale">{{ p.price | money }}</span>
                        {%- if p.compare_at_price > p.price -%}
                          <span class="price-compare">{{ p.compare_at_price | money }}</span>
                        {%- endif -%}
                    </div>
                    <a href="{{ p.url }}" class="product-card-link">View Details</a>
                </div>
              </div>
              {%- endif -%}
            {%- endfor -%}
        </div>
        <div style="text-align:center; margin-top:48px;">
            <a href="/collections/massage-chair" class="btn btn-dark">View All Massage Chairs</a>
        </div>
    </div>
</section>

