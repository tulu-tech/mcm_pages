<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900');@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700;800');
:root{--bg:#fff;--surface:#f9f8f6;--surface-alt:#f3f1ed;--dark:#1a1a1a;--text:#2d2d2d;--muted:#5a5a5a;--light-text:#8a8a8a;--accent:#b8944f;--accent-hover:#a07e3f;--accent-light:rgba(184,148,79,.08);--border:#e8e4de;--border-light:#f0ece6;--white:#fff;--hero-overlay:rgba(15,12,8,.55);--card-shadow:0 4px 20px rgba(0,0,0,.04);--card-shadow-hover:0 20px 50px rgba(0,0,0,.10);--radius:16px;--radius-sm:10px;--radius-lg:24px;--transition:all .3s cubic-bezier(.4,0,.2,1)}
.mcm-home *,.mcm-home *::before,.mcm-home *::after{box-sizing:border-box;margin:0;padding:0}
.mcm-home{font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif !important;color:var(--text) !important;line-height:1.7 !important;font-size:16px !important;font-weight:400;-webkit-font-smoothing:antialiased;overflow-x:hidden}
.mcm-home h1,.mcm-home h2,.mcm-home h3,.mcm-home h4,.mcm-home h5{color:var(--dark);line-height:1.2;font-weight:700}
.mcm-home h1,.mcm-home h2{font-family:'Playfair Display',Georgia,serif}
.mcm-home a{color:inherit;text-decoration:none}
.mcm-home img{max-width:100%;display:block}
.mcm-home .container{max-width:1280px;margin:0 auto;padding:0 32px !important}
.mcm-home .container-narrow{max-width:900px;margin:0 auto;padding:0 32px !important}
.mcm-home .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:14px 36px !important;font-size:15px !important;font-weight:700 !important;border-radius:50px;text-decoration:none !important;transition:var(--transition);border:2px solid transparent;cursor:pointer;letter-spacing:.02em;font-family:'Inter',sans-serif !important;line-height:1.4 !important}
.mcm-home .btn-primary{background:var(--accent) !important;color:#ffffff !important;border-color:var(--accent) !important}
.mcm-home .btn-primary:hover{background:var(--accent-hover) !important;border-color:var(--accent-hover) !important;transform:translateY(-2px);box-shadow:0 10px 30px rgba(184,148,79,.25)}
.mcm-home .btn-dark{background:var(--dark) !important;color:#ffffff !important;border-color:var(--dark) !important}
.mcm-home .btn-dark:hover{background:transparent !important;color:var(--dark) !important}
.mcm-home .btn-outline{background:transparent !important;color:var(--dark) !important;border:2px solid var(--border) !important}
.mcm-home .btn-outline:hover{border-color:var(--accent) !important;color:var(--accent) !important}
