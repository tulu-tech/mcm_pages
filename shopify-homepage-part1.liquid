.mcm-home .hero-content{max-width:700px;padding:64px 0 !important}
.mcm-home .hero-eyebrow{display:inline-block;font-size:12px !important;letter-spacing:3px !important;text-transform:uppercase;color:var(--accent) !important;margin-bottom:20px !important;font-weight:700 !important;font-family:'Inter',sans-serif !important}
.mcm-home .hero h1{font-size:clamp(40px,5.5vw,68px) !important;color:#ffffff !important;margin-bottom:24px !important;font-weight:700 !important;line-height:1.1 !important;letter-spacing:-.02em}
