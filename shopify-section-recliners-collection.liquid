<!-- 
  ============================================
  MASSAGE CHAIRS AND MORE — Recliners Collection Page
  Shopify Custom Liquid Section
  ============================================
  
  USAGE: 
  1. Create this as a section in your theme: sections/recliners-collection.liquid
  2. Create a JSON template: templates/collection.recliners.json
  3. Assign the template to your "Recliners" collection
  
  IMAGES:
  Upload recliner-hero.png and recliner-showroom.png to Shopify Files
  ============================================
-->

<style>
/* ============================================
   RECLINERS COLLECTION — Premium Styles
   ============================================ */

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Playfair+Display:wght@400;500;600;700;800&display=swap');

:root {
    --rcl-bg: #ffffff;
    --rcl-surface: #f9f8f6;
    --rcl-surface-alt: #f3f1ed;
    --rcl-dark: #1a1a1a;
    --rcl-text: #2d2d2d;
    --rcl-muted: #5a5a5a;
    --rcl-light-text: #8a8a8a;
    --rcl-accent: #8b7355;
    --rcl-accent-hover: #74603f;
    --rcl-accent-light: rgba(139, 115, 85, 0.08);
    --rcl-accent-glow: rgba(139, 115, 85, 0.15);
    --rcl-border: #e8e4de;
    --rcl-border-light: #f0ece6;
    --rcl-white: #ffffff;
    --rcl-hero-overlay: rgba(15, 12, 8, 0.55);
    --rcl-card-shadow: 0 4px 20px rgba(0,0,0,0.04);
    --rcl-card-shadow-hover: 0 20px 50px rgba(0,0,0,0.10);
    --rcl-radius: 16px;
    --rcl-radius-sm: 10px;
    --rcl-radius-lg: 24px;
    --rcl-transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.rcl-collection *, .rcl-collection *::before, .rcl-collection *::after { box-sizing: border-box; }

.rcl-collection {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif !important;
    background: var(--rcl-bg) !important;
    color: var(--rcl-text) !important;
    line-height: 1.75 !important;
    font-size: 17px !important;
    -webkit-font-smoothing: antialiased;
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
}

.rcl-collection h1, .rcl-collection h2, .rcl-collection h3, .rcl-collection h4 {
    font-family: 'Playfair Display', Georgia, serif !important;
    line-height: 1.25 !important;
    color: var(--rcl-dark) !important;
}

.rcl-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
.rcl-container-wide { max-width: 1400px; margin: 0 auto; padding: 0 24px; }

/* ============================================
   HERO SECTION
   ============================================ */
.rcl-hero {
    position: relative;
    min-height: 520px;
    display: flex;
    align-items: center;
    overflow: hidden;
    border-radius: 0 0 var(--rcl-radius-lg) var(--rcl-radius-lg);
}

.rcl-hero-bg {
    position: absolute; inset: 0;
    background-image: url('https://cdn.shopify.com/s/files/1/0813/4036/7096/files/recliner-hero.jpg?v=1774642393');
    background-size: cover;
    background-position: center;
}

.rcl-hero-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(135deg, rgba(10, 8, 5, 0.72) 0%, rgba(30, 25, 18, 0.48) 100%);
}

.rcl-hero-content {
    position: relative; z-index: 2;
    max-width: 680px;
    padding: 80px 24px;
}

.rcl-hero-badge {
    display: inline-flex; align-items: center; gap: 8px;
    background: rgba(255,255,255,0.12);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255,255,255,0.18);
    padding: 8px 18px;
    border-radius: 50px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: rgba(255,255,255,0.9);
    margin-bottom: 24px;
}

.rcl-hero h1 {
    font-size: clamp(36px, 5vw, 56px);
    color: var(--rcl-white) !important;
    margin: 0 0 20px 0;
    font-weight: 700;
    letter-spacing: -0.5px;
}

.rcl-hero-sub {
    font-size: 18px;
    color: rgba(255,255,255,0.85);
    line-height: 1.7;
    margin: 0 0 32px 0;
    max-width: 560px;
}

.rcl-hero-ctas {
    display: flex; flex-wrap: wrap; gap: 14px;
    margin-bottom: 24px;
}

.rcl-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    padding: 15px 32px;
    border-radius: var(--rcl-radius-sm);
    font-family: 'Inter', sans-serif !important;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    text-decoration: none !important;
    cursor: pointer;
    transition: var(--rcl-transition);
    border: none;
}

.rcl-btn-primary {
    background: var(--rcl-accent);
    color: var(--rcl-white) !important;
}
.rcl-btn-primary:hover { background: var(--rcl-accent-hover); transform: translateY(-2px); }

.rcl-btn-outline {
    background: transparent;
    border: 2px solid rgba(255,255,255,0.4);
    color: var(--rcl-white) !important;
}
.rcl-btn-outline:hover { background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.7); }

.rcl-btn-dark {
    background: var(--rcl-dark);
    color: var(--rcl-white) !important;
}
.rcl-btn-dark:hover { background: #333; transform: translateY(-2px); }

.rcl-btn-accent-outline {
    background: transparent;
    border: 2px solid var(--rcl-accent);
    color: var(--rcl-accent) !important;
}
.rcl-btn-accent-outline:hover { background: var(--rcl-accent); color: var(--rcl-white) !important; }

.rcl-hero-trust {
    display: flex; flex-wrap: wrap; gap: 20px;
    font-size: 13px;
    color: rgba(255,255,255,0.65);
}

.rcl-hero-trust span {
    display: flex; align-items: center; gap: 6px;
}

/* ============================================
   SECTION TITLES
   ============================================ */
.rcl-section { padding: 80px 0; }
.rcl-section-alt { background: var(--rcl-surface); }

.rcl-section-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 50px;
}

.rcl-section-header h2 {
    font-size: clamp(28px, 3.5vw, 40px);
    margin: 0 0 16px 0;
    font-weight: 700;
}

.rcl-section-header p {
    font-size: 17px;
    color: var(--rcl-muted);
    line-height: 1.8;
    margin: 0;
}

.rcl-label {
    display: inline-block;
    font-family: 'Inter', sans-serif !important;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--rcl-accent);
    margin-bottom: 12px;
}

/* ============================================
   DECISION PATHWAYS
   ============================================ */
.rcl-pathways {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
}

.rcl-pathway-card {
    background: var(--rcl-white);
    border: 1px solid var(--rcl-border);
    border-radius: var(--rcl-radius);
    padding: 36px 28px;
    text-align: center;
    text-decoration: none !important;
    transition: var(--rcl-transition);
    cursor: pointer;
}
.rcl-pathway-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--rcl-card-shadow-hover);
    border-color: var(--rcl-accent);
}

.rcl-pathway-icon {
    width: 56px; height: 56px;
    background: var(--rcl-accent-light);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 20px;
    font-size: 24px;
}

.rcl-pathway-card h3 {
    font-family: 'Inter', sans-serif !important;
    font-size: 17px;
    font-weight: 700;
    margin: 0 0 10px 0;
    color: var(--rcl-dark) !important;
}

.rcl-pathway-card p {
    font-size: 14px;
    color: var(--rcl-muted);
    margin: 0 0 16px 0;
    line-height: 1.6;
}

.rcl-pathway-link {
    font-size: 13px;
    font-weight: 700;
    color: var(--rcl-accent) !important;
    text-transform: uppercase;
    letter-spacing: 1px;
}

/* ============================================
   PRODUCT GRID
   ============================================ */
.rcl-product-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
}

.rcl-product-card {
    background: var(--rcl-white);
    border: 1px solid var(--rcl-border);
    border-radius: var(--rcl-radius);
    overflow: hidden;
    transition: var(--rcl-transition);
}
.rcl-product-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--rcl-card-shadow-hover);
}

.rcl-product-img-wrap {
    position: relative;
    background: var(--rcl-surface);
    padding: 24px;
    aspect-ratio: 1/1;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.rcl-product-img-wrap img {
    max-width: 90%;
    max-height: 90%;
    object-fit: contain;
    transition: transform 0.5s ease;
}
.rcl-product-card:hover .rcl-product-img-wrap img { transform: scale(1.05); }

.rcl-product-badge {
    position: absolute;
    top: 16px; left: 16px;
    background: var(--rcl-accent);
    color: var(--rcl-white);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 5px 12px;
    border-radius: 6px;
}

.rcl-product-info {
    padding: 24px;
}

.rcl-product-vendor {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--rcl-accent);
    margin: 0 0 6px 0;
}

.rcl-product-title {
    font-family: 'Playfair Display', serif !important;
    font-size: 20px;
    font-weight: 700;
    margin: 0 0 8px 0;
    color: var(--rcl-dark) !important;
    line-height: 1.3;
}

.rcl-product-title a {
    text-decoration: none !important;
    color: inherit !important;
}

.rcl-product-best-for {
    font-size: 14px;
    color: var(--rcl-muted);
    margin: 0 0 12px 0;
    font-style: italic;
}

.rcl-product-features {
    list-style: none;
    padding: 0;
    margin: 0 0 16px 0;
}

.rcl-product-features li {
    font-size: 13px;
    color: var(--rcl-text);
    padding: 4px 0;
    padding-left: 18px;
    position: relative;
    line-height: 1.5;
}

.rcl-product-features li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--rcl-accent);
    font-weight: 700;
}

.rcl-product-price-row {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 16px 0;
}

.rcl-product-price {
    font-family: 'Inter', sans-serif !important;
    font-size: 22px;
    font-weight: 800;
    color: var(--rcl-dark);
}

.rcl-product-compare-price {
    font-size: 15px;
    color: var(--rcl-light-text);
    text-decoration: line-through;
}

.rcl-product-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.rcl-product-actions .rcl-btn {
    width: 100%;
    padding: 12px 20px;
    font-size: 12px;
}

/* ============================================
   COMPARISON TABLE
   ============================================ */
.rcl-comparison-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid var(--rcl-border);
    border-radius: var(--rcl-radius);
}

.rcl-comparison-table {
    width: 100%;
    min-width: 700px;
    border-collapse: collapse;
    font-size: 14px;
}

.rcl-comparison-table thead th {
    background: var(--rcl-dark);
    color: var(--rcl-white);
    font-family: 'Inter', sans-serif !important;
    font-weight: 700;
    padding: 16px 20px;
    text-align: left;
    font-size: 13px;
    letter-spacing: 0.5px;
}

.rcl-comparison-table thead th:first-child {
    border-radius: var(--rcl-radius) 0 0 0;
}
.rcl-comparison-table thead th:last-child {
    border-radius: 0 var(--rcl-radius) 0 0;
}

.rcl-comparison-table tbody td {
    padding: 14px 20px;
    border-bottom: 1px solid var(--rcl-border-light);
    vertical-align: middle;
}

.rcl-comparison-table tbody tr:nth-child(even) { background: var(--rcl-surface); }
.rcl-comparison-table tbody tr:hover { background: var(--rcl-accent-light); }

.rcl-comparison-table .rcl-feature-label {
    font-weight: 600;
    color: var(--rcl-dark);
    white-space: nowrap;
}

.rcl-check { color: #4a9e6d; font-weight: 700; }
.rcl-cross { color: var(--rcl-light-text); }

/* ============================================
   TRUST SECTION
   ============================================ */
.rcl-trust-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
}

.rcl-trust-card {
    text-align: center;
    padding: 32px 20px;
    background: var(--rcl-white);
    border: 1px solid var(--rcl-border);
    border-radius: var(--rcl-radius);
}

.rcl-trust-icon {
    font-size: 32px;
    margin-bottom: 16px;
}

.rcl-trust-card h4 {
    font-family: 'Inter', sans-serif !important;
    font-size: 15px;
    font-weight: 700;
    margin: 0 0 8px 0;
}

.rcl-trust-card p {
    font-size: 13px;
    color: var(--rcl-muted);
    margin: 0;
    line-height: 1.6;
}

/* ============================================
   SHOWROOM CTA SECTION
   ============================================ */
.rcl-showroom {
    position: relative;
    min-height: 420px;
    display: flex;
    align-items: center;
    border-radius: var(--rcl-radius-lg);
    overflow: hidden;
    margin: 0 24px;
}

.rcl-showroom-bg {
    position: absolute; inset: 0;
    background-image: url('https://cdn.shopify.com/s/files/1/0813/4036/7096/files/recliner-showroom.jpg?v=1774642393');
    background-size: cover;
    background-position: center;
}

.rcl-showroom-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(90deg, rgba(10, 8, 5, 0.78) 0%, rgba(10, 8, 5, 0.3) 100%);
}

.rcl-showroom-content {
    position: relative; z-index: 2;
    max-width: 560px;
    padding: 60px 48px;
}

.rcl-showroom-content h2 {
    font-size: clamp(28px, 3vw, 38px);
    color: var(--rcl-white) !important;
    margin: 0 0 16px 0;
}

.rcl-showroom-content p {
    color: rgba(255,255,255,0.8);
    font-size: 16px;
    margin: 0 0 12px 0;
    line-height: 1.7;
}

.rcl-showroom-steps {
    list-style: none;
    padding: 0;
    margin: 20px 0 28px 0;
}

.rcl-showroom-steps li {
    color: rgba(255,255,255,0.85);
    font-size: 14px;
    padding: 6px 0;
    padding-left: 28px;
    position: relative;
}

.rcl-showroom-steps li::before {
    content: attr(data-step);
    position: absolute;
    left: 0;
    width: 20px; height: 20px;
    background: var(--rcl-accent);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 11px;
    font-weight: 700;
    color: white;
    top: 7px;
}

/* ============================================
   SEO CONTENT
   ============================================ */
.rcl-seo-content {
    max-width: 800px;
    margin: 0 auto;
}

.rcl-seo-content h2 {
    font-size: 28px;
    margin: 50px 0 16px 0;
}

.rcl-seo-content h3 {
    font-family: 'Inter', sans-serif !important;
    font-size: 19px;
    font-weight: 700;
    margin: 36px 0 12px 0;
    color: var(--rcl-dark) !important;
}

.rcl-seo-content p {
    font-size: 16px;
    color: var(--rcl-text);
    margin: 0 0 20px 0;
    line-height: 1.85;
}

/* ============================================
   FAQ SECTION
   ============================================ */
.rcl-faq-grid {
    max-width: 800px;
    margin: 0 auto;
}

.rcl-faq-item {
    border-bottom: 1px solid var(--rcl-border);
    padding: 24px 0;
}

.rcl-faq-question {
    font-family: 'Inter', sans-serif !important;
    font-size: 17px;
    font-weight: 700;
    color: var(--rcl-dark);
    margin: 0 0 10px 0;
    cursor: pointer;
}

.rcl-faq-answer {
    font-size: 15px;
    color: var(--rcl-muted);
    line-height: 1.8;
    margin: 0;
}

/* ============================================
   FINAL CTA
   ============================================ */
.rcl-final-cta {
    text-align: center;
    background: var(--rcl-dark);
    padding: 80px 24px;
    border-radius: var(--rcl-radius-lg) var(--rcl-radius-lg) 0 0;
}

.rcl-final-cta h2 {
    color: var(--rcl-white) !important;
    font-size: clamp(28px, 3.5vw, 42px);
    margin: 0 0 14px 0;
}

.rcl-final-cta p {
    color: rgba(255,255,255,0.65);
    font-size: 17px;
    margin: 0 0 32px 0;
    max-width: 520px;
    margin-left: auto;
    margin-right: auto;
}

.rcl-final-cta-btns {
    display: flex; justify-content: center; flex-wrap: wrap; gap: 14px;
}

/* ============================================
   HELP BLOCK (inline)
   ============================================ */
.rcl-help-block {
    background: var(--rcl-accent-light);
    border: 1px solid var(--rcl-accent-glow);
    border-radius: var(--rcl-radius);
    padding: 28px 32px;
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 40px;
}

.rcl-help-block-icon { font-size: 32px; flex-shrink: 0; }

.rcl-help-block h4 {
    font-family: 'Inter', sans-serif !important;
    font-size: 16px;
    font-weight: 700;
    margin: 0 0 4px 0;
}

.rcl-help-block p {
    font-size: 14px;
    color: var(--rcl-muted);
    margin: 0;
}

/* ============================================
   RESPONSIVE — FORCE OVERRIDES
   ============================================ */
.rcl-collection {
    box-sizing: border-box !important;
    overflow-x: hidden !important;
}
.rcl-collection img {
    height: auto !important;
}

/* ============================================
   RESPONSIVE — TABLET (max 960px)
   ============================================ */
@media (max-width: 960px) {
    .rcl-collection .rcl-product-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 20px !important; }
    .rcl-collection .rcl-pathways { grid-template-columns: repeat(2, 1fr) !important; gap: 16px !important; }
    .rcl-collection .rcl-trust-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 16px !important; }
    .rcl-collection .rcl-showroom { margin: 0 !important; border-radius: 0 !important; min-height: 380px !important; }
    .rcl-collection .rcl-showroom-content { padding: 48px 32px !important; }
    .rcl-collection .rcl-section { padding: 60px 0 !important; }
    .rcl-collection .rcl-container { padding: 0 20px !important; }
    .rcl-collection .rcl-hero-content { max-width: 100% !important; }
    .rcl-collection .rcl-comparison-table { min-width: 600px !important; }
}

/* ============================================
   RESPONSIVE — MOBILE (max 768px)
   ============================================ */
@media (max-width: 768px) {
    .rcl-collection { font-size: 15px !important; line-height: 1.65 !important; overflow-x: hidden !important; }
    .rcl-collection .rcl-container { padding: 0 16px !important; width: 100% !important; }

    /* Hero */
    .rcl-collection .rcl-hero { min-height: 420px !important; border-radius: 0 !important; }
    .rcl-collection .rcl-hero-content { padding: 48px 20px 56px !important; max-width: 100% !important; }
    .rcl-collection .rcl-hero-badge { font-size: 10px !important; padding: 6px 14px !important; margin-bottom: 16px !important; }
    .rcl-collection .rcl-hero h1 { font-size: 26px !important; line-height: 1.25 !important; margin-bottom: 14px !important; }
    .rcl-collection .rcl-hero-sub { font-size: 14px !important; line-height: 1.65 !important; margin-bottom: 24px !important; }
    .rcl-collection .rcl-hero-ctas { flex-direction: column !important; width: 100% !important; }
    .rcl-collection .rcl-hero-ctas .rcl-btn { width: 100% !important; padding: 16px 24px !important; font-size: 13px !important; }
    .rcl-collection .rcl-hero-trust { flex-direction: column !important; gap: 6px !important; font-size: 12px !important; }

    /* Sections */
    .rcl-collection .rcl-section { padding: 44px 0 !important; }
    .rcl-collection .rcl-section-header { margin-bottom: 28px !important; }
    .rcl-collection .rcl-section-header h2 { font-size: 22px !important; line-height: 1.3 !important; }
    .rcl-collection .rcl-section-header p { font-size: 14px !important; }
    .rcl-collection .rcl-label { font-size: 10px !important; }

    /* Pathways — horizontal */
    .rcl-collection .rcl-pathways { grid-template-columns: 1fr !important; gap: 12px !important; }
    .rcl-collection .rcl-pathway-card { padding: 18px 16px !important; display: flex !important; flex-direction: row !important; align-items: center !important; gap: 14px !important; text-align: left !important; }
    .rcl-collection .rcl-pathway-icon { width: 44px !important; height: 44px !important; min-width: 44px !important; font-size: 20px !important; margin: 0 !important; }
    .rcl-collection .rcl-pathway-card h3 { font-size: 15px !important; margin-bottom: 2px !important; }
    .rcl-collection .rcl-pathway-card p { display: none !important; }
    .rcl-collection .rcl-pathway-link { font-size: 11px !important; }

    /* Product Grid — horizontal cards */
    .rcl-collection .rcl-product-grid { grid-template-columns: 1fr !important; gap: 16px !important; }
    .rcl-collection .rcl-product-card {
        border-radius: 12px !important; display: flex !important; flex-direction: row !important;
        align-items: stretch !important; overflow: hidden !important;
    }
    .rcl-collection .rcl-product-img-wrap {
        aspect-ratio: auto !important; padding: 12px !important; width: 140px !important;
