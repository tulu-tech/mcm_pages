{%- liquid
  assign se_stts = section.settings
  assign admin_sp = request.design_mode
  assign h_transparent = se_stts.transparent_header
  if request.page_type != 'index'
    assign h_transparent = false
  endif
-%}

{%- style -%}
  /* ============================================================
     MCM PREMIUM HEADER — Shopify Liquid Section
     !important used throughout to override theme (t4s/Kalles) CSS
     ============================================================ */
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');

  :root {
    --mcm-accent:        #b8944f;
    --mcm-accent-hover:  #a07e3f;
    --mcm-accent-light:  rgba(184,148,79,0.10);
    --mcm-dark:          #1a1a1a;
    --mcm-text:          #2d2d2d;
    --mcm-muted:         #5a5a5a;
    --mcm-border:        #e8e4de;
    --mcm-surface:       #f9f8f6;
    --mcm-white:         #ffffff;
  }

  /* ── SHOPIFY SECTION WRAPPER — force sticky to work ── */
  #shopify-section-{{ section.id }} {
    position: sticky !important;
    top: 0 !important;
    z-index: 999 !important;
    overflow: visible !important;
  }
  #shopify-section-{{ section.id }} * {
    overflow: visible;
  }
  /* Kill any theme wrapper overflow that breaks sticky */
  .t4s-header-wrapper,
  .header-wrapper,
  .shopify-section-group-header-group {
    position: sticky !important;
    top: 0 !important;
    z-index: 999 !important;
    overflow: visible !important;
  }

  /* ── HARD RESET — kill all theme pseudo-element injections ── */
  #mcm-top-bar *, #mcm-site-header * {
    box-sizing: border-box !important;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif !important;
    -webkit-font-smoothing: antialiased;
  }
  #mcm-top-bar *::before,
  #mcm-top-bar *::after,
  #mcm-site-header .mcm-nav *::before,
  #mcm-site-header .mcm-nav *::after,
  #mcm-site-header .mcm-actions *::before,
  #mcm-site-header .mcm-actions *::after {
    content: none !important;
    display: none !important;
  }
  /* Allow our own ::after on nav-link (underline bar) */
  #mcm-site-header .mcm-nav-link::after {
    content: '' !important;
    display: block !important;
  }

  /* ── TOP BAR ─────────────────────────────────────────── */
  #mcm-top-bar {
    background: var(--mcm-dark) !important;
    color: rgba(255,255,255,0.85) !important;
    font-size: 12px !important;
    font-weight: 500 !important;
    letter-spacing: 0.02em !important;
    line-height: 1 !important;
    position: relative !important;
    z-index: 500 !important;
    width: 100% !important;
  }
  #mcm-top-bar .mcm-top-inner {
    max-width: 1400px !important;
    margin: 0 auto !important;
    padding: 9px 32px !important;
    display: flex !important;
    justify-content: space-between !important;
    align-items: center !important;
    position: relative !important;
  }
  #mcm-top-bar .mcm-top-left,
  #mcm-top-bar .mcm-top-right {
    display: flex !important;
    align-items: center !important;
    gap: 6px !important;
  }
  #mcm-top-bar .mcm-top-center {
    position: absolute !important;
    left: 50% !important;
    transform: translateX(-50%) !important;
    font-weight: 600 !important;
    color: var(--mcm-accent) !important;
    font-size: 11.5px !important;
    white-space: nowrap !important;
  }
  #mcm-top-bar svg {
    width: 13px !important;
    height: 13px !important;
    fill: var(--mcm-accent) !important;
    flex-shrink: 0 !important;
    vertical-align: middle !important;
    display: inline-block !important;
  }
  #mcm-top-bar a {
    color: rgba(255,255,255,0.85) !important;
    text-decoration: none !important;
  }
  #mcm-top-bar a:hover { color: var(--mcm-accent) !important; }

  /* ── MAIN HEADER WRAPPER ─────────────────────────────── */
  #mcm-site-header {
    position: relative !important;
    top: auto !important;
    z-index: 490 !important;
    background: #ffffff !important;
    border-bottom: 1px solid #e8e4de !important;
    width: 100% !important;
    display: block !important;
    padding: 0 !important;
    margin: 0 !important;
  }
  #mcm-site-header.mcm-scrolled {
    box-shadow: 0 2px 24px rgba(0,0,0,0.08) !important;
    border-bottom-color: transparent !important;
  }

  /* ── HEADER INNER — the 3-column flex row ────────────── */
  #mcm-site-header .mcm-header-inner {
    max-width: 1400px !important;
    margin: 0 auto !important;
    padding: 0 32px !important;
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    justify-content: space-between !important;
    height: 96px !important;
    width: 100% !important;
    gap: 0 !important;
  }
  #mcm-site-header.mcm-scrolled .mcm-header-inner {
    height: 72px !important;
  }

  /* ── LOGO ────────────────────────────────────────────── */
  #mcm-site-header .mcm-logo {
    display: flex !important;
    align-items: center !important;
    text-decoration: none !important;
    flex-shrink: 0 !important;
    height: 100% !important;
    padding: 0 !important;
    margin: 0 !important;
  }
  #mcm-site-header .mcm-logo img {
    height: 88px !important;
    width: auto !important;
    display: block !important;
    max-width: none !important;
    object-fit: contain !important;
    padding: 4px 0 !important;
    margin: 0 !important;
  }
  #mcm-site-header.mcm-scrolled .mcm-logo img {
    height: 66px !important;
  }

  /* ── DESKTOP NAV — centre column ─────────────────────── */
  #mcm-site-header .mcm-nav {
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    justify-content: center !important;
    flex: 1 !important;
    height: 100% !important;
    list-style: none !important;
    margin: 0 !important;
    padding: 0 !important;
    gap: 0 !important;
  }
  #mcm-site-header .mcm-nav-item {
    position: relative !important;
    display: flex !important;
    align-items: center !important;
    height: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    list-style: none !important;
  }
  #mcm-site-header .mcm-nav-link {
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    gap: 4px !important;
    height: 100% !important;
    padding: 0 16px !important;
    margin: 0 !important;
    font-size: 14.5px !important;
    font-weight: 600 !important;
    color: #5a5a5a !important;
    text-decoration: none !important;
    white-space: nowrap !important;
    letter-spacing: 0.01em !important;
    position: relative !important;
    transition: color 0.25s !important;
    background: transparent !important;
    border: none !important;
    line-height: 1 !important;
  }
  #mcm-site-header .mcm-nav-link::after {
    content: '' !important;
    display: block !important;
    position: absolute !important;
    bottom: 0 !important;
    left: 16px !important;
    right: 16px !important;
    height: 2px !important;
    background: var(--mcm-accent) !important;
    transform: scaleX(0) !important;
    transition: transform 0.25s ease !important;
    transform-origin: center !important;
  }
  #mcm-site-header .mcm-nav-link:hover { color: #1a1a1a !important; }
  #mcm-site-header .mcm-nav-item:hover .mcm-nav-link::after {
    transform: scaleX(1) !important;
  }
  #mcm-site-header .mcm-nav-link svg.mcm-caret {
    width: 11px !important;
    height: 11px !important;
    fill: currentColor !important;
    display: inline-block !important;
    flex-shrink: 0 !important;
    opacity: 0.6 !important;
    transition: transform 0.25s ease !important;
    margin: 0 !important;
  }
  #mcm-site-header .mcm-nav-item:hover .mcm-nav-link svg.mcm-caret {
    transform: rotate(180deg) !important;
  }

  /* ── DROPDOWN ────────────────────────────────────────── */
  #mcm-site-header .mcm-dropdown {
    position: absolute !important;
    top: 100% !important;
    left: 50% !important;
    transform: translateX(-50%) translateY(10px) !important;
    min-width: 240px !important;
    background: #ffffff !important;
    border: 1px solid #e8e4de !important;
    border-top: 2.5px solid var(--mcm-accent) !important;
    border-radius: 0 0 14px 14px !important;
    box-shadow: 0 16px 48px rgba(0,0,0,0.09) !important;
    opacity: 0 !important;
    visibility: hidden !important;
    transition: opacity 0.22s ease, transform 0.22s ease, visibility 0.22s !important;
    z-index: 600 !important;
    padding: 10px 0 !important;
    display: block !important;
  }
  #mcm-site-header .mcm-nav-item:hover .mcm-dropdown {
    opacity: 1 !important;
    visibility: visible !important;
    transform: translateX(-50%) translateY(0) !important;
  }
  #mcm-site-header .mcm-drop-label {
    display: block !important;
    font-size: 11px !important;
    font-weight: 700 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.13em !important;
    color: var(--mcm-accent) !important;
    padding: 8px 20px 4px !important;
    margin: 0 !important;
  }
  #mcm-site-header .mcm-drop-divider {
    display: block !important;
    height: 1px !important;
    background: #e8e4de !important;
    margin: 6px 0 !important;
  }
  #mcm-site-header .mcm-drop-link {
    display: block !important;
    font-size: 14px !important;
    font-weight: 500 !important;
    color: #2d2d2d !important;
    text-decoration: none !important;
    padding: 9px 20px !important;
    margin: 0 !important;
    white-space: nowrap !important;
    transition: background 0.2s, color 0.2s, padding-left 0.2s !important;
    background: transparent !important;
  }
  #mcm-site-header .mcm-drop-link:hover {
    background: var(--mcm-accent-light) !important;
    color: var(--mcm-accent) !important;
    padding-left: 26px !important;
  }
  #mcm-site-header .mcm-drop-viewall {
    font-weight: 700 !important;
    font-size: 13px !important;
    color: var(--mcm-accent) !important;
    border-top: 1px solid #e8e4de !important;
    margin-top: 4px !important;
    padding-top: 10px !important;
    text-transform: uppercase !important;
    letter-spacing: 0.06em !important;
  }
  #mcm-site-header .mcm-drop-viewall:hover {
    background: var(--mcm-accent) !important;
    color: #ffffff !important;
    padding-left: 20px !important;
  }

  /* ── ACTIONS — right column ──────────────────────────── */
  #mcm-site-header .mcm-actions {
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    justify-content: flex-end !important;
    gap: 6px !important;
    flex-shrink: 0 !important;
    height: 100% !important;
  }
  #mcm-site-header .mcm-cta-btn {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    background: var(--mcm-accent) !important;
    color: #ffffff !important;
    font-size: 13px !important;
    font-weight: 700 !important;
    height: 42px !important;
    padding: 0 22px !important;
    margin: 0 !important;
    border-radius: 50px !important;
    text-decoration: none !important;
    white-space: nowrap !important;
    letter-spacing: 0.03em !important;
    line-height: 1 !important;
    border: 2px solid var(--mcm-accent) !important;
    transition: background 0.25s, color 0.25s !important;
    cursor: pointer !important;
  }
  #mcm-site-header .mcm-cta-btn:hover {
    background: transparent !important;
    color: var(--mcm-accent) !important;
  }
  #mcm-site-header .mcm-icon-btn {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: 42px !important;
    height: 42px !important;
    border-radius: 50% !important;
    background: transparent !important;
    border: none !important;
    cursor: pointer !important;
    text-decoration: none !important;
    color: inherit !important;
    position: relative !important;
    flex-shrink: 0 !important;
    padding: 0 !important;
    margin: 0 !important;
    transition: background 0.25s !important;
  }
  #mcm-site-header .mcm-icon-btn svg {
    width: 21px !important;
    height: 21px !important;
    fill: #5a5a5a !important;
    display: block !important;
    flex-shrink: 0 !important;
    transition: fill 0.2s !important;
  }
  #mcm-site-header .mcm-icon-btn:hover { background: var(--mcm-accent-light) !important; }
  #mcm-site-header .mcm-icon-btn:hover svg { fill: var(--mcm-accent) !important; }

  #mcm-site-header .mcm-cart-badge {
    position: absolute !important;
    top: 4px !important;
    right: 2px !important;
    background: var(--mcm-accent) !important;
    color: #ffffff !important;
    font-size: 9.5px !important;
    font-weight: 800 !important;
    width: 17px !important;
    height: 17px !important;
    border-radius: 50% !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    line-height: 1 !important;
  }

  /* ── SEARCH OVERLAY ──────────────────────────────────── */
  #mcm-site-header .mcm-search-overlay {
    position: fixed !important;
    top: 0 !important; left: 0 !important; right: 0 !important;
    background: rgba(255,255,255,0.97) !important;
    backdrop-filter: blur(12px) !important;
    z-index: 700 !important;
    opacity: 0 !important;
    visibility: hidden !important;
    transform: translateY(-100%) !important;
    transition: all 0.32s cubic-bezier(0.4,0,0.2,1) !important;
  }
  #mcm-site-header .mcm-search-overlay.mcm-search--open {
    opacity: 1 !important;
    visibility: visible !important;
    transform: translateY(0) !important;
  }
  #mcm-site-header .mcm-search-inner {
    max-width: 720px !important;
    margin: 0 auto !important;
    padding: 28px 32px !important;
    display: flex !important;
    align-items: center !important;
    gap: 16px !important;
  }
  #mcm-site-header .mcm-search-form {
    flex: 1 !important;
    display: flex !important;
    align-items: center !important;
    background: #f9f8f6 !important;
    border: 1.5px solid #e8e4de !important;
    border-radius: 50px !important;
    overflow: hidden !important;
  }
  #mcm-site-header .mcm-search-form:focus-within { border-color: var(--mcm-accent) !important; }
  #mcm-site-header .mcm-search-input {
    flex: 1 !important;
    border: none !important;
    background: transparent !important;
    padding: 13px 22px !important;
    font-size: 15px !important;
    color: #1a1a1a !important;
    outline: none !important;
    box-shadow: none !important;
  }
  #mcm-site-header .mcm-search-submit {
    width: 46px !important;
    height: 46px !important;
    background: var(--mcm-accent) !important;
    border: none !important;
    border-radius: 50% !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer !important;
    margin: 3px !important;
    flex-shrink: 0 !important;
  }
  #mcm-site-header .mcm-search-submit svg { width: 19px !important; height: 19px !important; fill: white !important; display: block !important; }
  #mcm-site-header .mcm-search-close-btn {
    background: none !important;
    border: none !important;
    font-size: 22px !important;
    cursor: pointer !important;
    color: #5a5a5a !important;
    padding: 4px 8px !important;
    border-radius: 8px !important;
    line-height: 1 !important;
  }

  /* ── HAMBURGER ───────────────────────────────────────── */
  #mcm-site-header .mcm-hamburger {
    display: none !important;
    flex-direction: column !important;
    justify-content: center !important;
    gap: 5px !important;
    background: none !important;
    border: none !important;
    cursor: pointer !important;
    padding: 8px !important;
    width: 40px !important;
    height: 40px !important;
  }
  #mcm-site-header .mcm-hamburger span {
    display: block !important;
    width: 22px !important;
    height: 2px !important;
    background: #1a1a1a !important;
    border-radius: 2px !important;
  }

  /* ── MOBILE DRAWER ───────────────────────────────────── */
  .mcm-drawer {
    position: fixed !important;
    top: 0 !important; left: -100% !important;
    width: 340px !important; max-width: 92vw !important;
    height: 100vh !important;
    background: #ffffff !important;
    z-index: 800 !important;
    transition: left 0.35s cubic-bezier(0.4,0,0.2,1) !important;
    display: flex !important; flex-direction: column !important;
    box-shadow: 10px 0 50px rgba(0,0,0,0.12) !important;
    overflow-y: auto !important;
  }
  .mcm-drawer.mcm-drawer--open { left: 0 !important; }
  .mcm-drawer-mask {
    position: fixed !important; inset: 0 !important;
    background: rgba(0,0,0,0.45) !important;
    z-index: 799 !important; opacity: 0 !important;
    visibility: hidden !important; transition: all 0.3s !important;
    backdrop-filter: blur(3px) !important;
  }
  .mcm-drawer-mask.mcm-mask--active { opacity: 1 !important; visibility: visible !important; }
  .mcm-drawer-top {
    display: flex !important; justify-content: space-between !important;
    align-items: center !important; padding: 18px 20px !important;
    border-bottom: 1px solid #e8e4de !important; flex-shrink: 0 !important;
  }
  .mcm-drawer-top img { height: 48px !important; width: auto !important; display: block !important; }
  .mcm-drawer-x {
    background: none !important; border: none !important;
    font-size: 22px !important; cursor: pointer !important;
    color: #5a5a5a !important; padding: 4px 8px !important;
    border-radius: 8px !important; line-height: 1 !important;
  }
  .mcm-drawer-body { flex: 1 !important; padding: 6px 0 !important; }
  .mcm-drawer-plain {
    display: block !important; font-size: 15px !important;
    font-weight: 600 !important; color: #2d2d2d !important;
    text-decoration: none !important; padding: 13px 20px !important;
    border-bottom: 1px solid #e8e4de !important;
  }
  .mcm-drawer-plain:hover { background: var(--mcm-accent-light) !important; color: var(--mcm-accent) !important; }
  .mcm-drawer-group { border-bottom: 1px solid #e8e4de !important; }
  .mcm-drawer-toggle {
    display: flex !important; justify-content: space-between !important;
    align-items: center !important; width: 100% !important;
    font-size: 15px !important; font-weight: 600 !important;
    color: #2d2d2d !important; padding: 13px 20px !important;
    background: none !important; border: none !important; cursor: pointer !important;
  }
  .mcm-drawer-toggle:hover { background: var(--mcm-accent-light) !important; }
  .mcm-drawer-toggle svg { width: 18px !important; height: 18px !important; fill: #5a5a5a !important; transition: transform 0.3s !important; display: block !important; }
  .mcm-drawer-toggle.is-open svg { transform: rotate(180deg) !important; }
  .mcm-drawer-sub { max-height: 0 !important; overflow: hidden !important; transition: max-height 0.35s ease !important; background: #f9f8f6 !important; }
  .mcm-drawer-sub.is-open { max-height: 600px !important; }
  .mcm-drawer-sub-link {
    display: block !important; font-size: 14px !important;
    font-weight: 500 !important; color: #5a5a5a !important;
    text-decoration: none !important; padding: 10px 20px 10px 32px !important;
    border-bottom: 1px solid rgba(232,228,222,0.5) !important;
    transition: color 0.2s, padding-left 0.2s !important;
  }
  .mcm-drawer-sub-link:last-child { border-bottom: none !important; }
  .mcm-drawer-sub-link:hover { color: var(--mcm-accent) !important; padding-left: 38px !important; }
  .mcm-drawer-sub-label {
    display: block !important; font-size: 10px !important; font-weight: 700 !important;
    text-transform: uppercase !important; letter-spacing: 0.12em !important;
    color: var(--mcm-accent) !important; padding: 10px 20px 4px 32px !important;
  }
  .mcm-drawer-foot { padding: 20px !important; border-top: 1px solid #e8e4de !important; flex-shrink: 0 !important; }
  .mcm-drawer-foot-cta {
    display: block !important; text-align: center !important;
    background: var(--mcm-accent) !important; color: #ffffff !important;
    padding: 12px !important; border-radius: 50px !important;
    font-weight: 700 !important; font-size: 13.5px !important;
    text-decoration: none !important; margin-bottom: 16px !important;
  }
  .mcm-drawer-foot-cta:hover { background: #a07e3f !important; }
  .mcm-drawer-contact { display: flex !important; flex-direction: column !important; gap: 8px !important; }
  .mcm-drawer-contact a { font-size: 12.5px !important; color: #5a5a5a !important; text-decoration: none !important; }
  .mcm-drawer-contact a:hover { color: var(--mcm-accent) !important; }

  /* ── RESPONSIVE ──────────────────────────────────────── */
  @media (max-width: 1024px) {
    #mcm-site-header .mcm-nav { display: none !important; }
    #mcm-site-header .mcm-cta-btn { display: none !important; }
    #mcm-site-header .mcm-hamburger { display: flex !important; }
    #mcm-top-bar .mcm-top-center { display: none !important; }
  }
  @media (max-width: 768px) {
    #mcm-top-bar .mcm-top-inner { padding: 8px 16px !important; font-size: 11px !important; }
    #mcm-site-header .mcm-header-inner { padding: 0 16px !important; height: 78px !important; }
    #mcm-site-header .mcm-logo img { height: 64px !important; }
  }
  @media (max-width: 480px) {
    #mcm-top-bar .mcm-top-left { display: none !important; }
    #mcm-top-bar .mcm-top-right { margin: 0 auto !important; }
  }
{%- endstyle -%}

