<script>
(function () {
  // ── Sticky scroll ──
  const header  = document.getElementById('mcm-site-header');
  window.addEventListener('scroll', function() {
    header.classList.toggle('mcm-scrolled', window.scrollY > 60);
  }, { passive: true });

  // ── Search ──
  const searchOverlay = document.getElementById('mcm-search-overlay');
  document.getElementById('mcm-search-open').addEventListener('click', function() {
    searchOverlay.classList.add('mcm-search--open');
    requestAnimationFrame(function() { searchOverlay.querySelector('input').focus(); });
  });
  document.getElementById('mcm-search-close').addEventListener('click', function() {
    searchOverlay.classList.remove('mcm-search--open');
  });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') searchOverlay.classList.remove('mcm-search--open');
  });

  // ── Mobile drawer ──
  const drawer  = document.getElementById('mcm-drawer');
  const mask    = document.getElementById('mcm-drawer-mask');
  const burger  = document.getElementById('mcm-hamburger');
  const dClose  = document.getElementById('mcm-drawer-close');

  function openDrawer()  {
    drawer.classList.add('mcm-drawer--open');
    mask.classList.add('mcm-mask--active');
    burger.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }
  function closeDrawer() {
    drawer.classList.remove('mcm-drawer--open');
    mask.classList.remove('mcm-mask--active');
    burger.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }
  burger.addEventListener('click', openDrawer);
  dClose.addEventListener('click', closeDrawer);
  mask.addEventListener('click', closeDrawer);

  // ── Drawer accordion ──
  document.querySelectorAll('.mcm-drawer-toggle').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var target  = document.getElementById(btn.dataset.target);
      var isOpen  = target.classList.contains('is-open');
      // close all
      document.querySelectorAll('.mcm-drawer-sub').forEach(function(s) { s.classList.remove('is-open'); });
      document.querySelectorAll('.mcm-drawer-toggle').forEach(function(b) {
        b.classList.remove('is-open');
        b.setAttribute('aria-expanded', 'false');
      });
      if (!isOpen) {
        target.classList.add('is-open');
        btn.classList.add('is-open');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
})();
</script>

