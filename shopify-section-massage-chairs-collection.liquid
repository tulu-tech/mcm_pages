<!-- JAVASCRIPT -->
<script>
// FAQ Accordion
function toggleFaq(el) {
    const item = el.parentElement;
    const answer = item.querySelector('.faq-answer');
    const isOpen = item.classList.contains('open');
    // Close all
    document.querySelectorAll('.faq-item-acc').forEach(i => {
        i.classList.remove('open');
        i.querySelector('.faq-answer').style.maxHeight = null;
    });
    if (!isOpen) {
        item.classList.add('open');
        answer.style.maxHeight = answer.scrollHeight + 'px';
    }
}

// ========================================
// COMBINED FILTER SYSTEM (Price + Brand)
// ========================================
let activePrice = 'all';
let activeBrand = 'all';

function applyFilters() {
    const cards = document.querySelectorAll('.col-product-card');
    let count = 0;
    cards.forEach(card => {
        const cardBrand = card.dataset.brand;
        const cardPrice = parseInt(card.dataset.price) || 0;
        let brandMatch = (activeBrand === 'all' || cardBrand === activeBrand);
        let priceMatch = true;
        if (activePrice !== 'all') {
            const [min, max] = activePrice.split('-').map(Number);
            priceMatch = cardPrice >= min && cardPrice < max;
        }
        if (brandMatch && priceMatch) {
            card.style.display = '';
            card.setAttribute('data-hidden', 'false');
            count++;
        } else {
            card.style.display = 'none';
            card.setAttribute('data-hidden', 'true');
        }
    });
    document.getElementById('productCount').textContent = count + ' chair' + (count !== 1 ? 's' : '');
}

// Price chips (toggle — click again to deselect)
document.querySelectorAll('#priceChips .filter-chip').forEach(chip => {
    chip.addEventListener('click', function() {
        if (this.classList.contains('active')) {
            this.classList.remove('active');
            activePrice = 'all';
        } else {
            document.querySelectorAll('#priceChips .filter-chip').forEach(c => c.classList.remove('active'));
            this.classList.add('active');
            activePrice = this.dataset.price;
        }
        applyFilters();
    });
});

// Brand chips
document.querySelectorAll('#brandChips .filter-chip').forEach(chip => {
    chip.addEventListener('click', function() {
        document.querySelectorAll('#brandChips .filter-chip').forEach(c => c.classList.remove('active'));
        this.classList.add('active');
        activeBrand = this.dataset.brand;
        applyFilters();
    });
});

// Legacy function kept for category card onclick compatibility
function filterBrand(brand) {
    activeBrand = brand;
    document.querySelectorAll('#brandChips .filter-chip').forEach(c => {
        c.classList.toggle('active', c.dataset.brand === brand);
    });
    applyFilters();
}

// Category Filter
function filterCategory(cat) {
    // Reset brand filter to all
    activeBrand = 'all';
    activePrice = 'all';
    document.querySelectorAll('#brandChips .filter-chip').forEach(c => {
        c.classList.toggle('active', c.dataset.brand === 'all');
    });
    document.querySelectorAll('#priceChips .filter-chip').forEach(c => {
        c.classList.toggle('active', c.dataset.price === 'all');
    });
    applyFilters();
}

// Sort
function sortProducts(method) {
    const grid = document.querySelector('.collection-grid');
    const cards = Array.from(grid.querySelectorAll('.col-product-card'));
    cards.sort((a, b) => {
        if (method === 'price-low') return parseInt(a.dataset.price) - parseInt(b.dataset.price);
        if (method === 'price-high') return parseInt(b.dataset.price) - parseInt(a.dataset.price);
        if (method === 'name-az') return a.dataset.name.localeCompare(b.dataset.name);
        return 0;
    });
    cards.forEach(card => grid.appendChild(card));
}

// Filter bar scroll shadow
window.addEventListener('scroll', () => {
    const bar = document.querySelector('.filter-bar');
    if (bar) bar.classList.toggle('scrolled', window.scrollY > 200);
});

// Make product images clickable — navigate to product page
document.querySelectorAll('.col-card-img-wrap').forEach(imgWrap => {
    imgWrap.addEventListener('click', function() {
        const card = this.closest('.col-product-card');
        const link = card ? card.querySelector('.col-card-link') : null;
        if (link && link.href) {
            window.location.href = link.href;
        }
    });
});

// ========================================
// MOBILE: Reorder sections
// Move Filter Bar + Product Grid BEFORE Shop by Lifestyle
// ========================================
(function() {
    function reorderMobileSections() {
        if (window.innerWidth > 768) return;
        const mcm = document.querySelector('.mcm-collection');
        if (!mcm) return;
        const shopByLifestyle = document.getElementById('shopByLifestyle');
        const filterBar = document.querySelector('.filter-bar');
        const productGrid = document.getElementById('productGrid');
        if (!shopByLifestyle || !filterBar || !productGrid) return;
        // Only reorder if filterBar is currently AFTER shopByLifestyle
        if (shopByLifestyle.compareDocumentPosition(filterBar) & Node.DOCUMENT_POSITION_FOLLOWING) {
            // Move filter bar before Shop by Lifestyle
            shopByLifestyle.parentNode.insertBefore(filterBar, shopByLifestyle);
            // Move product grid before Shop by Lifestyle (after filter bar)
            shopByLifestyle.parentNode.insertBefore(productGrid, shopByLifestyle);
        }
    }
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', reorderMobileSections);
    } else {
        reorderMobileSections();
    }
})();

// ========================================
// PRODUCT IMAGE CAROUSEL
// Fetches all product images via Shopify JSON API
// and creates swipeable carousels in product cards
// ========================================
(function() {
    const productHandles = [
        'd-core-2-massage-chair',
        'panasonic-man1-massage-chair',
        'positive-posture-massage-chair-dualtech-pro-ai-4d',
        'positive-posture-massage-chair-solara',
        'panasonic-maf1-massage-chair',
        'positive-posture-massage-chair-brio-plus',
        'koyo-303ts-massage-chair',
        'positive-posture-brio-sport-massage-chair',
        'panasonic-mak1-massage-chair',
        'd-core-stratus-jp-massage-chair',
        'd-core-cirrus-jp-massage-chair',
        'ohco-r6-massage-chair',
        'ohco-m8-massage-chair',
        'positive-posture-massage-chair-dualtech-4d',
        'ohco-m8-neo-le-massage-chair'
    ];

    function createCarousel(imgWrap, images, productUrl) {
        if (!images || images.length <= 1) return;
        // Limit to 5 images max for performance
        const imgs = images.slice(0, 5);
        const existingImg = imgWrap.querySelector('.col-card-img');
        if (!existingImg) return;

        // Create carousel structure
        const carousel = document.createElement('div');
        carousel.className = 'col-card-carousel';
        const track = document.createElement('div');
        track.className = 'col-card-carousel-track';

        imgs.forEach((imgSrc, i) => {
            const img = document.createElement('img');
            img.className = 'col-card-img';
            img.src = imgSrc;
            img.alt = existingImg.alt + (i > 0 ? ' - Image ' + (i + 1) : '');
            img.loading = i === 0 ? 'eager' : 'lazy';
            track.appendChild(img);
        });

        carousel.appendChild(track);

        // Dots
        const dotsWrap = document.createElement('div');
        dotsWrap.className = 'col-card-carousel-dots';
        imgs.forEach((_, i) => {
            const dot = document.createElement('button');
            dot.className = 'col-card-carousel-dot' + (i === 0 ? ' active' : '');
            dot.setAttribute('aria-label', 'Image ' + (i + 1));
            dot.addEventListener('click', (e) => { e.stopPropagation(); goTo(i); });
            dotsWrap.appendChild(dot);
        });
        carousel.appendChild(dotsWrap);

        // Arrows
        const prevBtn = document.createElement('button');
        prevBtn.className = 'col-card-carousel-arrow prev';
        prevBtn.innerHTML = '‹';
        prevBtn.setAttribute('aria-label', 'Previous image');
        prevBtn.addEventListener('click', (e) => { e.stopPropagation(); goTo(currentIdx - 1); });

        const nextBtn = document.createElement('button');
        nextBtn.className = 'col-card-carousel-arrow next';
        nextBtn.innerHTML = '›';
        nextBtn.setAttribute('aria-label', 'Next image');
        nextBtn.addEventListener('click', (e) => { e.stopPropagation(); goTo(currentIdx + 1); });

        carousel.appendChild(prevBtn);
        carousel.appendChild(nextBtn);

        // State
        let currentIdx = 0;
        function goTo(idx) {
            if (idx < 0) idx = imgs.length - 1;
            if (idx >= imgs.length) idx = 0;
            currentIdx = idx;
            track.style.transform = 'translateX(-' + (currentIdx * 100) + '%)';
            dotsWrap.querySelectorAll('.col-card-carousel-dot').forEach((d, i) => {
                d.classList.toggle('active', i === currentIdx);
            });
        }

        // Touch swipe
        let touchStartX = 0;
        let touchEndX = 0;
        let isSwiping = false;
        carousel.addEventListener('touchstart', (e) => {
            touchStartX = e.changedTouches[0].screenX;
            isSwiping = true;
        }, { passive: true });
        carousel.addEventListener('touchend', (e) => {
            if (!isSwiping) return;
            touchEndX = e.changedTouches[0].screenX;
            const diff = touchStartX - touchEndX;
            if (Math.abs(diff) > 40) {
                if (diff > 0) goTo(currentIdx + 1);
                else goTo(currentIdx - 1);
            }
            isSwiping = false;
        }, { passive: true });

        // Replace the original img with the carousel
        existingImg.remove();
        imgWrap.insertBefore(carousel, imgWrap.firstChild);

        // Re-attach click-to-navigate (avoid navigating on swipe)
        imgWrap.addEventListener('click', function(e) {
            if (e.target.closest('.col-card-carousel-arrow') || e.target.closest('.col-card-carousel-dot')) return;
            if (productUrl) window.location.href = productUrl;
        });
    }

    function initCarousels() {
        const cards = document.querySelectorAll('.col-product-card');
        cards.forEach(card => {
            const imgWrap = card.querySelector('.col-card-img-wrap');
            const link = card.querySelector('.col-card-link');
            if (!imgWrap || !link) return;
            const productUrl = link.getAttribute('href');
            if (!productUrl) return;

            // Extract handle from URL
            const urlParts = productUrl.split('/products/');
            if (urlParts.length < 2) return;
            const handle = urlParts[1].split('?')[0].split('#')[0];

            // Fetch product images via Shopify JSON API
            fetch('/products/' + handle + '.json')
                .then(r => r.json())
                .then(data => {
                    if (data && data.product && data.product.images && data.product.images.length > 1) {
                        const imageSrcs = data.product.images.map(img => {
                            // Use 900w version for consistency
                            return img.src.replace(/\.([a-z]+)\?/, '_900x.$1?');
                        });
                        createCarousel(imgWrap, imageSrcs, productUrl);
                    }
                })
                .catch(() => { /* silently fail - keep single image */ });
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initCarousels);
    } else {
        initCarousels();
    }
})();
</script>

</div>
