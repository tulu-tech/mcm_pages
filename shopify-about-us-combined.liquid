/* CTA */
.au-cta-in{background:var(--gld);border-radius:20px;padding:60px;display:grid;grid-template-columns:1fr auto;gap:40px;align-items:center;position:relative;overflow:hidden}
.au-cta-in::before{content:'';position:absolute;top:-40%;right:-5%;width:400px;height:400px;background:radial-gradient(circle,rgba(255,255,255,.1) 0%,transparent 70%);border-radius:50%;pointer-events:none}
.au-cta-in h2{font-size:32px !important;color:#fff !important;margin-bottom:12px !important;position:relative;z-index:1}
.au-cta-in p{font-size:16px !important;color:rgba(255,255,255,.82) !important;position:relative;z-index:1}
