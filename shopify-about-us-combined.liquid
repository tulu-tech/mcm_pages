.au-hero-n strong{font-size:26px !important;font-weight:800 !important;color:var(--gld) !important;display:block;font-family:'Playfair Display',serif !important}
.au-hero-n span{font-size:10px !important;color:rgba(255,255,255,.45) !important;text-transform:uppercase;letter-spacing:.12em}
