<style>
  /* Google Fonts */
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,700;0,800;1,700;1,800&display=swap');

  /* =============================================================
     SHOPIFY THEME OVERRIDES — page-sacramento.liquid
     Breaks page out of theme container for full-bleed layout.
  ============================================================= */

  .template-page main,
  .template-page .main-content,
  .template-page #MainContent,
  .template-page .page-width,
  .template-page .container { max-width: 100% !important; padding: 0 !important; margin: 0 !important; }

  /* Hide Shopify theme footer — keep our custom .sc-footer */
  .template-page .site-footer,
  .template-page footer.footer,
  .template-page .footer:not(.sc-footer),
  .template-page #shopify-section-footer,
  .template-page [id^="shopify-section"][id$="footer"],
  .template-page .site-footer__inner { display: none !important; }

  /* Full-bleed sections */
  .sc-hero,
  .sc-stats,
  .sc-section,
  .sc-section-alt,
  .sc-dark,
  .sc-cta-band,
  .sc-final-cta,
  .sc-comp-strip,
  .sc-footer {
    width: 100vw !important;
    margin-left: calc(-50vw + 50%) !important;
  }
  .sc-section,
  .sc-section-alt { padding-left: 0; padding-right: 0; }

  .template-page .content-for-layout { padding-top: 0 !important; margin-top: 0 !important; }

  /* =============================================================
     CRITICAL: ABSOLUTE px FONT OVERRIDES
     Prevents Shopify theme root font-size from distorting layout.
  ============================================================= */
  .sc-wrap {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    color: #1a1a1a;
    line-height: 1.75;
    font-size: 16px;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    overflow-x: hidden;
  }
  .sc-wrap * { box-sizing: border-box; margin: 0; padding: 0; }
  .sc-wrap p    { font-size: 15px; line-height: 1.8; }
  .sc-wrap li   { font-size: 14px; line-height: 1.65; }
  .sc-wrap a    { text-decoration: none; }
  .sc-wrap h1   { font-size: clamp(34px, 5vw, 64px); line-height: 1.06; font-weight: 800; letter-spacing: -0.03em; font-family: 'Playfair Display', Georgia, serif; }
  .sc-wrap h2   { font-size: clamp(24px, 2.8vw, 36px); line-height: 1.15; font-weight: 800; letter-spacing: -0.025em; font-family: 'Playfair Display', Georgia, serif; }
  .sc-wrap h3   { font-size: clamp(16px, 1.8vw, 20px); line-height: 1.3; font-weight: 700; }
  .sc-wrap h4   { font-size: 13px; line-height: 1.35; font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; }
  .sc-wrap img  { max-width: 100%; display: block; }

  /* ── CSS VARIABLES ── */
  .sc-wrap {
    --sc-bg:          #ffffff;
    --sc-surface:     #f4f1ed;
    --sc-dark:        #0d0d0d;
    --sc-muted:       #5c5c5c;
    --sc-muted2:      #909090;
    --sc-accent:      #9a8050;
    --sc-accent-h:    #7d6a40;
    --sc-accent-warm: #c4a464;
    --sc-accent-pale: rgba(154,128,80,0.10);
    --sc-border:      #e4e0d8;
    --sc-radius:      18px;
    --sc-radius-sm:   10px;
    --sc-shadow:      0 6px 24px rgba(0,0,0,0.07);
    --sc-shadow-lg:   0 18px 48px rgba(0,0,0,0.13);
    --sc-transition:  all 0.28s cubic-bezier(0.25, 0.8, 0.25, 1);
  }

  /* ── LAYOUT ── */
  .sc-container    { max-width: 1200px; margin: 0 auto; padding: 0 2rem; }
  .sc-container-sm { max-width: 860px; margin: 0 auto; padding: 0 2rem; }
  .sc-section      { padding: 5rem 0; }
  .sc-section-alt  { background: var(--sc-surface); }



  /* ── HERO ── */
  .sc-hero { position: relative; min-height: 90vh; display: flex; align-items: center; overflow: hidden; background: #0a0a10; }
  .sc-hero-bg { position: absolute; inset: 0; z-index: 0; }
  .sc-hero-bg img { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; display: block; filter: brightness(0.46) saturate(0.9); animation: scHeroZoom 12s ease-in-out infinite alternate; }
  @keyframes scHeroZoom { from { transform: scale(1); } to { transform: scale(1.04); } }
  .sc-hero-overlay { position: absolute; inset: 0; z-index: 1;
    background:
      linear-gradient(to right, rgba(4,4,8,0.88) 0%, rgba(4,4,8,0.55) 55%, rgba(4,4,8,0.15) 100%),
      linear-gradient(to top,   rgba(4,4,8,0.85) 0%, transparent 55%);
  }
  .sc-hero-content { position: relative; z-index: 2; padding: 4.5rem 0 5rem; width: 100%; }
  .sc-hero-badge { display: inline-flex; align-items: center; gap: 8px; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #fff; font-size: 12px; font-weight: 700; padding: 5px 14px; border-radius: 50px; margin-bottom: 1.5rem; letter-spacing: 0.04em; }
  .sc-hero-badge-dot { width: 7px; height: 7px; background: #4ade80; border-radius: 50%; animation: scPulse 2s ease-in-out infinite; flex-shrink: 0; }
  @keyframes scPulse { 0%,100% { opacity: 1; } 50% { opacity: 0.4; } }
  .sc-hero h1 { color: #fff; max-width: 780px; margin-bottom: 1.25rem; }
  .sc-hero h1 em { color: var(--sc-accent-warm); font-style: italic; }
  .sc-hero-lead { font-size: 18px; color: rgba(255,255,255,0.78); max-width: 620px; margin-bottom: 2.5rem; line-height: 1.7; }
  .sc-hero-btns { display: flex; gap: 0.875rem; flex-wrap: wrap; margin-bottom: 2.25rem; }
  .sc-hero-trust { display: flex; gap: 1.75rem; flex-wrap: wrap; }
  .sc-hero-trust-item { display: flex; align-items: center; gap: 6px; font-size: 13px; color: rgba(255,255,255,0.60); font-weight: 600; }
  .sc-hero-trust-item::before { content: '✓'; color: var(--sc-accent-warm); font-weight: 900; }

  /* ── STICKY CTAs ── */
  .sc-sticky-cta { position: fixed; bottom: 1.5rem; right: 1.5rem; z-index: 998; display: flex; flex-direction: column; gap: 0.6rem; transition: opacity 0.35s; }
  .sc-sticky-btn { display: inline-flex; align-items: center; gap: 8px; padding: 0.8rem 1.5rem; border-radius: 50px; font-size: 14px; font-weight: 700; white-space: nowrap; box-shadow: 0 8px 24px rgba(0,0,0,0.25); transition: var(--sc-transition); cursor: pointer; font-family: 'Inter', sans-serif; text-decoration: none !important; }
  .sc-sticky-btn svg { width: 16px; height: 16px; fill: currentColor; flex-shrink: 0; }
  .sc-sticky-call { background: #0d0d0d; color: #fff !important; }
  .sc-sticky-call:hover { background: #222; transform: translateY(-2px); color: #fff !important; }
  .sc-sticky-dir { background: var(--sc-accent); color: #fff !important; }
  .sc-sticky-dir:hover { background: var(--sc-accent-h); transform: translateY(-2px); color: #fff !important; }

  /* ── BUTTONS ── */
  .sc-btn { display: inline-flex; align-items: center; justify-content: center; gap: 7px; padding: 0.85rem 1.875rem; font-size: 15px; font-weight: 700; border-radius: 50px; transition: var(--sc-transition); border: 2px solid transparent; cursor: pointer; font-family: 'Inter', sans-serif; letter-spacing: 0.01em; white-space: nowrap; text-decoration: none !important; }
  .sc-btn svg { width: 16px; height: 16px; fill: currentColor; flex-shrink: 0; }
  .sc-btn-primary { background: var(--sc-accent); color: #fff !important; border-color: var(--sc-accent); }
  .sc-btn-primary:hover { background: var(--sc-accent-h); border-color: var(--sc-accent-h); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(154,128,80,0.35); color: #fff !important; }
  .sc-btn-dark { background: var(--sc-dark); color: #fff !important; border-color: var(--sc-dark); }
  .sc-btn-dark:hover { background: #222; transform: translateY(-2px); box-shadow: 0 8px 20px rgba(0,0,0,0.22); color: #fff !important; }
  .sc-btn-outline { background: transparent; border: 2px solid rgba(255,255,255,0.35); color: #fff !important; }
  .sc-btn-outline:hover { background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.7); }

  /* ── EYEBROW / LABELS ── */
  .sc-eyebrow { display: block; font-size: 11px; font-weight: 800; letter-spacing: 0.2em; text-transform: uppercase; color: var(--sc-accent); margin-bottom: 0.875rem; }
  .sc-section-header { margin-bottom: 3rem; }
  .sc-section-header.center { text-align: center; }
  .sc-section-header p { font-size: 17px; color: var(--sc-muted); max-width: 680px; line-height: 1.8; margin-top: 0.75rem; }
  .sc-section-header.center p { margin-left: auto; margin-right: auto; }

  /* ── STATS BAR ── */
  .sc-stats { background: #0d0d0d; }
  .sc-stats-inner { display: flex; justify-content: center; flex-wrap: wrap; }
  .sc-stat { padding: 1.5rem 3rem; text-align: center; border-right: 1px solid rgba(255,255,255,0.08); }
  .sc-stat:last-child { border-right: none; }
  .sc-stat-num { font-size: 32px; font-weight: 900; color: #fff; display: block; line-height: 1; font-family: 'Inter', sans-serif; letter-spacing: -0.04em; }
  .sc-stat-num span { color: var(--sc-accent-warm); }
  .sc-stat-label { font-size: 11px; text-transform: uppercase; letter-spacing: 0.14em; color: rgba(255,255,255,0.38); margin-top: 5px; font-weight: 700; display: block; }

  /* ── WHY VISIT ── */
  .sc-why-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; }
  .sc-why-img { position: relative; border-radius: var(--sc-radius); overflow: hidden; box-shadow: var(--sc-shadow-lg); }
  .sc-why-img img { width: 100%; height: 520px; object-fit: cover; object-position: center; display: block; transition: transform 0.6s ease; }
  .sc-why-img:hover img { transform: scale(1.03); }
  .sc-why-badge { position: absolute; bottom: 1.75rem; left: 1.75rem; right: 1.75rem; background: rgba(10,10,14,0.85); backdrop-filter: blur(10px); border-radius: 12px; padding: 1rem 1.25rem; display: flex; align-items: center; gap: 0.875rem; border: 1px solid rgba(255,255,255,0.1); }
  .sc-why-badge-icon { width: 36px; height: 36px; background: var(--sc-accent); border-radius: 9px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .sc-why-badge-icon svg { width: 18px; height: 18px; fill: #fff; }
  .sc-why-badge-text strong { display: block; font-size: 14px; color: #fff; }
  .sc-why-badge-text span { font-size: 12px; color: rgba(255,255,255,0.55); }
  .sc-why-reasons { display: flex; flex-direction: column; gap: 1.125rem; margin-top: 2rem; }
  .sc-reason { display: flex; align-items: flex-start; gap: 1rem; padding: 1rem 1.25rem; background: #fff; border: 1px solid var(--sc-border); border-radius: 12px; transition: var(--sc-transition); }
  .sc-reason:hover { border-color: var(--sc-accent); box-shadow: 0 4px 16px rgba(154,128,80,0.12); }
  .sc-reason-icon { width: 38px; height: 38px; background: var(--sc-accent-pale); border-radius: 9px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .sc-reason-icon svg { width: 18px; height: 18px; fill: var(--sc-accent); }
  .sc-reason strong { display: block; font-size: 14px; margin-bottom: 2px; }
  .sc-reason span { font-size: 13px; color: var(--sc-muted); line-height: 1.6; }

  /* ── COMPARISON STRIP ── */
  .sc-comp-strip { background: linear-gradient(135deg, #08080f 0%, #0e0c18 60%, #090b10 100%); padding: 5rem 0; position: relative; overflow: hidden; }
  .sc-comp-strip::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse at 70% 50%, rgba(154,128,80,0.10) 0%, transparent 60%); pointer-events: none; }
  .sc-comp-inner { position: relative; z-index: 1; display: grid; grid-template-columns: 1.2fr 1fr; gap: 5rem; align-items: center; }
  .sc-comp-text h2 { color: #fff; font-size: clamp(22px, 2.8vw, 34px); margin-bottom: 1.25rem; line-height: 1.15; letter-spacing: -0.025em; }
  .sc-comp-text h2 em { color: var(--sc-accent-warm); font-style: italic; }
  .sc-comp-text p { color: rgba(255,255,255,0.62); font-size: 15px; line-height: 1.8; margin-bottom: 1.5rem; }
  .sc-comp-pills { display: flex; flex-wrap: wrap; gap: 0.625rem; margin-bottom: 2rem; }
  .sc-comp-pill { display: inline-flex; align-items: center; gap: 5px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); padding: 5px 13px; border-radius: 50px; font-size: 12px; font-weight: 600; color: rgba(255,255,255,0.78); }
  .sc-comp-pill::before { content: ''; width: 6px; height: 6px; background: var(--sc-accent); border-radius: 50%; flex-shrink: 0; }
  .sc-comp-brands { display: grid; grid-template-columns: 1fr 1fr; gap: 0.875rem; }
  .sc-comp-tile { background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 14px; padding: 1.5rem; text-align: center; transition: var(--sc-transition); }
  .sc-comp-tile:hover { border-color: rgba(154,128,80,0.35); background: rgba(154,128,80,0.06); }
  .sc-comp-tile-name { font-family: 'Inter', sans-serif; font-weight: 900; font-size: 15px; letter-spacing: 0.08em; text-transform: uppercase; color: #fff; margin-bottom: 4px; }
  .sc-comp-tile-note { font-size: 12px; color: rgba(255,255,255,0.42); line-height: 1.5; }
  .sc-comp-tile.sc-span { grid-column: 1 / -1; }

  /* ── BRANDS ── */
  .sc-brands-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .sc-brand-card { background: #fff; border: 1px solid var(--sc-border); border-radius: var(--sc-radius); padding: 2rem 2.25rem; transition: var(--sc-transition); position: relative; overflow: hidden; }
  .sc-brand-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: var(--sc-accent); transform: scaleX(0); transform-origin: left; transition: transform 0.3s; }
  .sc-brand-card:hover { transform: translateY(-5px); box-shadow: var(--sc-shadow-lg); }
  .sc-brand-card:hover::before { transform: scaleX(1); }
  .sc-brand-card-full { grid-column: 1 / -1; max-width: 600px; margin: 0 auto; width: 100%; }
  .sc-brand-card-dark { background: linear-gradient(135deg, #111 0%, #1c1c1c 100%); border-color: rgba(154,128,80,0.25); }
  .sc-brand-card-dark::before { background: linear-gradient(90deg, var(--sc-accent), var(--sc-accent-warm)); }
  .sc-brand-card-dark .sc-brand-name { color: #fff; }
  .sc-brand-card-dark .sc-brand-tag { color: var(--sc-accent-warm); background: rgba(154,128,80,0.15); }
  .sc-brand-card-dark p { color: rgba(255,255,255,0.62); }
  .sc-brand-card-dark .sc-brand-ideal { color: rgba(255,255,255,0.42); }
  .sc-brand-card-dark .sc-brand-ideal strong { color: rgba(255,255,255,0.88); }
  .sc-brand-card-dark .sc-brand-card-footer { border-top-color: rgba(255,255,255,0.1); }
  .sc-brand-card-dark .sc-brand-arrow { background: rgba(255,255,255,0.1); }
  .sc-brand-card-dark .sc-brand-arrow svg { fill: #fff; }
  .sc-brand-card-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
  .sc-brand-name { font-size: 22px; font-weight: 900; color: var(--sc-dark); letter-spacing: -0.02em; text-transform: uppercase; }
  .sc-brand-tag { font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.12em; color: var(--sc-accent); background: var(--sc-accent-pale); padding: 4px 10px; border-radius: 20px; white-space: nowrap; flex-shrink: 0; }
  .sc-brand-card p { font-size: 14px; color: var(--sc-muted); line-height: 1.8; margin-bottom: 0.875rem; }
  .sc-brand-card-footer { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-top: 0.875rem; border-top: 1px solid var(--sc-border); margin-top: 0.5rem; }
  .sc-brand-ideal { font-size: 13px; color: var(--sc-muted); }
  .sc-brand-ideal strong { color: var(--sc-dark); }
  .sc-brand-arrow { width: 34px; height: 34px; background: var(--sc-dark); border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: var(--sc-transition); text-decoration: none !important; }
  .sc-brand-arrow svg { width: 16px; height: 16px; fill: #fff; }
  .sc-brand-arrow:hover { background: var(--sc-accent); transform: scale(1.1); }

  /* ── VISIT STEPS ── */
  .sc-dark { background: linear-gradient(135deg, #08080f 0%, #0e0c18 60%, #090b10 100%); }
  .sc-steps { display: grid; grid-template-columns: repeat(6, 1fr); gap: 0; }
  .sc-step { padding: 2.5rem 1.5rem; border-right: 1px solid rgba(255,255,255,0.07); text-align: center; }
  .sc-step:last-child { border-right: none; }
  .sc-step-circle { width: 60px; height: 60px; background: rgba(255,255,255,0.07); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem; font-size: 24px; border: 1px solid rgba(255,255,255,0.1); transition: var(--sc-transition); }
  .sc-step:hover .sc-step-circle { background: var(--sc-accent); border-color: var(--sc-accent); }
  .sc-step h4 { font-size: 12px; color: #fff; margin-bottom: 0.5rem; letter-spacing: 0.04em; }
  .sc-step p { font-size: 12px; color: rgba(255,255,255,0.48); line-height: 1.7; }

  /* ── TECHNOLOGY GRID ── */
