  font-size: clamp(30px, 3vw, 48px);
  line-height: 1.05;
  letter-spacing: 0;
}
.ppcmp__visual-chapter-head p { margin-top: 8px; max-width: 860px; color: var(--muted) !important; }
.ppcmp__visual-stage {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: clamp(22px, 3vw, 34px);
}
.ppcmp__zone-card {
  position: relative;
  padding: clamp(18px, 2.4vw, 28px);
  border: 1px solid rgba(222,216,206,.96);
  border-radius: 24px;
  background: #fff;
  box-shadow: 0 26px 62px rgba(20,17,15,.11);
  overflow: hidden;
}
.ppcmp__zone-card::after {
  content: "";
  position: absolute;
  left: 28px;
  right: 28px;
  bottom: 0;
  height: 7px;
  border-radius: 999px 999px 0 0;
  background: rgba(164,125,67,.22);
}
.ppcmp__zone-card--brio::after { background: rgba(80,102,90,.22); }
.ppcmp__zone-tag {
