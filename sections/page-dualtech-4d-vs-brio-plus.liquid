}
.ppcmp__zone-img--full { width: min(92%, 590px); max-height: 92%; }
.ppcmp__zone-overlay {
  position: absolute;
  inset: 0;
  z-index: 2;
  width: 100%;
  height: 100%;
  pointer-events: none;
}
.ppcmp__zone-path {
  fill: none;
  stroke: var(--gold);
  stroke-width: 8;
  stroke-linecap: round;
  opacity: .68;
}
.ppcmp__zone-path--sage { stroke: var(--sage); }
.ppcmp__zone-path--blue { stroke: var(--blue); opacity: .58; }
.ppcmp__zone-path--wine { stroke: var(--wine); opacity: .54; }
.ppcmp__zone-dot { fill: var(--gold); stroke: rgba(255,255,255,.88); stroke-width: 8; }
.ppcmp__zone-dot--sage { fill: var(--sage); }
.ppcmp__zone-dot--blue { fill: var(--blue); }
.ppcmp__zone-dot--wine { fill: var(--wine); }
.ppcmp__zone-ring {
  fill: none;
  stroke: currentColor;
  stroke-width: 3;
  opacity: .22;
}
.ppcmp__zone-ring--gold { color: var(--gold); }
.ppcmp__zone-ring--sage { color: var(--sage); }
.ppcmp__zone-ring--blue { color: var(--blue); }
.ppcmp__zone-ring--wine { color: var(--wine); }
.ppcmp__zone-shade {
  fill: var(--gold);
  opacity: .14;
}
.ppcmp__zone-shade--sage { fill: var(--sage); }
.ppcmp__zone-shade--blue { fill: var(--blue); }
.ppcmp__zone-shade--wine { fill: var(--wine); }
.ppcmp__zone-caption {
