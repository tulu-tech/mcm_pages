  border-color: rgba(80,102,90,.25);
  background: rgba(240,244,241,.92);
  color: var(--sage);
}
.ppcmp__zone-media {
  position: relative;
  display: grid;
  place-items: center;
  min-height: 420px;
  aspect-ratio: 1.22 / 1;
  overflow: hidden;
  border-radius: 18px;
  background:
    radial-gradient(circle at 50% 44%, rgba(238,236,229,.78), transparent 46%),
    #fff;
}
