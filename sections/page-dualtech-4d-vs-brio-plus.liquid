  z-index: -2;
  background-image: linear-gradient(90deg, rgba(13,14,13,.98) 0%, rgba(20,17,15,.95) 46%, rgba(83,60,70,.82) 100%), url("{{ img_showroom }}");
  background-size: cover;
  background-position: center;
}
.ppcmp__showroom::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
  background: repeating-linear-gradient(90deg, rgba(255,255,255,.035) 0, rgba(255,255,255,.035) 1px, transparent 1px, transparent 84px);
