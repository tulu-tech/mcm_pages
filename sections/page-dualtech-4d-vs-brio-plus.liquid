}
.ppcmp__zone-caption span { display: block; color: var(--copy); font-size: 15px; line-height: 1.55; }
.ppcmp__visual-explain {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
  margin-top: 22px;
}
