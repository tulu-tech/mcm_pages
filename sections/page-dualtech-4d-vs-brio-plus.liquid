.ppcmp__showroom-card img { width: 128px; height: 128px; object-fit: contain; }
.ppcmp__showroom-card small { display: block; color: var(--gold); font-size: 10px; font-weight: 900; letter-spacing: .12em; text-transform: uppercase; }
.ppcmp__showroom-card strong { display: block; margin: 4px 0 6px; color: var(--ink); font-size: 20px; line-height: 1.15; }
.ppcmp__showroom-card span { display: block; color: var(--muted); font-size: 13px; line-height: 1.45; }
.ppcmp__showroom-vs {
  display: grid;
  place-items: center;
