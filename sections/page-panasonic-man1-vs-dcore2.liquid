}
.m2__summary-row h3 { margin: 0 0 5px; color: var(--ink); font-size: 20px; line-height: 1.2; }
.m2__summary-row p { font-size: 14px !important; line-height: 1.62; }
.m2__callout {
  margin-top: 20px;
  padding: 18px 20px;
  border-left: 4px solid var(--gold);
  background: #fff;
  border-radius: 0 8px 8px 0;
}
.m2__visual img {
  width: 100%;
  height: 100%;
  min-height: 420px;
  object-fit: cover;
}
.m2__visual--contain img {
  object-fit: contain;
  padding: 20px;
  background: #fff;
}

.m2__try-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
}
.m2__try-card {
  min-height: 260px;
  padding: 22px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #fff;
  box-shadow: var(--shadow);
}
.m2__try-card span {
  display: block;
  color: var(--gold);
  font-size: 11px;
  font-weight: 900;
  letter-spacing: .12em;
  text-transform: uppercase;
}
.m2__try-card h3 { margin: 12px 0 10px; color: var(--ink); font-size: 24px; line-height: 1.15; }
.m2__try-card p { font-size: 14px !important; line-height: 1.65; }

.m2__feel-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 22px;
}
.m2__feel-card {
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #fff;
  overflow: hidden;
  box-shadow: var(--shadow);
}
.m2__feel-card img {
  width: 100%;
  height: 360px;
  object-fit: cover;
}
.m2__feel-copy { padding: 26px; }
.m2__feel-copy h3 { margin: 0 0 10px; color: var(--ink); font-size: 28px; line-height: 1.12; }
.m2__feature-list { display: grid; gap: 9px; margin-top: 18px; list-style: none; }
.m2__feature-list li {
  position: relative;
  padding-left: 20px;
  font-size: 14px;
}
.m2__feature-list li::before {
  content: "";
  position: absolute;
  left: 0;
  top: .72em;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--gold);
}

.m2__price-box {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
  margin-top: 22px;
}
.m2__price-card {
  padding: 20px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #fff;
}
.m2__price-card small { color: var(--gold); font-size: 11px; font-weight: 900; letter-spacing: .12em; text-transform: uppercase; }
.m2__price-card h3 { margin: 8px 0 8px; color: var(--ink); font-size: 30px; line-height: 1; }
.m2__old { color: var(--muted); text-decoration: line-through; font-size: 18px; font-weight: 800; }
.m2__new { color: var(--ink); font-size: 32px; font-weight: 900; }
.m2__scale {
  margin-top: 14px;
  height: 12px;
  border-radius: 999px;
  background: #e4ded2;
  overflow: hidden;
}
.m2__scale i { display: block; height: 100%; border-radius: 999px; background: linear-gradient(90deg, var(--moss), var(--gold)); }

.m2__demo-grid {
  display: grid;
  grid-template-columns: minmax(420px, .9fr) minmax(0, .78fr);
  gap: clamp(28px, 5vw, 70px);
  align-items: center;
}
.m2__checklist {
  display: grid;
  gap: 10px;
  list-style: none;
}
.m2__checklist li {
  display: grid;
  grid-template-columns: 34px 1fr;
  gap: 12px;
  align-items: start;
  padding: 14px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #fff;
}
.m2__checklist b {
  display: grid;
  place-items: center;
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background: var(--soft);
  color: var(--gold);
}
.m2__checklist span { display: block; color: var(--ink); font-weight: 900; }
.m2__checklist small { display: block; margin-top: 2px; color: var(--muted); font-size: 13px; line-height: 1.5; }
.m2__flow-card {
  margin-top: 18px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #fff;
  overflow: hidden;
  box-shadow: var(--shadow);
}
.m2__flow-card img {
  width: 100%;
  height: 260px;
  object-fit: cover;
}
.m2__flow-card p {
  padding: 15px 18px 18px;
  color: var(--muted) !important;
  font-size: 13px !important;
  line-height: 1.55;
}

.m2__table-note {
  display: none;
  margin-bottom: 10px;
  color: var(--muted);
  font-size: 12px;
  font-weight: 900;
  letter-spacing: .08em;
  text-transform: uppercase;
}
.m2__table-wrap {
  overflow-x: auto;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #fff;
  box-shadow: var(--shadow);
}
.m2__table {
  width: 100%;
  min-width: 880px;
  border-collapse: collapse;
}
.m2__table th {
  padding: 16px 18px;
  background: var(--ink);
  color: #fff;
  font-size: 12px;
  font-weight: 900;
  letter-spacing: .1em;
