  flex-direction: column;
  gap: 8px;
}
.m2__zone-list--man1 { text-align: right; }
.m2__zone-list li {
  padding: 9px 12px;
  border-radius: 6px;
  font-family: Inter, sans-serif;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.02em;
  background: rgba(201, 160, 107, 0.10);
  color: rgba(212, 168, 110, 0.62);
  border: 1px solid rgba(201, 160, 107, 0.18);
  transition: all 0.22s ease;
}
.m2__zone-list--dcore li {
  background: rgba(97, 112, 100, 0.10);
  color: rgba(168, 192, 177, 0.62);
  border-color: rgba(97, 112, 100, 0.18);
}
.m2__zone-list li.is-active {
  background: rgba(201, 160, 107, 0.24);
