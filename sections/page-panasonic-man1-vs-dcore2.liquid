/* ═══════ UI Polish Layer ═══════ */
.m2 {
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
}
.m2 :focus-visible {
  outline: 2px solid var(--gold);
  outline-offset: 3px;
  border-radius: 6px;
}
.m2 .m2__btn:focus-visible { outline-offset: 4px; }

/* Headings refinement */
.m2__h1 { letter-spacing: -0.02em; }
.m2__h2 { letter-spacing: -0.015em; }

/* Buttons polish */
.m2__btn {
  letter-spacing: 0.012em;
  transition: transform 0.22s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.22s ease, background 0.22s ease, border-color 0.22s ease;
}
.m2__btn:hover { transform: translateY(-2px); }

/* Section breathing on desktop */
@media (min-width: 1024px) {
  .m2__section { padding: 96px 0; }
}

/* Cards — premium shadow */
.m2__try-card,
.m2__feel-card,
.m2__price-card,
.m2__model-card,
.m2__group-card,
.m2__demo-card,
.m2__map-card {
  border-radius: 12px;
  transition: transform 0.32s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.32s ease, border-color 0.32s ease;
}
.m2__try-card:hover,
.m2__feel-card:hover,
.m2__price-card:hover,
.m2__model-card:hover,
.m2__demo-card:hover {
  transform: translateY(-3px);
  box-shadow:
    0 1px 2px rgba(22, 19, 15, 0.05),
    0 14px 36px rgba(22, 19, 15, 0.10),
    0 32px 70px rgba(22, 19, 15, 0.07);
}

/* Hero chip polish */
.m2__chip {
  letter-spacing: 0.012em;
  transition: background 0.22s ease, border-color 0.22s ease, transform 0.22s ease;
}
.m2__chip:hover { transform: translateY(-1px); }

/* Hero stats polish */
.m2__hero-stat {
  transition: transform 0.22s ease;
}
.m2__hero-stat:hover { transform: translateY(-2px); }

/* Sticky nav refinement */
.m2__nav a {
  letter-spacing: 0.012em;
  transition: color 0.18s ease, border-color 0.18s ease;
}

/* Pills/feature list polish */
.m2__feature-list li {
  letter-spacing: 0.005em;
}

/* FAQ details polish */
.m2__faq details {
  border-radius: 12px;
  transition: box-shadow 0.22s ease, border-color 0.22s ease;
}
.m2__faq details:hover {
  border-color: rgba(169, 130, 67, 0.4);
}
.m2__faq details[open] {
  box-shadow: 0 12px 32px rgba(22, 19, 15, 0.06);
}
.m2__faq summary {
  letter-spacing: -0.005em;
  font-weight: 800;
}

/* Body text */
.m2 p { letter-spacing: 0.005em; }

/* Mobile typography tightening */
@media (max-width: 760px) {
  .m2__section { padding: 60px 0; }
  .m2__btn { min-height: 50px; padding: 13px 22px; font-size: 14.5px; }
}


