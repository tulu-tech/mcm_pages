}
.m2__table th:nth-child(2) { background: var(--blue); }
.m2__table th:nth-child(3) { background: var(--plum); }
.m2__table td {
  padding: 15px 18px;
  border-bottom: 1px solid var(--line);
  color: var(--copy);
  font-size: 14px;
  line-height: 1.62;
  vertical-align: top;
}
.m2__table tr:last-child td { border-bottom: 0; }
.m2__table td:first-child {
  width: 210px;
  background: #fbfaf6;
  color: var(--ink);
  font-weight: 900;
}
.m2__table a { color: var(--gold) !important; font-weight: 900; text-decoration: underline; text-underline-offset: 3px; }

.m2__groups {
  display: grid;
  gap: 18px;
}
.m2__group {
  display: grid;
  grid-template-columns: minmax(0, .72fr) minmax(0, 1fr);
  gap: 0;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #fff;
  box-shadow: var(--shadow);
  overflow: hidden;
}
.m2__group-head {
  padding: 26px;
  background: var(--soft);
  border-right: 1px solid var(--line);
}
.m2__group-head span { color: var(--gold); font-size: 11px; font-weight: 900; letter-spacing: .12em; text-transform: uppercase; }
.m2__group-head h3 { margin: 10px 0; color: var(--ink); font-size: 27px; line-height: 1.12; }
.m2__group-body {
  display: grid;
  grid-template-columns: 1fr 1fr;
}
.m2__group-col { padding: 24px; }
.m2__group-col + .m2__group-col { border-left: 1px solid var(--line); }
.m2__group-col h4 { margin: 0 0 10px; color: var(--ink); font-size: 19px; }
.m2__group-col ul { display: grid; gap: 8px; list-style: none; }
.m2__group-col li {
  position: relative;
  padding-left: 18px;
  font-size: 14px;
}
.m2__group-col li::before {
  content: "";
  position: absolute;
  left: 0;
  top: .72em;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--gold);
}

.m2__quote-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
  margin-top: 32px;
}
.m2__quote {
  padding: 20px;
  border: 1px solid rgba(255,255,255,.14);
  border-radius: 8px;
  background: rgba(255,255,255,.06);
}
.m2__quote span { color: #e7c77d; font-size: 11px; font-weight: 900; letter-spacing: .12em; text-transform: uppercase; }
.m2__quote p { margin-top: 10px; color: rgba(255,255,255,.78) !important; font-size: 15px !important; }

.m2__answer {
  max-width: 920px;
  margin: 0 auto;
  padding: clamp(24px, 4vw, 38px);
  border: 1px solid rgba(255,255,255,.14);
  border-radius: 8px;
  background: rgba(255,255,255,.06);
}
.m2__answer p { color: rgba(255,255,255,.78) !important; font-size: 18px !important; }

.m2__faq {
  display: grid;
  gap: 10px;
  max-width: 980px;
  margin: 0 auto;
}
.m2__faq details {
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #fff;
  overflow: hidden;
}
.m2__faq summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  padding: 19px 22px;
  cursor: pointer;
  color: var(--ink);
  font-size: 16px;
  font-weight: 900;
  list-style: none;
}
.m2__faq summary::-webkit-details-marker { display: none; }
.m2__faq summary::after {
  content: "+";
  flex: 0 0 auto;
  width: 28px;
  height: 28px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--soft);
  color: var(--gold);
  font-size: 20px;
}
.m2__faq details[open] summary::after { content: "-"; }
.m2__faq div { padding: 0 22px 22px; }

.m2__final {
  position: relative;
  background:
    radial-gradient(circle at 84% 22%, rgba(169,130,67,.20), transparent 30%),
    linear-gradient(120deg, #11130f 0%, #171512 48%, #533846 100%);
}
.m2__final-grid {
  display: grid;
  grid-template-columns: minmax(0, .9fr) minmax(420px, .72fr);
  gap: clamp(28px, 5vw, 70px);
  align-items: center;
}
.m2__final h2 {
  margin: 0;
  color: #fff;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(34px, 5vw, 60px);
  line-height: 1.06;
}
.m2__final p { margin-top: 16px; color: rgba(255,255,255,.76) !important; font-size: 18px !important; }
.m2__final-list { display: grid; gap: 9px; margin: 24px 0 30px; list-style: none; }
.m2__final-list li { position: relative; padding-left: 22px; color: rgba(255,255,255,.77); }
.m2__final-list li::before {
  content: "";
  position: absolute;
  left: 0;
  top: .72em;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #e7c77d;
}
.m2__demo-pair {
  display: grid;
  gap: 12px;
  padding: 18px;
  border: 1px solid rgba(255,255,255,.18);
  border-radius: 8px;
  background: rgba(255,255,255,.08);
}
.m2__demo-card {
  display: grid;
  grid-template-columns: 126px 1fr;
  gap: 16px;
  align-items: center;
  padding: 14px;
  border-radius: 8px;
  background: rgba(255,255,255,.94);
}
.m2__demo-card img {
  width: 126px;
  height: 126px;
  object-fit: contain;
}
.m2__demo-card small { color: var(--gold); font-size: 10px; font-weight: 900; letter-spacing: .12em; text-transform: uppercase; }
.m2__demo-card strong { display: block; margin: 4px 0 5px; color: var(--ink); font-size: 20px; line-height: 1.15; }
.m2__demo-card span span { display: block; color: var(--muted); font-size: 13px; line-height: 1.45; }
.m2__vs {
  display: grid;
  place-items: center;
  width: 46px;
  height: 46px;
  margin: -4px auto;
  border-radius: 50%;
  background: #e7c77d;
  color: #11130f;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: .1em;
  text-transform: uppercase;
}
.m2__links {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 9px;
  margin-top: 30px;
}
.m2__links a {
  display: inline-flex;
  align-items: center;
  min-height: 35px;
  padding: 7px 11px;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: #fff;
  color: var(--copy);
  font-size: 12px;
  font-weight: 900;
}
.m2__mobile-cta {
  display: none;
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9000;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  padding: 10px 12px calc(10px + env(safe-area-inset-bottom));
  background: rgba(255,255,255,.96);
  border-top: 1px solid rgba(20,17,15,.12);
  box-shadow: 0 -12px 34px rgba(0,0,0,.14);
}
.m2__mobile-cta .m2__btn { min-height: 43px; padding: 10px 12px; font-size: 13px; }

@media (max-width: 1120px) {
  .m2__hero-grid,
  .m2__split,
  .m2__split--flip,
  .m2__demo-grid,
  .m2__final-grid { grid-template-columns: 1fr; }
  .m2__hero-panel,
  .m2__visual,
  .m2__demo-pair { max-width: 760px; }
  .m2__try-grid,
  .m2__quote-row { grid-template-columns: 1fr; }
