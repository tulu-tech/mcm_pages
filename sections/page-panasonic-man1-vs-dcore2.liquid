  .m2__wrap,
  .m2__wide { width: min(100% - 32px, 1180px); }
  .m2__hero { min-height: auto; }
  .m2__hero-grid { padding: 64px 0 72px; }
  .m2__hero h1 { font-size: 39px; }
  .m2__hero-lead,
  .m2__lead,
  .m2__final p,
  .m2__answer p { font-size: 16px !important; }
  .m2__actions { flex-direction: column; align-items: stretch; }
  .m2__btn { width: 100%; }
  .m2__product-pair,
  .m2__hero-stats,
  .m2__map-grid,
  .m2__map-notes,
  .m2__feel-grid,
  .m2__price-box,
  .m2__group-body { grid-template-columns: 1fr; }
  .m2__product-tile { min-height: 280px; }
  .m2__map-card { min-height: 500px; }
  .m2__map-canvas { min-height: 330px; }
  .m2__map-canvas img { width: min(88%, 420px); max-height: 300px; }
  .m2__board-head { grid-template-columns: 1fr; gap: 8px; }
  .m2__product-tile + .m2__product-tile { margin-top: 0; }
  .m2__summary-row { grid-template-columns: 1fr; }
  .m2__visual img,
  .m2__feel-card img { min-height: 0; height: 300px; }
  .m2__group-col + .m2__group-col { border-left: 0; border-top: 1px solid var(--line); }
  .m2__table-note { display: block; }
  .m2__demo-card { grid-template-columns: 104px 1fr; }
  .m2__demo-card img { width: 104px; height: 104px; }
  .m2__mobile-cta { display: grid; }
