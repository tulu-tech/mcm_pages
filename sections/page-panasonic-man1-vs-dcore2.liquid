  text-transform: uppercase;
  margin-bottom: 6px;
}
.m2__zone-head-sub {
  display: block;
  color: #888;
  font-family: Inter, sans-serif;
  font-size: 11px;
  font-weight: 500;
}
.m2__zone-grid {
  display: grid;
  grid-template-columns: minmax(170px, 1fr) minmax(220px, 1.1fr) auto minmax(220px, 1.1fr) minmax(170px, 1fr);
  gap: 18px;
