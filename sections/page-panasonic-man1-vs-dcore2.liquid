.m2__zone-list--dcore li.is-active {
  background: rgba(97, 112, 100, 0.26);
  color: #b6cdbf;
  border-color: rgba(168, 192, 177, 0.55);
  box-shadow: 0 6px 18px rgba(97, 112, 100, 0.20);
  transform: translateX(4px);
}
.m2__zone-list.is-filtering li:not(.is-active) { opacity: 0.32; }
.m2__zone-fig {
  position: relative;
  background: #f4f4f1;
  border-radius: 12px;
  overflow: hidden;
  aspect-ratio: 1 / 1;
}
.m2__zone-fig img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: contain;
}
.m2__zone-fig-brand {
  position: absolute;
  top: 10px;
  left: 10px;
  font-family: Inter, sans-serif;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 0.18em;
  color: #c9a06b;
  text-transform: uppercase;
  z-index: 2;
  background: rgba(255, 255, 255, 0.94);
  padding: 4px 9px;
  border-radius: 4px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  white-space: nowrap;
}
.m2__zone-fig--dcore .m2__zone-fig-brand { color: #617064; }
.m2__zone-pin {
  position: absolute;
  width: 34px;
  height: 34px;
  border-radius: 50%;
  border: 2px solid rgba(255, 255, 255, 0.94);
  background: rgba(201, 160, 107, 0.94);
  color: #fff;
  font-family: Inter, sans-serif;
  font-size: 13px;
  font-weight: 900;
  cursor: pointer;
  transform: translate(-50%, -50%);
  display: grid;
  place-items: center;
  transition: transform 0.18s ease, box-shadow 0.18s ease;
  box-shadow: 0 6px 14px rgba(0, 0, 0, 0.34);
  padding: 0;
  z-index: 3;
}
.m2__zone-fig--dcore .m2__zone-pin { background: rgba(97, 112, 100, 0.94); }
.m2__zone-pin:hover,
.m2__zone-pin.is-active,
.m2__zone-pin:focus-visible {
  outline: none;
  transform: translate(-50%, -50%) scale(1.18);
  box-shadow: 0 0 0 8px rgba(201, 160, 107, 0.22), 0 8px 18px rgba(0, 0, 0, 0.34);
}
.m2__zone-fig--dcore .m2__zone-pin:hover,
.m2__zone-fig--dcore .m2__zone-pin.is-active,
.m2__zone-fig--dcore .m2__zone-pin:focus-visible {
  box-shadow: 0 0 0 8px rgba(97, 112, 100, 0.22), 0 8px 18px rgba(0, 0, 0, 0.34);
}
.m2__zone-vs {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: #1a1a1e;
  border: 2px solid #333;
  display: grid;
  place-items: center;
  color: #c9a06b;
  font-family: Georgia, serif;
  font-size: 20px;
  font-weight: 700;
}
@media (max-width: 1100px) {
  .m2__zone-grid { grid-template-columns: 1fr 1fr; gap: 16px; }
  .m2__zone-fig--man1 { grid-column: 1; grid-row: 1; }
  .m2__zone-fig--dcore { grid-column: 2; grid-row: 1; }
  .m2__zone-list--man1 { grid-column: 1; grid-row: 2; text-align: left; }
  .m2__zone-list--dcore { grid-column: 2; grid-row: 2; }
  .m2__zone-list--man1 li.is-active { transform: translateX(4px); }
  .m2__zone-vs { display: none; }
}
@media (max-width: 640px) {
  .m2__zone-board-inner { padding: 24px 16px; }
  .m2__zone-grid { grid-template-columns: 1fr; }
  .m2__zone-fig--man1, .m2__zone-fig--dcore { grid-column: 1; }
  .m2__zone-list--man1, .m2__zone-list--dcore { grid-column: 1; }
  .m2__zone-fig--man1 { grid-row: 1; }
  .m2__zone-list--man1 { grid-row: 2; }
  .m2__zone-fig--dcore { grid-row: 3; }
  .m2__zone-list--dcore { grid-row: 4; }
}

.m2__nav {
  position: sticky;
  top: 0;
  z-index: 30;
  background: rgba(255,255,255,.96);
  border-bottom: 1px solid var(--line);
  backdrop-filter: blur(12px);
}
.m2__nav-inner {
  display: flex;
  justify-content: center;
  gap: 6px;
  overflow-x: auto;
  padding: 10px 0;
}
.m2__nav a {
  flex: 0 0 auto;
  padding: 7px 10px;
  border-radius: 999px;
  color: var(--muted);
  font-size: 12px;
  font-weight: 900;
}
.m2__nav a:hover { background: var(--soft); color: var(--ink); }

.m2__split {
  display: grid;
  grid-template-columns: minmax(0, .72fr) minmax(420px, .82fr);
  gap: clamp(28px, 5vw, 70px);
  align-items: center;
}
.m2__split--flip { grid-template-columns: minmax(420px, .82fr) minmax(0, .72fr); }
.m2__panel {
  border: 1px solid var(--line);
