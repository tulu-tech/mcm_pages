{%- comment -%} FAQ + Subnav JavaScript {%- endcomment -%}
<script>
(function(){
  // FAQ Toggle
  document.querySelectorAll('.ohco-faq-q').forEach(function(q){
    q.addEventListener('click',function(){
      var item=q.parentElement;
      var answer=item.querySelector('.ohco-faq-a');
      var isOpen=item.classList.contains('open');
      item.classList.toggle('open');
      if(isOpen){answer.style.maxHeight=null}else{answer.style.maxHeight=answer.scrollHeight+'px'}
    });
  });

  // Sticky subnav active state
  var sections=document.querySelectorAll('.ohco-wrap section[id]');
  var navLinks=document.querySelectorAll('.ohco-subnav-inner a');
  var observerOptions={rootMargin:'-120px 0px -70% 0px',threshold:0};
  var observer=new IntersectionObserver(function(entries){
    entries.forEach(function(entry){
      if(entry.isIntersecting){
        var id=entry.target.getAttribute('id');
        navLinks.forEach(function(link){
          link.classList.toggle('active',link.getAttribute('href')==='#'+id);
        });
      }
    });
  },observerOptions);
  sections.forEach(function(section){observer.observe(section)});

  // Scroll hint for comparison table
  var compareWrap=document.querySelector('.ohco-compare-wrap');
  var scrollHint=document.querySelector('.ohco-scroll-hint');
  if(compareWrap&&scrollHint){
    var checkOverflow=function(){scrollHint.style.display=compareWrap.scrollWidth>compareWrap.clientWidth?'block':'none'};
    checkOverflow();
    window.addEventListener('resize',checkOverflow);
  }
})();
</script>

