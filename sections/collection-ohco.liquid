<style>
  /* ============================================
     OHCO COLLECTION — PREMIUM EDITORIAL LANDING
     Massage Chairs and More Design System
     All units in PX for Shopify compatibility
     ============================================ */

  :root {
    --ohco-bg: #ffffff;
    --ohco-surface: #f9f8f6;
    --ohco-surface-alt: #f3f1ed;
    --ohco-surface-warm: #faf7f2;
    --ohco-dark: #1a1a1a;
    --ohco-dark2: #111111;
    --ohco-text: #2d2d2d;
    --ohco-muted: #5a5a5a;
    --ohco-light-text: #8a8a8a;
    --ohco-accent: #b8944f;
    --ohco-accent-hover: #a07e3f;
    --ohco-accent-light: rgba(184, 148, 79, 0.08);
    --ohco-accent-glow: rgba(184, 148, 79, 0.15);
    --ohco-accent-warm: #c9a45a;
    --ohco-border: #e8e4de;
    --ohco-border-light: #f0ece6;
    --ohco-white: #ffffff;
    --ohco-hero-overlay: rgba(15, 12, 8, 0.62);
    --ohco-card-shadow: 0 4px 20px rgba(0,0,0,0.04);
    --ohco-card-shadow-hover: 0 20px 50px rgba(0,0,0,0.10);
    --ohco-shadow-gold: 0 8px 32px rgba(184,148,79,0.22);
    --ohco-radius: 16px;
    --ohco-radius-sm: 10px;
    --ohco-radius-lg: 24px;
    --ohco-radius-xl: 32px;
    --ohco-transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .ohco-wrap *,.ohco-wrap *::before,.ohco-wrap *::after{box-sizing:border-box;margin:0;padding:0}
  .ohco-wrap{font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;background:var(--ohco-bg);color:var(--ohco-text);line-height:1.75;font-size:16px !important;font-weight:400;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;overflow-x:hidden}
  .ohco-wrap h1,.ohco-wrap h2,.ohco-wrap h3,.ohco-wrap h4,.ohco-wrap h5{color:var(--ohco-dark);line-height:1.2;font-weight:700}
  .ohco-wrap h1,.ohco-wrap h2{font-family:'Playfair Display',Georgia,serif}
  .ohco-wrap a{color:inherit;text-decoration:none}
  .ohco-wrap img{max-width:100%;display:block}
  .ohco-wrap p{font-size:15px;color:var(--ohco-muted);line-height:1.8}
  .ohco-wrap h2{font-size:38px !important}
  .ohco-wrap h3{font-size:20px !important}

  .ohco-container{max-width:1320px;margin:0 auto;padding:0 2rem}
  .ohco-container-narrow{max-width:900px;margin:0 auto;padding:0 2rem}

  /* ---- ANIMATIONS ---- */
  @keyframes ohcoFadeUp{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:translateY(0)}}
  @keyframes ohcoShimmer{0%,100%{opacity:0.5}50%{opacity:1}}
  @keyframes ohcoPulseDot{0%,100%{transform:scale(1);opacity:1}50%{transform:scale(1.5);opacity:0.6}}
  @keyframes ohcoGradientShift{0%{background-position:0% 50%}50%{background-position:100% 50%}100%{background-position:0% 50%}}

  .ohco-fade-up{animation:ohcoFadeUp 0.7s ease both}
  .ohco-fade-up-1{animation-delay:0.1s}
  .ohco-fade-up-2{animation-delay:0.2s}
  .ohco-fade-up-3{animation-delay:0.3s}
  .ohco-fade-up-4{animation-delay:0.4s}

  /* ---- STICKY SUBNAV ---- */
  .ohco-subnav{background:rgba(255,255,255,0.97);backdrop-filter:blur(12px);border-bottom:1px solid var(--ohco-border-light);overflow-x:auto;scrollbar-width:none}
  .ohco-subnav::-webkit-scrollbar{display:none}
  .ohco-subnav-inner{display:flex;padding:0 2rem;min-width:max-content}
  .ohco-subnav-inner a{display:block;padding:12px 17px;font-size:12px;font-weight:700;color:var(--ohco-muted);border-bottom:2.5px solid transparent;white-space:nowrap;transition:var(--ohco-transition);text-transform:uppercase;letter-spacing:0.07em;text-decoration:none}
  .ohco-subnav-inner a:hover,.ohco-subnav-inner a.active{color:var(--ohco-dark);border-bottom-color:var(--ohco-accent)}

  /* ---- BUTTONS ---- */
  .ohco-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:16px 40px;font-size:15px;font-weight:700;border-radius:50px;text-decoration:none;transition:var(--ohco-transition);border:2px solid transparent;cursor:pointer;letter-spacing:0.02em;font-family:'Inter',sans-serif}
  .ohco-btn-primary{background:var(--ohco-dark);color:#fff !important;border-color:var(--ohco-dark)}
  .ohco-btn-primary:hover{background:var(--ohco-accent);border-color:var(--ohco-accent);transform:translateY(-2px);box-shadow:var(--ohco-shadow-gold);color:#fff !important}
  .ohco-btn-accent{background:var(--ohco-accent);color:#fff !important;border-color:var(--ohco-accent)}
  .ohco-btn-accent:hover{background:var(--ohco-accent-hover);border-color:var(--ohco-accent-hover);transform:translateY(-2px);box-shadow:var(--ohco-shadow-gold);color:#fff !important}
  .ohco-btn-outline{background:transparent;color:var(--ohco-dark) !important;border:2px solid var(--ohco-border)}
  .ohco-btn-outline:hover{border-color:var(--ohco-accent);color:var(--ohco-accent) !important;transform:translateY(-1px)}
  .ohco-btn-white-outline{background:transparent;color:#fff !important;border:2px solid rgba(255,255,255,0.45)}
  .ohco-btn-white-outline:hover{border-color:#fff;background:rgba(255,255,255,0.10);transform:translateY(-1px);color:#fff !important}
  .ohco-btn-ghost-dark{background:rgba(255,255,255,0.08);color:#fff !important;border:1.5px solid rgba(255,255,255,0.28)}
  .ohco-btn-ghost-dark:hover{background:rgba(255,255,255,0.15);border-color:rgba(255,255,255,0.45);color:#fff !important}
  .ohco-btn-sm{padding:11px 26px;font-size:14px}

  /* ---- SECTION GENERAL ---- */
  .ohco-section{padding:96px 0}
  .ohco-section-alt{background:var(--ohco-surface)}
  .ohco-section-dark{background:var(--ohco-dark)}
  .ohco-section-warm{background:var(--ohco-surface-warm)}
  .ohco-section-header{text-align:center;margin-bottom:64px}
  .ohco-section-header .ohco-eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:12px;letter-spacing:0.2em;text-transform:uppercase;color:var(--ohco-accent);margin-bottom:16px;font-weight:700;font-family:'Inter',sans-serif}
  .ohco-section-header .ohco-eyebrow::before{content:'';width:20px;height:2px;background:linear-gradient(90deg,var(--ohco-accent),var(--ohco-accent-warm));border-radius:2px}
  .ohco-section-header h2{font-size:44px !important;margin-bottom:16px;letter-spacing:-0.02em}
  .ohco-section-header p{font-size:18px;color:var(--ohco-muted);max-width:700px;margin:0 auto;line-height:1.8}
  .ohco-section-header.ohco-left-align{text-align:left}
  .ohco-section-header.ohco-left-align p{margin:0}

  /* Accent underline heading */
  .ohco-accent-heading::after{content:'';display:block;width:48px;height:3px;margin-top:12px;background:linear-gradient(90deg,var(--ohco-accent),var(--ohco-accent-warm));border-radius:4px}
  .ohco-section-header .ohco-accent-heading::after{margin-left:auto;margin-right:auto}
  .ohco-section-header.ohco-left-align .ohco-accent-heading::after{margin-left:0}

  /* ---- HERO ---- */
  .ohco-hero{position:relative;min-height:92vh;display:flex;align-items:center;background:var(--ohco-dark);overflow:hidden}
  .ohco-hero-bg{position:absolute;inset:0;background-size:cover;background-position:center;opacity:0.4;z-index:0;transition:opacity 0.5s}
  .ohco-hero-overlay{position:absolute;inset:0;background:linear-gradient(110deg,rgba(5,5,12,0.92) 25%,rgba(15,10,5,0.65) 60%,rgba(184,148,79,0.06) 100%);z-index:1}
  .ohco-hero-glow{position:absolute;width:600px;height:600px;border-radius:50%;background:radial-gradient(circle,rgba(184,148,79,0.12) 0%,transparent 70%);right:-100px;top:-100px;z-index:1;animation:ohcoShimmer 5s ease-in-out infinite}
  .ohco-hero-content{position:relative;z-index:2;padding:80px 0 96px}
  .ohco-hero-eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:12px;letter-spacing:0.2em;text-transform:uppercase;color:var(--ohco-accent-warm);font-weight:700;margin-bottom:24px;background:rgba(184,148,79,0.1);padding:6px 16px;border-radius:50px;border:1px solid rgba(184,148,79,0.18)}
  .ohco-hero-eyebrow::before{content:'●';font-size:7px;animation:ohcoPulseDot 2.5s infinite}
  .ohco-hero h1{font-size:67px !important;color:var(--ohco-white);max-width:800px;margin-bottom:24px;font-weight:700;line-height:1.08;letter-spacing:-0.02em;text-shadow:0 4px 30px rgba(0,0,0,0.3)}
  .ohco-hero-tag{display:inline-block;background:linear-gradient(135deg,var(--ohco-accent),var(--ohco-accent-warm));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
  .ohco-hero-sub{font-size:20px !important;color:rgba(255,255,255,0.78);max-width:640px;margin-bottom:12px;font-weight:400;line-height:1.7}
  .ohco-hero-note{font-size:15px;color:rgba(255,255,255,0.45);max-width:580px;margin-bottom:40px;line-height:1.7}
  .ohco-hero-ctas{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:56px}
  .ohco-hero-stats{display:flex;gap:0;padding-top:40px;border-top:1px solid rgba(255,255,255,0.08);flex-wrap:wrap}
  .ohco-hero-stat{padding-right:40px;margin-right:40px;border-right:1px solid rgba(255,255,255,0.08)}
  .ohco-hero-stat:last-child{border-right:none;margin-right:0}
  .ohco-hero-stat-num{font-size:32px;font-weight:900;color:#fff;display:block;line-height:1;margin-bottom:5px;background:linear-gradient(135deg,#fff,rgba(255,255,255,0.7));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;font-family:'Inter',sans-serif}
  .ohco-hero-stat-label{font-size:12px;color:rgba(255,255,255,0.4);text-transform:uppercase;letter-spacing:0.12em;font-weight:600}

  /* ---- TRUST BAR ---- */
  .ohco-trust-bar{background:var(--ohco-surface);border-bottom:1px solid var(--ohco-border-light);padding:48px 0}
  .ohco-trust-bar-inner{display:flex;justify-content:center;align-items:center;gap:0;flex-wrap:wrap}
  .ohco-trust-item{display:flex;align-items:center;gap:14px;padding:8px 32px;transition:var(--ohco-transition)}
  .ohco-trust-item:hover{transform:translateY(-3px)}
  .ohco-trust-icon{width:50px;height:50px;background:var(--ohco-accent-light);border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:var(--ohco-transition)}
  .ohco-trust-item:hover .ohco-trust-icon{background:var(--ohco-accent)}
  .ohco-trust-item:hover .ohco-trust-icon svg{fill:var(--ohco-white)}
  .ohco-trust-icon svg{width:24px;height:24px;fill:var(--ohco-accent);transition:fill 0.3s ease}
  .ohco-trust-text{display:flex;flex-direction:column}
  .ohco-trust-text strong{font-size:15px;font-weight:700;color:var(--ohco-dark);line-height:1.3}
  .ohco-trust-text span{font-size:12px;color:var(--ohco-light-text);font-weight:400;line-height:1.4}
  .ohco-trust-divider{width:1px;height:44px;background:var(--ohco-border);flex-shrink:0}

  /* ---- EDITORIAL INTRO ---- */
  .ohco-intro-lead{font-size:21px;color:var(--ohco-text);line-height:1.8;margin-bottom:48px;max-width:800px;font-weight:400}
  .ohco-intro-lead strong{color:var(--ohco-dark);font-weight:700}
  .ohco-intro-lead em{font-style:italic;color:var(--ohco-accent)}
  .ohco-intro-pillars{display:grid;grid-template-columns:repeat(3,1fr);gap:40px;text-align:left}
  .ohco-intro-pillar{padding:32px 28px;border-left:3px solid var(--ohco-accent);background:linear-gradient(135deg,var(--ohco-accent-light),transparent);border-radius:0 var(--ohco-radius-sm) var(--ohco-radius-sm) 0}
  .ohco-intro-pillar h3{font-size:16px !important;font-family:'Inter',sans-serif;font-weight:700;margin-bottom:8px}
  .ohco-intro-pillar p{font-size:15px;color:var(--ohco-muted);line-height:1.7;margin:0}

  /* ---- QUICK ANSWER BOX ---- */
  .ohco-quick-answer{background:linear-gradient(145deg,#09090f 0%,#1c1408 100%);border-radius:var(--ohco-radius-xl);padding:56px;border:1px solid rgba(184,148,79,0.15);position:relative;overflow:hidden}
  .ohco-quick-answer::before{content:'';position:absolute;width:400px;height:400px;border-radius:50%;background:radial-gradient(circle,rgba(184,148,79,0.08) 0%,transparent 70%);right:-100px;bottom:-100px;pointer-events:none}
  .ohco-quick-answer h2{color:#fff;margin-bottom:8px;font-size:34px !important}
  .ohco-qa-intro{color:rgba(255,255,255,0.55);font-size:16px;max-width:600px;margin-bottom:40px;line-height:1.75}
  .ohco-qa-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:24px}
  .ohco-qa-item{background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.07);border-radius:var(--ohco-radius);padding:28px;transition:var(--ohco-transition)}
  .ohco-qa-item:hover{background:rgba(184,148,79,0.06);border-color:rgba(184,148,79,0.18);transform:translateY(-2px)}
  .ohco-qa-item h3{color:var(--ohco-accent-warm);font-size:13px;text-transform:uppercase;letter-spacing:0.14em;margin-bottom:12px;font-weight:800;font-family:'Inter',sans-serif}
  .ohco-qa-item p{font-size:15px;color:rgba(255,255,255,0.68);line-height:1.8;margin:0}

  /* ---- PILLAR CARDS ---- */
  .ohco-pillar-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px}
  .ohco-pillar-card{background:var(--ohco-white);border:1px solid var(--ohco-border);border-radius:var(--ohco-radius-lg);padding:36px;transition:var(--ohco-transition);position:relative;overflow:hidden}
  .ohco-pillar-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--ohco-accent),var(--ohco-accent-warm));transform:scaleX(0);transform-origin:left;transition:transform 0.3s}
  .ohco-pillar-card:hover::before{transform:scaleX(1)}
  .ohco-pillar-card:hover{transform:translateY(-6px);box-shadow:var(--ohco-card-shadow-hover);border-color:transparent}
  .ohco-pillar-icon{width:54px;height:54px;background:var(--ohco-accent-light);border-radius:16px;display:flex;align-items:center;justify-content:center;margin-bottom:20px;transition:var(--ohco-transition)}
  .ohco-pillar-card:hover .ohco-pillar-icon{background:linear-gradient(135deg,var(--ohco-accent),var(--ohco-accent-warm))}
  .ohco-pillar-icon svg{width:26px;height:26px;fill:var(--ohco-accent);transition:fill 0.3s}
  .ohco-pillar-card:hover .ohco-pillar-icon svg{fill:#fff}
  .ohco-pillar-card h3{font-size:16px;margin-bottom:10px;font-family:'Inter',sans-serif}
  .ohco-pillar-card p{font-size:14px;color:var(--ohco-muted);margin:0;line-height:1.75}

  /* ---- MODEL SPOTLIGHT ---- */
  .ohco-model-spotlight{border-radius:var(--ohco-radius-xl);overflow:hidden;border:1px solid var(--ohco-border);background:var(--ohco-white);margin-bottom:48px;transition:box-shadow 0.35s;box-shadow:var(--ohco-card-shadow)}
  .ohco-model-spotlight:hover{box-shadow:var(--ohco-card-shadow-hover)}
  .ohco-model-spotlight-header{background:linear-gradient(160deg,#09090f 0%,#1c1408 100%);padding:48px 56px;position:relative;overflow:hidden}
  .ohco-model-spotlight-header::after{content:'';position:absolute;width:300px;height:300px;border-radius:50%;background:radial-gradient(circle,rgba(184,148,79,0.08) 0%,transparent 70%);right:-80px;top:-80px;pointer-events:none}
  .ohco-model-tier-label{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:0.18em;color:var(--ohco-accent-warm);margin-bottom:8px;display:inline-flex;align-items:center;gap:8px}
  .ohco-model-tier-label::before{content:'';width:16px;height:2px;background:var(--ohco-accent);border-radius:2px}
  .ohco-model-spotlight-header h2{color:#fff;font-size:38px !important;margin-bottom:12px;letter-spacing:-0.02em}
  .ohco-model-spotlight-header .ohco-model-tagline{color:rgba(255,255,255,0.55);font-size:16px !important;max-width:600px;line-height:1.7;margin:0}

  .ohco-model-spotlight-body{display:grid;grid-template-columns:380px 1fr;gap:0}
  .ohco-model-sidebar{background:var(--ohco-surface);padding:40px;display:flex;flex-direction:column;border-right:1px solid var(--ohco-border-light)}
  .ohco-model-sidebar-imgbox{background:var(--ohco-white);border-radius:var(--ohco-radius);padding:32px 24px;margin-bottom:24px;overflow:hidden;display:flex;align-items:center;justify-content:center;min-height:260px;border:1px solid var(--ohco-border-light);text-decoration:none;cursor:pointer}
  .ohco-model-sidebar-imgbox img{width:100%;height:100%;object-fit:contain;max-height:280px;mix-blend-mode:multiply;transition:transform 0.4s ease}
  .ohco-model-spotlight:hover .ohco-model-sidebar-imgbox img{transform:scale(1.05)}
  .ohco-model-sidebar-cta{display:block;text-align:center;background:var(--ohco-dark);color:#fff !important;padding:14px;border-radius:var(--ohco-radius-sm);font-size:14px;font-weight:700;transition:var(--ohco-transition);letter-spacing:0.02em;margin-bottom:12px;text-decoration:none}
  .ohco-model-sidebar-cta:hover{background:var(--ohco-accent);transform:translateY(-2px);box-shadow:var(--ohco-shadow-gold);color:#fff !important}
  .ohco-model-sidebar-link{display:block;text-align:center;color:var(--ohco-muted);font-size:13px;font-weight:600;transition:color 0.2s;text-decoration:none}
  .ohco-model-sidebar-link:hover{color:var(--ohco-accent)}

  .ohco-model-content{padding:40px 48px}
  .ohco-model-best-for{display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:0.12em;color:var(--ohco-accent);background:var(--ohco-accent-light);padding:5px 14px;border-radius:50px;margin-bottom:20px;border:1px solid rgba(184,148,79,0.18)}
  .ohco-model-content h3{font-size:18px;margin-bottom:12px;font-family:'Inter',sans-serif}
  .ohco-model-content p{font-size:15px;color:var(--ohco-muted);line-height:1.85;margin-bottom:16px}
  .ohco-model-traits{display:flex;gap:8px;flex-wrap:wrap;margin-top:20px}
  .ohco-trait-pill{font-size:12px;font-weight:700;padding:5px 12px;border-radius:20px;background:var(--ohco-surface);border:1px solid var(--ohco-border);color:var(--ohco-muted);transition:var(--ohco-transition)}
  .ohco-trait-pill:hover{background:var(--ohco-accent-light);border-color:var(--ohco-accent);color:var(--ohco-accent)}

  /* ---- TECHNOLOGY SHOWCASE BANNER ---- */
  .ohco-tech-showcase-banner{position:relative;overflow:hidden;background:#0a0a0a}
  .ohco-tech-showcase-inner{display:grid;grid-template-columns:1fr 1fr;min-height:560px}
  .ohco-tech-showcase-img-wrap{position:relative;overflow:hidden}
  .ohco-tech-showcase-img-wrap img{width:100%;height:100%;object-fit:cover;display:block;filter:brightness(0.95);transition:transform 0.6s ease}
  .ohco-tech-showcase-banner:hover .ohco-tech-showcase-img-wrap img{transform:scale(1.03)}
  .ohco-tech-showcase-overlay{display:flex;align-items:center;padding:56px 64px;position:relative}
  .ohco-tech-showcase-overlay::before{content:'';position:absolute;width:350px;height:350px;border-radius:50%;background:radial-gradient(circle,rgba(184,148,79,0.08) 0%,transparent 70%);right:-80px;bottom:-80px;pointer-events:none}
  .ohco-tech-showcase-content{position:relative;z-index:2}
  .ohco-tech-showcase-content .ohco-eyebrow::before{background:linear-gradient(90deg,var(--ohco-accent-warm),var(--ohco-accent))}
  .ohco-tech-showcase-content h2{font-size:35px !important;color:#fff;margin-bottom:16px;line-height:1.2;letter-spacing:-0.02em}
  .ohco-tech-showcase-content p{font-size:16px;color:rgba(255,255,255,0.65);line-height:1.8;max-width:480px;margin-bottom:24px}
  .ohco-tech-showcase-pills{display:flex;flex-wrap:wrap;gap:8px}

  /* ---- COMPARISON TABLE ---- */
  .ohco-compare-wrap{overflow-x:auto;border-radius:var(--ohco-radius-lg);border:1px solid var(--ohco-border);box-shadow:var(--ohco-card-shadow)}
  .ohco-compare-table{width:100%;border-collapse:collapse;font-size:14px;min-width:700px}
  .ohco-compare-table th{background:var(--ohco-dark);color:#fff;padding:16px 20px;text-align:left;font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:0.07em}
  .ohco-compare-table th:first-child{background:#111}
  .ohco-compare-table td{padding:14px 20px;border-bottom:1px solid var(--ohco-border);color:var(--ohco-muted);vertical-align:middle}
  .ohco-compare-table tr:last-child td{border-bottom:none}
  .ohco-compare-table tr:hover td{background:var(--ohco-surface)}
  .ohco-compare-table .ohco-col-feat{font-weight:700;color:var(--ohco-dark);white-space:nowrap}
  .ohco-check{color:var(--ohco-accent);font-weight:800}
  .ohco-cross{color:#d4d4d8}

  /* ---- BUYER GUIDE CARDS ---- */
  .ohco-buyer-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px}
  .ohco-buyer-card{background:var(--ohco-white);border:1px solid var(--ohco-border);border-radius:var(--ohco-radius-lg);padding:36px;transition:var(--ohco-transition);position:relative;overflow:hidden}
  .ohco-buyer-card::after{content:'';position:absolute;bottom:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--ohco-accent),var(--ohco-accent-warm));transform:scaleX(0);transform-origin:left;transition:transform 0.3s}
  .ohco-buyer-card:hover::after{transform:scaleX(1)}
  .ohco-buyer-card:hover{border-color:rgba(184,148,79,0.25);box-shadow:var(--ohco-card-shadow-hover);transform:translateY(-4px)}
  .ohco-buyer-icon{width:50px;height:50px;background:var(--ohco-accent-light);border-radius:14px;display:flex;align-items:center;justify-content:center;margin-bottom:20px;transition:var(--ohco-transition)}
  .ohco-buyer-card:hover .ohco-buyer-icon{background:var(--ohco-accent)}
  .ohco-buyer-icon svg{width:24px;height:24px;fill:var(--ohco-accent);transition:fill 0.3s}
  .ohco-buyer-card:hover .ohco-buyer-icon svg{fill:#fff}
  .ohco-buyer-card h3{font-size:16px;margin-bottom:8px;font-family:'Inter',sans-serif}
  .ohco-buyer-card p{font-size:14px;color:var(--ohco-muted);margin:0;line-height:1.75}
  .ohco-buyer-rec{display:flex;align-items:center;gap:6px;margin-top:16px;font-size:12px;font-weight:800;color:var(--ohco-accent)}
  .ohco-buyer-rec::before{content:'→'}

  /* ---- WHY BUY HERE (TRUST GRID) ---- */
  .ohco-trust-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:32px}
  .ohco-trust-card{background:var(--ohco-white);border:1px solid var(--ohco-border);border-radius:var(--ohco-radius-lg);padding:32px;transition:var(--ohco-transition)}
  .ohco-trust-card:hover{transform:translateY(-5px);box-shadow:var(--ohco-card-shadow-hover);border-color:rgba(184,148,79,0.2)}
  .ohco-trust-card-icon{width:50px;height:50px;background:var(--ohco-accent-light);border-radius:15px;display:flex;align-items:center;justify-content:center;margin-bottom:20px;transition:var(--ohco-transition)}
  .ohco-trust-card:hover .ohco-trust-card-icon{background:linear-gradient(135deg,var(--ohco-accent),var(--ohco-accent-warm))}
  .ohco-trust-card-icon svg{width:24px;height:24px;fill:var(--ohco-accent);transition:fill 0.3s}
  .ohco-trust-card:hover .ohco-trust-card-icon svg{fill:#fff}
  .ohco-trust-card h3{font-size:16px;margin-bottom:10px;font-family:'Inter',sans-serif}
  .ohco-trust-card p{font-size:14px;color:var(--ohco-muted);margin:0;line-height:1.75}

  /* ---- FAQ ---- */
  .ohco-faq-list{border-top:1px solid var(--ohco-border)}
  .ohco-faq-item{border-bottom:1px solid var(--ohco-border)}
  .ohco-faq-q{display:flex;justify-content:space-between;align-items:center;padding:24px 0;cursor:pointer;gap:16px;user-select:none}
  .ohco-faq-q h3{font-size:16px !important;font-family:'Inter',sans-serif;font-weight:700;margin:0;flex:1;line-height:1.4;transition:color 0.2s}
  .ohco-faq-q:hover h3{color:var(--ohco-accent)}
  .ohco-faq-toggle{width:36px;height:36px;border-radius:50%;background:var(--ohco-surface);display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:300;color:var(--ohco-accent);flex-shrink:0;transition:var(--ohco-transition);font-family:'Inter',sans-serif}
  .ohco-faq-item.open .ohco-faq-toggle{background:var(--ohco-accent);color:var(--ohco-white);transform:rotate(45deg)}
  .ohco-faq-a{max-height:0;overflow:hidden;transition:max-height 0.35s cubic-bezier(0.4,0,0.2,1)}
  .ohco-faq-a-inner{padding:0 0 28px}
  .ohco-faq-a-inner p{font-size:16px;color:var(--ohco-muted);line-height:1.85;margin:0}

  /* ---- FINAL CTA ---- */
  .ohco-final-cta{background:linear-gradient(160deg,#09090f 0%,#1c1408 100%);border-radius:var(--ohco-radius-xl);padding:80px 64px;color:var(--ohco-white);position:relative;overflow:hidden;text-align:center}
  .ohco-final-cta::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--ohco-accent),var(--ohco-accent-warm),var(--ohco-accent));background-size:200% 100%;animation:ohcoGradientShift 4s ease infinite}
  .ohco-final-cta::after{content:'';position:absolute;width:500px;height:500px;background:radial-gradient(circle,rgba(184,148,79,0.08) 0%,transparent 70%);bottom:-200px;right:-100px;pointer-events:none}
  .ohco-final-cta .ohco-eyebrow{color:var(--ohco-accent-warm)}
  .ohco-final-cta h2{color:var(--ohco-white);font-size:40px !important;margin-bottom:16px;line-height:1.15}
  .ohco-final-cta p{color:rgba(255,255,255,0.65);font-size:16px !important;max-width:680px;margin:0 auto 40px;line-height:1.8}
  .ohco-final-cta-btns{display:flex;flex-wrap:wrap;gap:16px;justify-content:center}

  /* ---- SUPPORT BAR ---- */
  .ohco-support-bar{background:var(--ohco-white);padding:64px 0;border-top:1px solid var(--ohco-border-light);border-bottom:1px solid var(--ohco-border-light)}
  .ohco-support-bar-inner{display:flex;justify-content:center;align-items:center;gap:0;flex-wrap:wrap}
  .ohco-support-item{display:flex;align-items:center;gap:16px;padding:8px 40px;transition:var(--ohco-transition)}
  .ohco-support-item:hover{transform:translateY(-3px)}
  .ohco-support-icon{width:52px;height:52px;background:var(--ohco-accent-light);border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:var(--ohco-transition)}
  .ohco-support-item:hover .ohco-support-icon{background:var(--ohco-accent)}
  .ohco-support-item:hover .ohco-support-icon svg{fill:var(--ohco-white)}
  .ohco-support-icon svg{width:24px;height:24px;fill:var(--ohco-accent);transition:fill 0.3s ease}
  .ohco-support-text{display:flex;flex-direction:column}
  .ohco-support-text strong{font-size:15px;font-weight:700;color:var(--ohco-dark);line-height:1.3}
  .ohco-support-text span{font-size:13px;color:var(--ohco-light-text);font-weight:400;line-height:1.4}
  .ohco-support-divider{width:1px;height:48px;background:var(--ohco-border);flex-shrink:0}
  .ohco-grad-divider{height:1px;background:linear-gradient(90deg,transparent,var(--ohco-border),transparent);margin:0}

  /* ---- PRODUCT CARDS (hero-immediately-after) ---- */
  .ohco-cards-section{padding:72px 0;background:var(--ohco-bg)}
  .ohco-cards-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px}
  .ohco-pcard{background:var(--ohco-white);border:1px solid var(--ohco-border);border-radius:var(--ohco-radius-lg);overflow:hidden;transition:var(--ohco-transition);position:relative;display:flex;flex-direction:column}
  .ohco-pcard:hover{transform:translateY(-6px);box-shadow:var(--ohco-card-shadow-hover);border-color:transparent}
  .ohco-pcard-badge{position:absolute;top:14px;left:14px;font-size:10px;font-weight:800;letter-spacing:0.12em;text-transform:uppercase;padding:4px 12px;border-radius:20px;z-index:2;background:var(--ohco-dark);color:#fff !important}
  .ohco-pcard-badge.flagship{background:linear-gradient(135deg,var(--ohco-accent),#c8892a)}
  .ohco-pcard-img{height:280px;background:var(--ohco-surface);overflow:hidden;display:block;text-decoration:none;position:relative}
  .ohco-pcard-img img{width:100%;height:100%;object-fit:contain;mix-blend-mode:multiply;transition:transform 0.42s ease;transform:scale(1.25);transform-origin:center bottom}
  .ohco-pcard:hover .ohco-pcard-img img{transform:scale(1.38)}
  .ohco-pcard-body{padding:22px 24px;flex:1;display:flex;flex-direction:column}
  .ohco-pcard-line{font-size:10px;text-transform:uppercase;letter-spacing:0.18em;color:var(--ohco-accent);font-weight:800;margin-bottom:5px}
  .ohco-pcard-name{font-size:18px;font-weight:800;color:var(--ohco-dark);font-family:'Inter',sans-serif;margin-bottom:4px}
  .ohco-pcard-sub{font-size:12px;color:var(--ohco-muted);line-height:1.5;margin-bottom:14px;flex:1}
  .ohco-pcard-price{font-size:22px;font-weight:900;color:var(--ohco-dark);font-family:'Inter',sans-serif;margin-bottom:14px}
  .ohco-pcard-cta{display:block;text-align:center;background:var(--ohco-dark);color:#fff !important;padding:13px;border-radius:var(--ohco-radius-sm);font-size:14px;font-weight:700;transition:var(--ohco-transition);text-decoration:none}
  .ohco-pcard-cta:hover{background:var(--ohco-accent);transform:translateY(-2px);box-shadow:var(--ohco-shadow-gold);color:#fff !important}
  @media(max-width:900px){.ohco-cards-grid{grid-template-columns:1fr 1fr}}
  @media(max-width:600px){.ohco-cards-grid{grid-template-columns:1fr}}

  /* ---- RESPONSIVE ---- */
  @media(max-width:1100px){
    .ohco-pillar-grid{grid-template-columns:repeat(2,1fr)}
    .ohco-buyer-grid{grid-template-columns:repeat(2,1fr)}
    .ohco-model-spotlight-body{grid-template-columns:1fr}
    .ohco-model-sidebar{border-right:none;border-bottom:1px solid var(--ohco-border-light)}
  }
  @media(max-width:900px){
    .ohco-qa-grid{grid-template-columns:1fr}
    .ohco-pillar-grid{grid-template-columns:1fr}
    .ohco-trust-grid{grid-template-columns:1fr}
    .ohco-buyer-grid{grid-template-columns:1fr}
    .ohco-intro-pillars{grid-template-columns:1fr;gap:24px}
    .ohco-hero-stats{gap:24px}
    .ohco-hero-stat{padding-right:24px;margin-right:24px}
    .ohco-tech-showcase-inner{grid-template-columns:1fr}
    .ohco-tech-showcase-img-wrap img{height:340px}
    .ohco-tech-showcase-overlay{padding:40px 32px}
  }
  @media(max-width:768px){
    .ohco-hero{min-height:75vh}
    .ohco-hero-content{padding:48px 0 64px}
    .ohco-hero h1{font-size:36px}
    .ohco-hero-sub{font-size:16px}
    .ohco-section{padding:64px 0}
    .ohco-section-header{margin-bottom:40px}
    .ohco-section-header h2{font-size:28px}
    .ohco-model-spotlight-header{padding:32px 28px}
    .ohco-model-content{padding:32px 28px}
    .ohco-model-sidebar{padding:32px 28px}
    .ohco-quick-answer{padding:32px}
    .ohco-final-cta{padding:48px 32px}
    .ohco-support-bar-inner{flex-direction:column;gap:24px;align-items:flex-start;padding:0 16px}
    .ohco-support-divider{width:100%;height:1px}
    .ohco-support-item{padding:0}
    .ohco-container{padding:0 20px}
    .ohco-intro-lead{font-size:18px}
  }
  @media(max-width:480px){
    .ohco-hero-ctas{flex-direction:column}
    .ohco-final-cta-btns{flex-direction:column;align-items:center}
    .ohco-btn{padding:14px 32px;font-size:14px}
    .ohco-hero-stat-num{font-size:24px}
  }
</style>

