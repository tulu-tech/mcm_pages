.plstn { font-family: 'Inter', -apple-system, sans-serif; color: #111; line-height: 1.7; overflow-x: hidden; }
.plstn *, .plstn *::before, .plstn *::after { box-sizing: border-box; margin: 0; padding: 0; }
.plstn a { text-decoration: none; }
.plstn img { display: block; max-width: 100%; }

/* === TOKENS === */
.plstn {
  --c-gold:       #9a7f4a;
