}
.plstn__reason:hover { border-color: var(--c-gold); box-shadow: 0 4px 20px rgba(154,127,74,0.12); }
.plstn__reason-ico { width: 40px; height: 40px; background: var(--c-gold-pale); border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.plstn__reason-ico svg { width: 18px; height: 18px; fill: var(--c-gold); }
.plstn__reason strong { display: block; font-size: 15px; color: var(--c-ink); margin-bottom: 2px; }
.plstn__reason span { font-size: 13px; color: var(--c-muted); line-height: 1.6; }

/* === BRANDS === */
.plstn__brands-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
.plstn__brand {
  background: #fff; border: 1px solid var(--c-border); border-radius: var(--r-lg);
