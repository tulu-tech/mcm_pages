  display: flex; align-items: center; gap: 0.875rem;
  border: 1px solid rgba(255,255,255,0.08);
}
.plstn__why-badge-ico { width: 38px; height: 38px; background: var(--c-gold); border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
