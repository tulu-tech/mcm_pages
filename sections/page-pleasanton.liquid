<script>
(function(){
  'use strict';

  /* FAQ accordion */
  document.querySelectorAll('.plstn__faq-q').forEach(function(q){
    q.addEventListener('click', function(){
      var item = q.closest('.plstn__faq-item');
      var open = item.classList.contains('is-open');
      document.querySelectorAll('.plstn__faq-item').forEach(function(i){
        i.classList.remove('is-open');
        var b = i.querySelector('.plstn__faq-body');
        if(b) b.style.maxHeight = '0';
      });
      if(!open){
        item.classList.add('is-open');
        var body = item.querySelector('.plstn__faq-body');
        if(body) body.style.maxHeight = body.scrollHeight + 'px';
      }
    });
  });

  /* Sticky CTAs — appear after hero passes out of view */
  var sticky = document.getElementById('plstn-sticky');
  var hero   = document.getElementById('plstn-hero');
  if(sticky && hero && 'IntersectionObserver' in window){
    var obs = new IntersectionObserver(function(entries){
      sticky.classList.toggle('is-hidden', entries[0].isIntersecting);
    }, { threshold: 0.15 });
    obs.observe(hero);
  }

})();
</script>

