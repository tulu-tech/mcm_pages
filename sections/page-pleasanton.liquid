.plstn__brand-name { font-size: 22px; font-weight: 900; color: var(--c-ink); letter-spacing: -0.02em; text-transform: uppercase; }
.plstn__brand-tag { font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.12em; color: var(--c-gold); background: var(--c-gold-pale); padding: 4px 11px; border-radius: 20px; white-space: nowrap; flex-shrink: 0; }
