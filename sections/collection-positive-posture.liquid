      <a href="#pp-why">Why PP</a>
      <a href="#pp-faq">FAQ</a>
    </div>
  </nav>

  {%- comment -%} HERO {%- endcomment -%}
  <section class="pp-hero" id="pp-top">
    <div class="pp-hero-bg" style="background-image:url('https://cdn.shopify.com/s/files/1/0813/4036/7096/files/pp-hero-bg.jpg?v=1776440130')"></div>
    <div class="pp-hero-grain"></div>
