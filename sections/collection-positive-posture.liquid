<script>
/* DYNAMIC PRICES from Shopify API */
function ppFormatPrice(cents) {
  return '$' + (cents / 100).toLocaleString('en-US', {minimumFractionDigits:0,maximumFractionDigits:0});
}

function ppFetchProduct(handle) {
  return fetch('/products/' + handle + '.js')
    .then(function(r) { return r.ok ? r.json() : Promise.reject(); })
    .catch(function() { return null; });
}

document.addEventListener('DOMContentLoaded', function() {
  var handles = [
    'positive-posture-massage-chair-dualtech-pro-ai-4d',
    'positive-posture-massage-chair-dualtech-4d',
    'positive-posture-brio-sport-massage-chair',
    'positive-posture-massage-chair-brio-plus',
    'positive-posture-massage-chair-solara'
  ];

  handles.forEach(function(handle) {
    ppFetchProduct(handle).then(function(data) {
      if (!data) return;
      var price = data.price ? ppFormatPrice(data.price) : null;

      // Update all price elements for this handle
      document.querySelectorAll('.pp-dyn-price[data-handle="' + handle + '"]').forEach(function(el) {
        if (price) {
          el.textContent = price;
          el.classList.remove('loading');
        }
      });

      // Update images
      if (data.featured_image) {
        document.querySelectorAll('.pp-dyn-img[data-handle="' + handle + '"]').forEach(function(img) {
          img.src = 'https:' + data.featured_image;
          if (data.title) img.alt = data.title;
        });
      }
    });
  });
});

/* FAQ ACCORDION */
function ppToggleFaq(el) {
  var item = el.closest('.pp-faq-item');
  var answer = item.querySelector('.pp-faq-a');
  var isOpen = item.classList.contains('open');
  document.querySelectorAll('.pp-faq-item.open').forEach(function(o) {
    o.classList.remove('open');
    o.querySelector('.pp-faq-a').style.maxHeight = '0';
  });
  if (!isOpen) {
    item.classList.add('open');
    answer.style.maxHeight = answer.scrollHeight + 'px';
  }
}

/* SUBNAV ACTIVE STATE */
var ppLinks = document.querySelectorAll('.pp-subnav-inner a');
var ppSections = document.querySelectorAll('section[id]');
var ppObs = new IntersectionObserver(function(entries) {
  entries.forEach(function(entry) {
    if (entry.isIntersecting) {
      ppLinks.forEach(function(link) {
        link.classList.remove('active');
        if (link.getAttribute('href') === '#' + entry.target.id) link.classList.add('active');
      });
    }
  });
}, { rootMargin: '-80px 0px -60% 0px', threshold: 0 });
ppSections.forEach(function(s) { ppObs.observe(s); });

/* SCROLL ANIMATIONS */
var ppFadeEls = document.querySelectorAll('.pp-pillar-card,.pp-trust-card,.pp-testimonial-card,.pp-model-card,.pp-ai-stat');
var ppScrollObs = new IntersectionObserver(function(entries) {
  entries.forEach(function(entry) {
    if (entry.isIntersecting) {
      entry.target.style.opacity = '1';
      entry.target.style.transform = 'translateY(0)';
      ppScrollObs.unobserve(entry.target);
    }
  });
}, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
ppFadeEls.forEach(function(el) {
  el.style.opacity = '0';
  el.style.transform = 'translateY(20px)';
  el.style.transition = 'opacity 0.55s ease, transform 0.55s ease';
  ppScrollObs.observe(el);
});

/* TABLE scroll hint */
var tbl = document.querySelector('.pp-compare-wrap');
if (tbl && tbl.scrollWidth > tbl.clientWidth) {
  var hint = document.querySelector('.scroll-hint');
  if (hint) hint.style.display = 'block';
}
</script>

