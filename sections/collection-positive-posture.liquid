<style>
  /* ============================================
     POSITIVE POSTURE COLLECTION — INTELLIGENT WELLNESS
     Massage Chairs and More Design System
     All units in PX for Shopify compatibility
     ============================================ */

  :root {
    --pp-bg: #fdfcfa;
    --pp-surface: #f8f5f0;
    --pp-surface-alt: #f2ede6;
    --pp-surface-warm: #faf7f2;
    --pp-dark: #1c1814;
    --pp-dark2: #0f0d0a;
    --pp-text: #2e2a25;
    --pp-muted: #5c574f;
    --pp-light-text: #8e887e;
    --pp-accent: #8a6b3a;
    --pp-accent-hover: #705631;
    --pp-accent-light: rgba(138,107,58,0.08);
    --pp-accent-sky: #b08448;
    --pp-border: #e8e0d4;
    --pp-border-light: #f0ebe2;
    --pp-white: #ffffff;
    --pp-card-shadow: 0 2px 16px rgba(0,0,0,0.04);
    --pp-card-shadow-hover: 0 16px 48px rgba(0,0,0,0.09);
    --pp-shadow-accent: 0 8px 32px rgba(138,107,58,0.20);
    --pp-radius: 14px;
    --pp-radius-sm: 9px;
    --pp-radius-lg: 22px;
    --pp-radius-xl: 30px;
    --pp-transition: all 0.3s cubic-bezier(0.4,0,0.2,1);
    --pp-ai-from: #1c1410;
    --pp-ai-to: #2e2218;
  }

  .pp-wrap *,.pp-wrap *::before,.pp-wrap *::after{box-sizing:border-box;margin:0;padding:0}
  .pp-wrap{font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;background:var(--pp-bg);color:var(--pp-text);line-height:1.78;font-size:16px !important;font-weight:400;-webkit-font-smoothing:antialiased;overflow-x:hidden}
  .pp-wrap h1,.pp-wrap h2,.pp-wrap h3,.pp-wrap h4{color:var(--pp-dark);line-height:1.2;font-weight:700}
  .pp-wrap h1,.pp-wrap h2{font-family:'Playfair Display',Georgia,serif}
  .pp-wrap a{color:inherit;text-decoration:none}
  .pp-wrap img{max-width:100%;display:block}
  .pp-wrap p{font-size:15px;color:var(--pp-muted);line-height:1.8}

  .pp-container{max-width:1300px;margin:0 auto;padding:0 32px}
  .pp-container-narrow{max-width:880px;margin:0 auto;padding:0 32px}

  @keyframes ppFadeUp{from{opacity:0;transform:translateY(28px)}to{opacity:1;transform:translateY(0)}}
  @keyframes ppShimmer{0%,100%{opacity:0.45}50%{opacity:1}}
  @keyframes ppPulseDot{0%,100%{transform:scale(1);opacity:1}50%{transform:scale(1.5);opacity:0.55}}
  @keyframes ppGradientShift{0%{background-position:0% 50%}50%{background-position:100% 50%}100%{background-position:0% 50%}}
  @keyframes ppScanLine{0%{transform:translateY(-100%)}100%{transform:translateY(500%)}}
  @keyframes ppGrainFloat{0%{transform:translate(0,0)}50%{transform:translate(2px,-2px)}100%{transform:translate(0,0)}}

  .pp-fade-up{animation:ppFadeUp 0.7s ease both}
  .pp-fade-up-1{animation-delay:0.1s}
  .pp-fade-up-2{animation-delay:0.22s}
  .pp-fade-up-3{animation-delay:0.34s}
  .pp-fade-up-4{animation-delay:0.46s}

  /* SUBNAV */
  .pp-subnav{background:rgba(249,250,251,0.97);backdrop-filter:blur(12px);border-bottom:1px solid var(--pp-border-light);overflow-x:auto;scrollbar-width:none}
  .pp-subnav::-webkit-scrollbar{display:none}
  .pp-subnav-inner{display:flex;padding:0 32px;min-width:max-content}
  .pp-subnav-inner a{display:block;padding:12px 18px;font-size:12px;font-weight:700;color:var(--pp-muted);border-bottom:2.5px solid transparent;white-space:nowrap;transition:var(--pp-transition);text-transform:uppercase;letter-spacing:0.08em;text-decoration:none}
  .pp-subnav-inner a:hover,.pp-subnav-inner a.active{color:var(--pp-dark);border-bottom-color:var(--pp-accent)}

  /* BUTTONS */
  .pp-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:16px 36px;font-size:15px !important;font-weight:700;border-radius:50px;text-decoration:none;transition:var(--pp-transition);border:2px solid transparent;cursor:pointer;letter-spacing:0.02em;font-family:'Inter',sans-serif}
  .pp-btn-primary{background:var(--pp-dark);color:#fff !important;border-color:var(--pp-dark)}
  .pp-btn-primary:hover{background:var(--pp-accent);border-color:var(--pp-accent);transform:translateY(-2px);box-shadow:var(--pp-shadow-accent);color:#fff !important}
  .pp-btn-accent{background:var(--pp-accent);color:#fff !important;border-color:var(--pp-accent)}
  .pp-btn-accent:hover{background:var(--pp-accent-hover);border-color:var(--pp-accent-hover);transform:translateY(-2px);box-shadow:var(--pp-shadow-accent);color:#fff !important}
  .pp-btn-outline{background:transparent;color:var(--pp-dark) !important;border:2px solid var(--pp-border)}
  .pp-btn-outline:hover{border-color:var(--pp-accent);color:var(--pp-accent) !important;transform:translateY(-1px)}
  .pp-btn-white-outline{background:transparent;color:#fff !important;border:2px solid rgba(255,255,255,0.45)}
  .pp-btn-white-outline:hover{border-color:#fff;background:rgba(255,255,255,0.10);color:#fff !important}
  .pp-btn-ghost-dark{background:rgba(255,255,255,0.07);color:#fff !important;border:1.5px solid rgba(255,255,255,0.28)}
  .pp-btn-ghost-dark:hover{background:rgba(255,255,255,0.14);border-color:rgba(255,255,255,0.45);color:#fff !important}
  .pp-btn-sm{padding:11px 24px;font-size:14px !important}
  .pp-sidebar-cta{color:#fff !important}
  .pp-sidebar-cta:hover{color:#fff !important}
  .pp-model-cta{color:#fff !important}
  .pp-model-cta:hover{color:#fff !important}

  /* SECTIONS */
  .pp-section{padding:96px 0}
  .pp-section-alt{background:var(--pp-surface)}
  .pp-section-warm{background:var(--pp-surface-warm)}
  .pp-section-header{text-align:center;margin-bottom:64px}
  .pp-section-header .pp-eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:12px;letter-spacing:0.22em;text-transform:uppercase;color:var(--pp-accent);margin-bottom:16px;font-weight:700}
  .pp-section-header .pp-eyebrow::before{content:'';width:20px;height:2px;background:linear-gradient(90deg,var(--pp-accent),var(--pp-accent-sky));border-radius:2px}
  .pp-section-header h2{font-size:44px !important;margin-bottom:16px;letter-spacing:-0.02em}
  .pp-section-header p{font-size:18px;color:var(--pp-muted);max-width:700px;margin:0 auto;line-height:1.82}
  .pp-section-header.pp-left{text-align:left}
  .pp-section-header.pp-left p{margin:0}
  .pp-eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:12px;letter-spacing:0.22em;text-transform:uppercase;color:var(--pp-accent);margin-bottom:16px;font-weight:700}
  .pp-eyebrow::before{content:'';width:20px;height:2px;background:linear-gradient(90deg,var(--pp-accent),var(--pp-accent-sky));border-radius:2px}
  .pp-accent-heading::after{content:'';display:block;width:48px;height:3px;margin-top:12px;background:linear-gradient(90deg,var(--pp-accent),var(--pp-accent-sky));border-radius:4px}
  .pp-section-header .pp-accent-heading::after{margin-left:auto;margin-right:auto}
  .pp-section-header.pp-left .pp-accent-heading::after{margin-left:0}

  /* HERO */
  .pp-hero{position:relative;min-height:96vh;display:flex;align-items:center;background:var(--pp-dark2);overflow:hidden}
  .pp-hero-bg{position:absolute;inset:0;background-size:cover;background-position:center 30%;opacity:0.38;z-index:0}
  .pp-hero-grain{position:absolute;inset:0;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.045'/%3E%3C/svg%3E");z-index:1;opacity:0.5;animation:ppGrainFloat 8s linear infinite;pointer-events:none}
  .pp-hero-overlay{position:absolute;inset:0;background:linear-gradient(120deg,rgba(8,6,4,0.95) 18%,rgba(15,12,8,0.72) 55%,rgba(28,22,14,0.38) 100%);z-index:2}
  .pp-hero-glow{position:absolute;width:700px;height:700px;border-radius:50%;background:radial-gradient(circle,rgba(138,107,58,0.10) 0%,transparent 70%);right:-100px;top:-100px;z-index:2;animation:ppShimmer 7s ease-in-out infinite}
  .pp-hero-scanline{position:absolute;width:100%;height:2px;background:linear-gradient(90deg,transparent,rgba(176,132,72,0.12),transparent);z-index:3;animation:ppScanLine 9s linear infinite;pointer-events:none}
  .pp-hero-stripe{position:absolute;left:0;bottom:0;width:100%;height:3px;background:linear-gradient(90deg,var(--pp-accent),var(--pp-accent-sky),transparent 70%);z-index:3}
  .pp-hero-content{position:relative;z-index:4;padding:80px 0 96px}
  .pp-hero-eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:12px;letter-spacing:0.22em;text-transform:uppercase;color:var(--pp-accent-sky);font-weight:700;margin-bottom:26px;background:rgba(138,107,58,0.10);padding:6px 16px;border-radius:50px;border:1px solid rgba(138,107,58,0.22)}
  .pp-hero-eyebrow::before{content:'●';font-size:7px;animation:ppPulseDot 2.8s infinite}
  .pp-hero h1{font-size:62px !important;color:#fff;max-width:840px;margin-bottom:26px;font-weight:700;line-height:1.07;letter-spacing:-0.025em;text-shadow:0 4px 32px rgba(0,0,0,0.35)}
  .pp-hero-tag{display:inline;background:linear-gradient(135deg,var(--pp-accent-sky),#d4a85a);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
  .pp-hero-sub{font-size:18px;color:rgba(255,255,255,0.74);max-width:620px;margin-bottom:10px;line-height:1.75}
  .pp-hero-note{font-size:15px;color:rgba(255,255,255,0.42);max-width:580px;margin-bottom:42px;line-height:1.7}
  .pp-hero-ctas{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:56px}
  .pp-hero-stats{display:flex;gap:0;padding-top:40px;border-top:1px solid rgba(255,255,255,0.07);flex-wrap:wrap}
  .pp-hero-stat{padding-right:40px;margin-right:40px;border-right:1px solid rgba(255,255,255,0.07)}
  .pp-hero-stat:last-child{border-right:none;margin-right:0}
  .pp-hero-stat-num{font-size:26px;font-weight:900;color:#fff;display:block;line-height:1;margin-bottom:5px;font-family:'Inter',sans-serif;background:linear-gradient(135deg,#fff,rgba(255,255,255,0.65));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
  .pp-hero-stat-label{font-size:12px;color:rgba(255,255,255,0.38);text-transform:uppercase;letter-spacing:0.13em;font-weight:600}

  /* TRUST BAR */
  .pp-trust-bar{background:var(--pp-surface);border-bottom:1px solid var(--pp-border-light);padding:44px 0}
  .pp-trust-bar-inner{display:flex;justify-content:center;align-items:center;flex-wrap:wrap}
  .pp-trust-item{display:flex;align-items:center;gap:14px;padding:8px 32px;transition:var(--pp-transition)}
  .pp-trust-item:hover{transform:translateY(-3px)}
  .pp-trust-icon{width:50px;height:50px;background:var(--pp-accent-light);border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:var(--pp-transition)}
  .pp-trust-item:hover .pp-trust-icon{background:var(--pp-accent)}
  .pp-trust-item:hover .pp-trust-icon svg{fill:#fff}
  .pp-trust-icon svg{width:23px;height:23px;fill:var(--pp-accent);transition:fill 0.3s}
  .pp-trust-text strong{font-size:15px;font-weight:700;color:var(--pp-dark);display:block;line-height:1.3}
  .pp-trust-text span{font-size:12px;color:var(--pp-light-text)}
  .pp-trust-divider{width:1px;height:44px;background:var(--pp-border);flex-shrink:0}

  /* MODEL FAMILY OVERVIEW */
  .pp-model-family-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:20px}
  .pp-model-card{background:var(--pp-white);border:1px solid var(--pp-border);border-radius:var(--pp-radius-lg);overflow:hidden;transition:var(--pp-transition);position:relative;display:flex;flex-direction:column;box-shadow:var(--pp-card-shadow)}
  .pp-model-card:hover{transform:translateY(-6px);box-shadow:var(--pp-card-shadow-hover);border-color:rgba(44,95,138,0.22)}
  .pp-model-card-header{padding:20px 20px 14px;border-bottom:1px solid var(--pp-border-light)}
  .pp-model-line{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:0.16em;color:var(--pp-accent);margin-bottom:6px}
  .pp-model-name{font-size:16px;font-weight:800;color:var(--pp-dark);font-family:'Inter',sans-serif;line-height:1.2;margin-bottom:4px}
  .pp-model-sub{font-size:12px;color:var(--pp-light-text);line-height:1.4}
  .pp-model-img{padding:20px;background:var(--pp-surface);min-height:280px;display:flex;align-items:center;justify-content:center;overflow:hidden}
  .pp-model-img img{max-height:240px;width:100%;object-fit:contain;mix-blend-mode:multiply;transition:transform 0.4s ease;transform:scale(1.2);transform-origin:center center}
  .pp-model-card:hover .pp-model-img img{transform:scale(1.32)}
  .pp-model-body{padding:16px 20px 20px;flex:1;display:flex;flex-direction:column}
  .pp-model-best-for{font-size:11px;font-weight:700;color:var(--pp-accent);text-transform:uppercase;letter-spacing:0.13em;margin-bottom:10px;display:block}
  .pp-model-desc{font-size:13px;color:var(--pp-muted);line-height:1.65;flex:1;margin-bottom:14px}
  .pp-model-price-wrap{font-size:22px;font-weight:900;color:var(--pp-dark);margin-bottom:12px;font-family:'Inter',sans-serif}
  .pp-model-cta{display:block;text-align:center;background:var(--pp-dark);color:#fff;padding:10px;border-radius:var(--pp-radius-sm);font-size:13px;font-weight:700;transition:var(--pp-transition);text-decoration:none}
  .pp-model-cta:hover{background:var(--pp-accent);transform:translateY(-2px);box-shadow:var(--pp-shadow-blue);color:#fff}
  .pp-model-badge{position:absolute;top:14px;right:14px;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:0.12em;padding:4px 10px;border-radius:50px}
  .pp-badge-flagship{background:linear-gradient(135deg,var(--pp-accent),var(--pp-accent-sky));color:#fff}
  .pp-badge-popular{background:var(--pp-dark);color:#fff}
  .pp-badge-recovery{background:#1a5c3a;color:#fff}
  @media(max-width:1100px){.pp-model-family-grid{grid-template-columns:repeat(3,1fr)}}
  @media(max-width:700px){.pp-model-family-grid{grid-template-columns:1fr 1fr}}
  @media(max-width:480px){.pp-model-family-grid{grid-template-columns:1fr}}

  /* MODEL SPOTLIGHTS */
  .pp-spotlight{border-radius:var(--pp-radius-xl);overflow:hidden;border:1px solid var(--pp-border);background:var(--pp-white);box-shadow:var(--pp-card-shadow);transition:box-shadow 0.38s;margin-bottom:0}
  .pp-spotlight:hover{box-shadow:var(--pp-card-shadow-hover)}
  .pp-spotlight-header{background:linear-gradient(155deg,#0c0f14 0%,#141e2d 100%);padding:44px 52px;position:relative;overflow:hidden}
  .pp-spotlight-header::after{content:'';position:absolute;width:400px;height:400px;border-radius:50%;background:radial-gradient(circle,rgba(44,95,138,0.09) 0%,transparent 70%);right:-80px;top:-80px;pointer-events:none}
  .pp-spotlight-header::before{content:'';position:absolute;bottom:0;left:0;width:100%;height:2px;background:linear-gradient(90deg,var(--pp-accent),var(--pp-accent-sky),transparent 80%)}
  .pp-model-tier{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:0.2em;color:var(--pp-accent-sky);margin-bottom:10px;display:inline-flex;align-items:center;gap:8px}
  .pp-model-tier::before{content:'';width:16px;height:2px;background:var(--pp-accent-sky);border-radius:2px}
  .pp-spotlight-header h2{color:#fff;font-size:34px !important;margin-bottom:10px;letter-spacing:-0.02em}
  .pp-model-tagline{color:rgba(255,255,255,0.52);font-size:16px;max-width:640px;line-height:1.72;margin:0}
  .pp-spotlight-body{display:grid;grid-template-columns:360px 1fr;gap:0}
  .pp-spotlight-sidebar{background:var(--pp-surface);padding:36px;display:flex;flex-direction:column;border-right:1px solid var(--pp-border-light)}
  .pp-spotlight-imgbox{background:var(--pp-white);border-radius:var(--pp-radius);padding:28px 20px;margin-bottom:20px;overflow:hidden;display:flex;align-items:center;justify-content:center;min-height:240px;border:1px solid var(--pp-border-light)}
  .pp-spotlight-imgbox img{width:100%;max-height:260px;object-fit:contain;mix-blend-mode:multiply;transition:transform 0.42s ease}
  .pp-spotlight:hover .pp-spotlight-imgbox img{transform:scale(1.04)}
  .pp-price-was{font-size:13px;color:var(--pp-light-text);text-decoration:line-through;margin-bottom:4px}
  .pp-price-tag{font-size:28px;font-weight:900;color:var(--pp-dark);font-family:'Inter',sans-serif;margin-bottom:6px;line-height:1}
  .pp-price-tag.loading{color:var(--pp-border);animation:ppShimmer 1.5s ease infinite}
  .pp-price-note{font-size:13px;color:var(--pp-light-text);margin-bottom:20px;line-height:1.5}
  .pp-sidebar-cta{display:block;text-align:center;background:var(--pp-dark);color:#fff;padding:13px;border-radius:var(--pp-radius-sm);font-size:14px;font-weight:700;transition:var(--pp-transition);letter-spacing:0.02em;margin-bottom:10px;text-decoration:none}
  .pp-sidebar-cta:hover{background:var(--pp-accent);transform:translateY(-2px);box-shadow:var(--pp-shadow-blue);color:#fff}
  .pp-sidebar-link{display:block;text-align:center;color:var(--pp-muted);font-size:13px;padding:10px;border-radius:var(--pp-radius-sm);border:1.5px solid var(--pp-border);transition:var(--pp-transition);text-decoration:none}
  .pp-sidebar-link:hover{border-color:var(--pp-accent);color:var(--pp-accent);background:var(--pp-accent-light)}
  .pp-spotlight-content{padding:38px 46px}
  .pp-model-best-badge{display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:0.13em;color:var(--pp-accent);background:var(--pp-accent-light);padding:5px 13px;border-radius:50px;margin-bottom:20px;border:1px solid rgba(44,95,138,0.18)}
  .pp-spotlight-content h3{font-size:16px !important;margin-bottom:12px;font-family:'Inter',sans-serif;color:var(--pp-dark);font-weight:700}
  .pp-spotlight-content p{font-size:15px;color:var(--pp-muted);line-height:1.86;margin-bottom:14px}
  .pp-trait-pills{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px}
  .pp-trait-pill{font-size:11px;font-weight:700;padding:4px 11px;border-radius:20px;background:var(--pp-surface);border:1px solid var(--pp-border);color:var(--pp-muted);transition:var(--pp-transition)}
  .pp-trait-pill:hover{background:var(--pp-accent-light);border-color:var(--pp-accent);color:var(--pp-accent)}

  /* AI BANNER — fullbleed editorial */
  .pp-ai-banner{position:relative;overflow:hidden;padding:0}
  .pp-ai-banner-bg{position:absolute;inset:0;background-size:cover;background-position:center right;z-index:0}
  .pp-ai-banner-overlay{position:absolute;inset:0;background:linear-gradient(105deg,rgba(12,9,5,0.97) 0%,rgba(20,14,7,0.92) 38%,rgba(28,20,10,0.70) 62%,rgba(28,20,10,0.22) 100%);z-index:1}
  .pp-ai-banner-content{position:relative;z-index:2;padding:96px 0;max-width:620px}
  .pp-ai-eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:11px;letter-spacing:0.24em;text-transform:uppercase;color:var(--pp-accent-sky);font-weight:800;margin-bottom:24px}
  .pp-ai-eyebrow::before{content:'';width:24px;height:2px;background:linear-gradient(90deg,var(--pp-accent),var(--pp-accent-sky));border-radius:2px}
  .pp-ai-banner h2{color:#fff;font-size:44px !important;margin-bottom:22px;letter-spacing:-0.025em;line-height:1.08;font-family:'Playfair Display',serif;text-shadow:0 2px 24px rgba(0,0,0,0.4)}
  .pp-ai-banner p{color:rgba(255,255,255,0.68);font-size:15px;line-height:1.9;margin-bottom:14px;max-width:540px}
  .pp-ai-kpis{display:flex;gap:0;margin-top:40px;border-radius:14px;overflow:hidden;border:1px solid rgba(255,255,255,0.10);backdrop-filter:blur(12px)}
  .pp-ai-kpi{background:rgba(255,255,255,0.05);padding:20px 22px;flex:1;border-right:1px solid rgba(255,255,255,0.08);transition:background 0.2s}
  .pp-ai-kpi:last-child{border-right:none}
  .pp-ai-kpi:hover{background:rgba(138,107,58,0.16)}
  .pp-ai-kpi-num{font-size:18px;font-weight:900;background:linear-gradient(135deg,#d4a85a,var(--pp-accent-sky));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;display:block;line-height:1.1;margin-bottom:5px;font-family:'Inter',sans-serif}
  .pp-ai-kpi-label{font-size:11px;color:rgba(255,255,255,0.4);font-weight:600;line-height:1.35}
  /* LIFESTYLE — edge-to-edge */
  .pp-lifestyle-fullbleed{display:grid;grid-template-columns:1fr 1fr;gap:0;min-height:540px}
  .pp-lifestyle-panel-img{background-size:cover;background-position:center;position:relative}
  .pp-lifestyle-panel-img::after{content:'';position:absolute;inset:0;background:linear-gradient(to right,transparent 50%,var(--pp-bg) 100%)}
  .pp-lifestyle-panel-text{background:var(--pp-bg);display:flex;flex-direction:column;justify-content:center;padding:72px 64px}
  .pp-lifestyle-panel-text .pp-eyebrow{margin-bottom:18px}
  .pp-lifestyle-panel-text h2{font-size:36px !important;letter-spacing:-0.022em;margin-bottom:22px;color:var(--pp-dark);line-height:1.15}
  .pp-lifestyle-panel-text p{font-size:15px;color:var(--pp-muted);line-height:1.88;margin-bottom:14px}

  /* PILLAR CARDS */
  .pp-pillar-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:26px}
  .pp-pillar-card{background:var(--pp-white);border:1px solid var(--pp-border);border-radius:var(--pp-radius-lg);padding:32px;transition:var(--pp-transition);position:relative;overflow:hidden}
  .pp-pillar-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--pp-accent),var(--pp-accent-sky));transform:scaleX(0);transform-origin:left;transition:transform 0.32s}
  .pp-pillar-card:hover::before{transform:scaleX(1)}
  .pp-pillar-card:hover{transform:translateY(-5px);box-shadow:var(--pp-card-shadow-hover);border-color:transparent}
  .pp-pillar-icon{width:50px;height:50px;background:var(--pp-accent-light);border-radius:14px;display:flex;align-items:center;justify-content:center;margin-bottom:18px;transition:var(--pp-transition)}
  .pp-pillar-card:hover .pp-pillar-icon{background:linear-gradient(135deg,var(--pp-accent),var(--pp-accent-sky))}
  .pp-pillar-icon svg{width:23px;height:23px;fill:var(--pp-accent);transition:fill 0.3s}
  .pp-pillar-card:hover .pp-pillar-icon svg{fill:#fff}
  .pp-pillar-card h3{font-size:16px;margin-bottom:10px;font-family:'Inter',sans-serif;color:var(--pp-dark)}
  .pp-pillar-card p{font-size:14px;color:var(--pp-muted);margin:0;line-height:1.75}

  /* DESIGN STORY */
  .pp-design-story{display:grid;grid-template-columns:1fr 1fr;gap:72px;align-items:center}
  .pp-design-quote{border-left:3px solid var(--pp-accent);padding:16px 20px;margin:24px 0;font-style:italic;font-size:16px;color:var(--pp-text);background:var(--pp-accent-light);border-radius:0 var(--pp-radius-sm) var(--pp-radius-sm) 0}
  .pp-design-swatches{display:flex;flex-direction:column;gap:20px}
  .pp-design-swatch-card{background:var(--pp-white);border:1px solid var(--pp-border);border-radius:var(--pp-radius-lg);padding:26px;transition:var(--pp-transition)}
  .pp-design-swatch-card:hover{box-shadow:var(--pp-card-shadow-hover);border-color:rgba(44,95,138,0.22);transform:translateY(-3px)}
  .pp-swatch-label{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:0.16em;color:var(--pp-accent);margin-bottom:10px}
  .pp-swatch-dots{display:flex;gap:10px;margin-bottom:10px}
  .pp-swatch-dot{width:28px;height:28px;border-radius:50%;border:2px solid var(--pp-border)}
  .pp-design-swatch-card h4{font-size:15px;font-weight:700;color:var(--pp-dark);margin-bottom:6px;font-family:'Inter',sans-serif}
  .pp-design-swatch-card p{font-size:13px;color:var(--pp-muted);margin:0;line-height:1.6}

  /* MODEL CARDS */
  .pp-model-family-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px}
  .pp-model-card{background:var(--pp-white);border:1px solid var(--pp-border);border-radius:var(--pp-radius-lg);overflow:hidden;transition:var(--pp-transition);position:relative;display:flex;flex-direction:column}
  .pp-model-card:hover{box-shadow:var(--pp-card-shadow-hover);transform:translateY(-5px);border-color:transparent}
  .pp-model-badge{position:absolute;top:14px;left:14px;font-size:10px;font-weight:800;letter-spacing:0.12em;text-transform:uppercase;padding:4px 12px;border-radius:20px;z-index:2}
  .pp-badge-flagship{background:linear-gradient(135deg,var(--pp-accent),var(--pp-accent-sky));color:#fff}
  .pp-badge-popular{background:linear-gradient(135deg,#1c5c38,#2d8a56);color:#fff}
  .pp-badge-recovery{background:linear-gradient(135deg,#1a3a6e,#2657a8);color:#fff}
  .pp-model-card-header{padding:20px 20px 14px;border-bottom:1px solid var(--pp-border-light)}
  .pp-model-line{font-size:10px;text-transform:uppercase;letter-spacing:0.18em;color:var(--pp-accent);font-weight:800;margin-bottom:6px}
  .pp-model-name{font-size:17px;font-weight:800;color:var(--pp-dark);font-family:'Inter',sans-serif;line-height:1.2;margin-bottom:4px}
  .pp-model-sub{font-size:12px;color:var(--pp-muted);line-height:1.5}
  .pp-model-img{background:var(--pp-surface);overflow:hidden;position:relative;height:360px;display:block;text-decoration:none}
  .pp-model-img img{width:100%;height:100%;object-fit:contain;transition:transform 0.4s cubic-bezier(0.4,0,0.2,1);padding:16px 8px 0;mix-blend-mode:multiply;transform:scale(1.25);transform-origin:center center}
  .pp-model-card:hover .pp-model-img img{transform:scale(1.35)}
  .pp-model-body{padding:20px;flex:1;display:flex;flex-direction:column}
  .pp-model-best-for{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:0.12em;color:var(--pp-accent);margin-bottom:10px;display:block}
  .pp-model-desc{font-size:13.5px;color:var(--pp-muted);line-height:1.72;margin-bottom:16px;flex:1}
  .pp-model-price-wrap{margin-bottom:14px}
  .pp-dyn-price{font-size:20px;font-weight:900;color:var(--pp-dark);font-family:'Inter',sans-serif}
  .pp-model-cta{display:block;text-align:center;background:var(--pp-dark);color:#fff !important;padding:12px;border-radius:var(--pp-radius-sm);font-size:13px;font-weight:700;transition:var(--pp-transition);letter-spacing:0.02em;text-decoration:none}
  .pp-model-cta:hover{background:var(--pp-accent);transform:translateY(-2px);box-shadow:var(--pp-shadow-accent);color:#fff !important}
  /* INTRO */
  .pp-intro-lead strong{color:var(--pp-dark);font-weight:700}
  .pp-intro-lead em{font-style:italic;color:var(--pp-accent)}
  .pp-intro-pillars{display:grid;grid-template-columns:repeat(3,1fr);gap:32px;margin-top:52px}
  .pp-intro-pillar{padding:28px 24px;border-left:3px solid var(--pp-accent);background:linear-gradient(135deg,var(--pp-accent-light),transparent);border-radius:0 var(--pp-radius-sm) var(--pp-radius-sm) 0}
  .pp-intro-pillar h3{font-size:16px !important;font-family:'Inter',sans-serif;font-weight:700;margin-bottom:8px;color:var(--pp-dark)}
  .pp-intro-pillar p{font-size:14px;color:var(--pp-muted);line-height:1.72;margin:0}

  /* QUICK ANSWERS */
  .pp-quick-answer{background:linear-gradient(145deg,var(--pp-ai-from) 0%,var(--pp-ai-to) 100%);border-radius:var(--pp-radius-xl);padding:56px;border:1px solid rgba(138,107,58,0.14);position:relative;overflow:hidden}
  .pp-quick-answer::before{content:'';position:absolute;width:450px;height:450px;border-radius:50%;background:radial-gradient(circle,rgba(138,107,58,0.08) 0%,transparent 70%);right:-120px;bottom:-120px;pointer-events:none}
  .pp-quick-answer h2{color:#fff;margin-bottom:8px;font-size:32px !important}
  .pp-qa-intro{color:rgba(255,255,255,0.52);font-size:16px;max-width:600px;margin-bottom:36px;line-height:1.78}
  .pp-qa-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}
  .pp-qa-item{background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.07);border-radius:var(--pp-radius);padding:24px;transition:var(--pp-transition)}
  .pp-qa-item:hover{background:rgba(138,107,58,0.07);border-color:rgba(138,107,58,0.18);transform:translateY(-2px)}
  .pp-qa-item h3{color:var(--pp-accent-sky);font-size:13px;text-transform:uppercase;letter-spacing:0.15em;margin-bottom:12px;font-weight:800;font-family:'Inter',sans-serif}
  .pp-qa-item p{font-size:15px;color:rgba(255,255,255,0.65);line-height:1.82;margin:0}

  /* TESTIMONIALS */
  .pp-testimonials-strip{display:grid;grid-template-columns:repeat(3,1fr);gap:26px}
  .pp-testimonial-card{background:var(--pp-white);border:1px solid var(--pp-border);border-radius:var(--pp-radius-lg);padding:32px;transition:var(--pp-transition);position:relative}
  .pp-testimonial-card::before{content:'"';position:absolute;top:18px;right:22px;font-size:60px;font-family:'Playfair Display',serif;color:var(--pp-border);line-height:1}
  .pp-testimonial-card:hover{box-shadow:var(--pp-card-shadow-hover);transform:translateY(-3px)}
  .pp-testimonial-card p{font-size:15px;color:var(--pp-muted);line-height:1.8;margin-bottom:14px;font-style:italic}
  .pp-testimonial-meta{font-size:12px;color:var(--pp-muted)}
  .pp-testimonial-tag{font-weight:800;color:var(--pp-accent);font-size:12px;text-transform:uppercase;letter-spacing:0.12em}

  /* WHY BUY GRID */
  .pp-trust-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:30px}
  .pp-trust-card{background:var(--pp-white);border:1px solid var(--pp-border);border-radius:var(--pp-radius-lg);padding:32px;transition:var(--pp-transition)}
  .pp-trust-card:hover{transform:translateY(-5px);box-shadow:var(--pp-card-shadow-hover);border-color:rgba(44,95,138,0.2)}
  .pp-trust-card-icon{width:50px;height:50px;background:var(--pp-accent-light);border-radius:14px;display:flex;align-items:center;justify-content:center;margin-bottom:20px;transition:var(--pp-transition)}
  .pp-trust-card:hover .pp-trust-card-icon{background:linear-gradient(135deg,var(--pp-accent),var(--pp-accent-sky))}
  .pp-trust-card-icon svg{width:24px;height:24px;fill:var(--pp-accent);transition:fill 0.3s}
  .pp-trust-card:hover .pp-trust-card-icon svg{fill:#fff}
  .pp-trust-card h3{font-size:16px;margin-bottom:10px;font-family:'Inter',sans-serif;color:var(--pp-dark)}
  .pp-trust-card p{font-size:14px;color:var(--pp-muted);margin:0;line-height:1.75}

  /* FAQ */
  .pp-faq-list{border-top:1px solid var(--pp-border)}
  .pp-faq-item{border-bottom:1px solid var(--pp-border)}
  .pp-faq-q{display:flex;justify-content:space-between;align-items:center;padding:22px 0;cursor:pointer;gap:16px;user-select:none}
  .pp-faq-q h3{font-size:16px !important;font-family:'Inter',sans-serif;font-weight:700;margin:0;flex:1;line-height:1.4;color:var(--pp-dark);transition:color 0.2s}
  .pp-faq-q:hover h3{color:var(--pp-accent)}
  .pp-faq-toggle{width:36px;height:36px;border-radius:50%;background:var(--pp-surface);display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:300;color:var(--pp-accent);flex-shrink:0;transition:var(--pp-transition)}
  .pp-faq-item.open .pp-faq-toggle{background:var(--pp-accent);color:#fff;transform:rotate(45deg)}
  .pp-faq-a{max-height:0;overflow:hidden;transition:max-height 0.38s cubic-bezier(0.4,0,0.2,1)}
  .pp-faq-a-inner{padding:0 0 26px}
  .pp-faq-a-inner p{font-size:16px;color:var(--pp-muted);line-height:1.87;margin:0}

  /* FINAL CTA */
  .pp-final-cta{background:linear-gradient(155deg,var(--pp-ai-from) 0%,var(--pp-ai-to) 100%);border-radius:var(--pp-radius-xl);padding:80px 64px;color:#fff;position:relative;overflow:hidden;text-align:center}
  .pp-final-cta::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--pp-accent),var(--pp-accent-sky),var(--pp-accent));background-size:200% 100%;animation:ppGradientShift 5s ease infinite}
  .pp-final-cta h2{color:#fff;font-size:40px !important;margin-bottom:16px}
  .pp-final-cta p{color:rgba(255,255,255,0.62);font-size:16px !important;max-width:680px;margin:0 auto 40px;line-height:1.82}
  .pp-final-cta-btns{display:flex;flex-wrap:wrap;gap:16px;justify-content:center}

  /* SUPPORT BAR */
  .pp-support-bar{background:var(--pp-white);padding:60px 0;border-top:1px solid var(--pp-border-light);border-bottom:1px solid var(--pp-border-light)}
  .pp-support-bar-inner{display:flex;justify-content:center;align-items:center;flex-wrap:wrap}
  .pp-support-item{display:flex;align-items:center;gap:16px;padding:8px 40px;transition:var(--pp-transition)}
  .pp-support-item:hover{transform:translateY(-3px)}
  .pp-support-icon{width:52px;height:52px;background:var(--pp-accent-light);border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:var(--pp-transition)}
  .pp-support-item:hover .pp-support-icon{background:var(--pp-accent)}
  .pp-support-item:hover .pp-support-icon svg{fill:#fff}
  .pp-support-icon svg{width:24px;height:24px;fill:var(--pp-accent);transition:fill 0.3s}
  .pp-support-text strong{font-size:15px;font-weight:700;color:var(--pp-dark);display:block;line-height:1.3}
  .pp-support-text span{font-size:13px;color:var(--pp-light-text)}
  .pp-support-divider{width:1px;height:48px;background:var(--pp-border);flex-shrink:0}

  .pp-grad-divider{height:1px;background:linear-gradient(90deg,transparent,var(--pp-border),transparent)}
  .pp-sage-band{height:4px;background:linear-gradient(90deg,var(--pp-accent-hover),var(--pp-accent),var(--pp-accent-sky),var(--pp-accent),transparent);opacity:0.45}

  /* RESPONSIVE */
  @media(max-width:1100px){
    .pp-pillar-grid{grid-template-columns:repeat(2,1fr)}
    .pp-spotlight-body{grid-template-columns:1fr}
    .pp-spotlight-sidebar{border-right:none;border-bottom:1px solid var(--pp-border-light)}
    .pp-testimonials-strip{grid-template-columns:repeat(2,1fr)}
    .pp-trust-grid{grid-template-columns:repeat(2,1fr)}
    .pp-design-story{grid-template-columns:1fr;gap:48px}
    .pp-qa-grid{grid-template-columns:1fr}
    .pp-intro-pillars{grid-template-columns:1fr;gap:16px}
    .pp-model-family-grid{grid-template-columns:repeat(2,1fr)}
    .pp-lifestyle-fullbleed{grid-template-columns:1fr}
    .pp-lifestyle-panel-img{min-height:340px}
    .pp-lifestyle-panel-img::after{background:linear-gradient(to bottom,transparent 50%,var(--pp-bg) 100%)}
    .pp-lifestyle-panel-text{padding:48px 32px}
  }
  @media(max-width:768px){
    .pp-hero{min-height:78vh}
    .pp-hero-content{padding:48px 0 64px}
    .pp-hero h1{font-size:32px}
    .pp-section{padding:64px 0}
    .pp-section-header{margin-bottom:40px}
    .pp-spotlight-header{padding:30px 22px}
    .pp-spotlight-content{padding:28px 22px}
    .pp-spotlight-sidebar{padding:28px 22px}
    .pp-quick-answer{padding:32px 24px}
    .pp-final-cta{padding:48px 28px}
    .pp-container{padding:0 20px}
    .pp-testimonials-strip{grid-template-columns:1fr}
    .pp-trust-grid{grid-template-columns:1fr}
    .pp-pillar-grid{grid-template-columns:1fr}
  }
  @media(max-width:480px){
    .pp-hero-ctas,.pp-final-cta-btns{flex-direction:column;align-items:center}
    .pp-btn{padding:14px 28px;font-size:14px}
  }

  /* ---- COMPARISON TABLE ---- */
  .pp-compare-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch;border-radius:var(--pp-radius);border:1px solid var(--pp-border);box-shadow:0 4px 24px rgba(0,0,0,0.06)}
  .pp-compare-table{width:100%;border-collapse:collapse;font-size:13.5px;font-family:'Inter',sans-serif;min-width:780px}
  .pp-compare-table th{background:var(--pp-dark);color:#fff;padding:14px 18px;text-align:left;font-size:13px;font-weight:700;letter-spacing:0.02em;white-space:nowrap;position:sticky;top:0;z-index:2}
  .pp-compare-table th:first-child{background:var(--pp-dark);color:rgba(255,255,255,0.7);font-weight:600;font-size:12px;text-transform:uppercase;letter-spacing:0.08em;width:160px;min-width:140px}
  .pp-compare-table td{padding:12px 18px;vertical-align:middle;border-bottom:1px solid var(--pp-border);color:var(--pp-dark);line-height:1.5}
  .pp-compare-table td:first-child{font-weight:600;color:var(--pp-muted);font-size:12.5px;background:var(--pp-surface);white-space:nowrap}
  .pp-compare-table tbody tr:nth-child(even) td{background:rgba(245,241,235,0.55)}
  .pp-compare-table tbody tr:nth-child(even) td:first-child{background:rgba(235,230,222,0.7)}
  .pp-compare-table tbody tr:last-child td{border-bottom:none}
  .pp-compare-table tbody tr:hover td{background:rgba(180,148,80,0.07)}
  .pp-compare-table tbody tr:hover td:first-child{background:rgba(180,148,80,0.12)}
  .pp-compare-check{color:var(--pp-accent);font-weight:900;font-size:15px}
  .pp-compare-dash{color:var(--pp-light-text);font-size:13px}
  @media(max-width:900px){
    .pp-compare-table{font-size:12.5px}
    .pp-compare-table th,.pp-compare-table td{padding:10px 12px}
  }

</style>

