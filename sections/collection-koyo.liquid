  .ky-hero-glow{position:absolute;width:700px;height:700px;border-radius:50%;background:radial-gradient(circle,rgba(122,96,64,0.10) 0%,transparent 70%);right:-150px;top:-100px;z-index:2;animation:kyShimmer 6s ease-in-out infinite}
  .ky-hero-stripe{position:absolute;left:0;bottom:0;width:100%;height:3px;background:linear-gradient(90deg,var(--ky-accent),var(--ky-accent-warm),transparent 70%);z-index:3}
