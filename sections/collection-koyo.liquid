  .ky-wrap h1,.ky-wrap h2{font-family:'Playfair Display',Georgia,serif}
  .ky-wrap a{color:inherit;text-decoration:none}
  .ky-wrap img{max-width:100%;display:block}
  .ky-wrap p{font-size:15px;color:var(--ky-muted);line-height:1.8}

  .ky-container{max-width:1300px;margin:0 auto;padding:0 32px}
  .ky-container-narrow{max-width:880px;margin:0 auto;padding:0 32px}

