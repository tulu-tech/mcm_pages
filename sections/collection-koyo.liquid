  }

  .ky-wrap *,.ky-wrap *::before,.ky-wrap *::after{box-sizing:border-box;margin:0;padding:0}
  .ky-wrap{font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;background:var(--ky-bg);color:var(--ky-text);line-height:1.78;font-size:16px !important;font-weight:400;-webkit-font-smoothing:antialiased;overflow-x:hidden}
