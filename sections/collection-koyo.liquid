<script>
/* DYNAMIC PRICE from Shopify API */
function kyFormatPrice(cents) {
  return '$' + (cents / 100).toLocaleString('en-US', {minimumFractionDigits:0,maximumFractionDigits:0});
}
document.addEventListener('DOMContentLoaded', function() {
  fetch('/products/koyo-303ts-massage-chair.js')
    .then(function(r) { return r.ok ? r.json() : Promise.reject(); })
    .then(function(data) {
      if (!data || !data.price) return;
      var price = kyFormatPrice(data.price);
      ['ky-price-black','ky-price-pearl','ky-price-walnut','ky-main-price'].forEach(function(id) {
        var el = document.getElementById(id);
        if (el) el.textContent = price;
      });
      if (data.featured_image) {
        var img = document.getElementById('ky-main-img');
        if (img) { img.src = 'https:' + data.featured_image; img.alt = data.title; }
      }
    })
    .catch(function() {});
});

/* FAQ ACCORDION */
function kyToggleFaq(el) {
  var item = el.closest('.ky-faq-item');
  var answer = item.querySelector('.ky-faq-a');
  var isOpen = item.classList.contains('open');
  document.querySelectorAll('.ky-faq-item.open').forEach(function(o) {
    o.classList.remove('open');
    o.querySelector('.ky-faq-a').style.maxHeight = '0';
  });
  if (!isOpen) {
    item.classList.add('open');
    answer.style.maxHeight = answer.scrollHeight + 'px';
  }
}

/* SUBNAV ACTIVE STATE */
var kyLinks = document.querySelectorAll('.ky-subnav-inner a');
var kySections = document.querySelectorAll('section[id]');
var kyObs = new IntersectionObserver(function(entries) {
  entries.forEach(function(entry) {
    if (entry.isIntersecting) {
      kyLinks.forEach(function(link) {
        link.classList.remove('active');
        if (link.getAttribute('href') === '#' + entry.target.id) link.classList.add('active');
      });
    }
  });
}, { rootMargin: '-80px 0px -60% 0px', threshold: 0 });
kySections.forEach(function(s) { kyObs.observe(s); });

/* SCROLL ANIMATIONS */
var kyFadeEls = document.querySelectorAll('.ky-pillar-card,.ky-buyer-card,.ky-trust-card,.ky-testimonial-card,.ky-japan-stat');
var kyScrollObs = new IntersectionObserver(function(entries) {
  entries.forEach(function(entry) {
    if (entry.isIntersecting) {
      entry.target.style.opacity = '1';
      entry.target.style.transform = 'translateY(0)';
      kyScrollObs.unobserve(entry.target);
    }
  });
}, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
kyFadeEls.forEach(function(el) {
  el.style.opacity = '0';
  el.style.transform = 'translateY(20px)';
  el.style.transition = 'opacity 0.55s ease, transform 0.55s ease';
  kyScrollObs.observe(el);
});
</script>

