<style>
  /* ============================================
     KOYO COLLECTION — MADE IN JAPAN EDITORIAL
     Massage Chairs and More Design System
     All units in PX for Shopify compatibility
     ============================================ */

  :root {
    --ky-bg: #fdfcfa;
    --ky-surface: #f8f5f0;
    --ky-surface-alt: #f2ede6;
    --ky-surface-warm: #faf7f2;
    --ky-dark: #1a1612;
    --ky-dark2: #0e0c09;
    --ky-text: #2e2a25;
    --ky-muted: #5c574f;
    --ky-light-text: #8e887e;
    --ky-accent: #7a6040;
    --ky-accent-hover: #5f4a2e;
    --ky-accent-light: rgba(122,96,64,0.08);
    --ky-accent-warm: #b08448;
    --ky-border: #e8e0d4;
    --ky-border-light: #f0ebe2;
    --ky-white: #ffffff;
    --ky-card-shadow: 0 2px 16px rgba(0,0,0,0.04);
