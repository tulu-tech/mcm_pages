  @keyframes kyPulseDot{0%,100%{transform:scale(1);opacity:1}50%{transform:scale(1.5);opacity:0.55}}
  @keyframes kyGradientShift{0%{background-position:0% 50%}50%{background-position:100% 50%}100%{background-position:0% 50%}}
