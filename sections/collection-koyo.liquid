  .ky-hero-eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:12px;letter-spacing:0.22em;text-transform:uppercase;color:var(--ky-accent-warm);font-weight:700;margin-bottom:26px;background:rgba(122,96,64,0.09);padding:6px 16px;border-radius:50px;border:1px solid rgba(122,96,64,0.18)}
  .ky-hero-eyebrow::before{content:'●';font-size:7px;animation:kyPulseDot 2.8s infinite}
  .ky-hero h1{font-size:64px !important;color:#fff;max-width:820px;margin-bottom:26px;font-weight:700;line-height:1.07;letter-spacing:-0.025em;text-shadow:0 4px 32px rgba(0,0,0,0.35)}
  .ky-hero-tag{display:inline;background:linear-gradient(135deg,var(--ky-accent-warm),#d4a96a);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
