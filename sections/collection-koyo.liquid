  .ky-product-card-cta{display:block;text-align:center;background:var(--ky-dark);color:#fff !important;padding:13px;border-radius:var(--ky-radius-sm);font-size:14px;font-weight:700;transition:var(--ky-transition);letter-spacing:0.02em;text-decoration:none;margin-bottom:8px}
