<script>
  // FAQ Accordion
  document.querySelectorAll('.sc-faq-item').forEach(function(item) {
    item.querySelector('.sc-faq-q').addEventListener('click', function() {
      var isOpen = item.classList.contains('sc-open');
      document.querySelectorAll('.sc-faq-item.sc-open').forEach(function(o) { o.classList.remove('sc-open'); });
      if (!isOpen) item.classList.add('sc-open');
    });
  });

  // Sticky CTA — show after scrolling past hero on mobile
  var stickyCta = document.getElementById('sc-sticky-cta');
  if (stickyCta && window.innerWidth <= 640) {
    stickyCta.style.opacity = '0';
    stickyCta.style.pointerEvents = 'none';
    window.addEventListener('scroll', function() {
      if (window.scrollY > window.innerHeight * 0.6) {
        stickyCta.style.opacity = '1';
        stickyCta.style.pointerEvents = 'auto';
      } else {
        stickyCta.style.opacity = '0';
        stickyCta.style.pointerEvents = 'none';
      }
    }, { passive: true });
  }
</script>

