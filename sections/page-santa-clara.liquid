<style>
  /* =============================================================
     SHOPIFY THEME OVERRIDES — page-santa-clara.liquid
     Breaks out of theme page container, suppresses native footer.
     All classes scoped to .sc-wrap to avoid conflicts.
  ============================================================= */

  /* Hide theme native footer on this template — protect our .sc-footer */
  .template-page .site-footer,
  .template-page footer.footer,
  .template-page .footer:not(.sc-footer),
  .template-page #shopify-section-footer,
  .template-page [id^="shopify-section-footer"],
  .template-page .site-footer__inner,
  .template-page footer:not(.sc-footer) { display: none !important; }
  .sc-footer { display: block !important; }

  /* Break page content to full width */
  .template-page main,
  .template-page .main-content,
  .template-page #MainContent,
  .template-page .page-width,
  .template-page .container,
  .template-page .rte,
  .template-page .shopify-section,
