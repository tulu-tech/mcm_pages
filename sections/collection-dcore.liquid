<style>
  /* ============================================
     D.CORE COLLECTION — PREMIUM EDITORIAL LANDING
     Massage Chairs and More Design System
     All units in PX for Shopify compatibility
     ============================================ */

  :root {
    --dc-bg: #fdfcfa;
    --dc-surface: #f8f5f0;
    --dc-surface-alt: #f2ede6;
    --dc-surface-warm: #faf7f2;
    --dc-dark: #1c1814;
    --dc-dark2: #0f0d0a;
    --dc-text: #2e2a25;
    --dc-muted: #5c574f;
    --dc-light-text: #8e887e;
    --dc-accent: #8a6b3a;
    --dc-accent-hover: #705631;
    --dc-accent-light: rgba(138,107,58,0.08);
    --dc-accent-glow: rgba(138,107,58,0.15);
    --dc-accent-warm: #b08448;
    --dc-accent-walnut: #6b4e2a;
    --dc-border: #e8e0d4;
    --dc-border-light: #f0ebe2;
    --dc-white: #ffffff;
    --dc-card-shadow: 0 2px 16px rgba(0,0,0,0.04);
    --dc-card-shadow-hover: 0 16px 48px rgba(0,0,0,0.09);
    --dc-shadow-walnut: 0 8px 32px rgba(138,107,58,0.20);
    --dc-radius: 14px;
    --dc-radius-sm: 9px;
    --dc-radius-lg: 22px;
    --dc-radius-xl: 30px;
    --dc-transition: all 0.3s cubic-bezier(0.4,0,0.2,1);
  }

  .dc-wrap *,.dc-wrap *::before,.dc-wrap *::after{box-sizing:border-box;margin:0;padding:0}
  .dc-wrap{font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;background:var(--dc-bg);color:var(--dc-text);line-height:1.78;font-size:16px !important;font-weight:400;-webkit-font-smoothing:antialiased;overflow-x:hidden}
  .dc-wrap h1,.dc-wrap h2,.dc-wrap h3,.dc-wrap h4,.dc-wrap h5{color:var(--dc-dark);line-height:1.2;font-weight:700}
  .dc-wrap h1,.dc-wrap h2{font-family:'Playfair Display',Georgia,serif}
  .dc-wrap a{color:inherit;text-decoration:none}
  .dc-wrap img{max-width:100%;display:block}
  .dc-wrap p{font-size:15px;color:var(--dc-muted);line-height:1.8}
  .dc-wrap h2{font-size:38px !important}
  .dc-wrap h3{font-size:20px !important}

  .dc-container{max-width:1300px;margin:0 auto;padding:0 32px}
  .dc-container-narrow{max-width:880px;margin:0 auto;padding:0 32px}

  /* ---- ANIMATIONS ---- */
  @keyframes dcFadeUp{from{opacity:0;transform:translateY(28px)}to{opacity:1;transform:translateY(0)}}
  @keyframes dcShimmer{0%,100%{opacity:0.45}50%{opacity:1}}
  @keyframes dcPulseDot{0%,100%{transform:scale(1);opacity:1}50%{transform:scale(1.5);opacity:0.55}}
  @keyframes dcGradientShift{0%{background-position:0% 50%}50%{background-position:100% 50%}100%{background-position:0% 50%}}
  @keyframes dcGrainFloat{0%{transform:translate(0,0) rotate(0deg)}33%{transform:translate(3px,-3px) rotate(1deg)}66%{transform:translate(-3px,3px) rotate(-1deg)}100%{transform:translate(0,0) rotate(0deg)}}

  .dc-fade-up{animation:dcFadeUp 0.7s ease both}
  .dc-fade-up-1{animation-delay:0.1s}
  .dc-fade-up-2{animation-delay:0.22s}
  .dc-fade-up-3{animation-delay:0.34s}
  .dc-fade-up-4{animation-delay:0.46s}

  /* ---- SUBNAV ---- */
  .dc-subnav{background:rgba(253,252,250,0.97);backdrop-filter:blur(12px);border-bottom:1px solid var(--dc-border-light);overflow-x:auto;scrollbar-width:none}
  .dc-subnav::-webkit-scrollbar{display:none}
  .dc-subnav-inner{display:flex;padding:0 32px;min-width:max-content}
  .dc-subnav-inner a{display:block;padding:12px 18px;font-size:12px;font-weight:700;color:var(--dc-muted);border-bottom:2.5px solid transparent;white-space:nowrap;transition:var(--dc-transition);text-transform:uppercase;letter-spacing:0.08em;text-decoration:none}
  .dc-subnav-inner a:hover,.dc-subnav-inner a.active{color:var(--dc-dark);border-bottom-color:var(--dc-accent)}

  /* ---- BUTTONS ---- */
  .dc-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:16px 38px;font-size:15px;font-weight:700;border-radius:50px;text-decoration:none !important;transition:var(--dc-transition);border:2px solid transparent;cursor:pointer;letter-spacing:0.02em;font-family:'Inter',sans-serif}
  .dc-btn-primary{background:var(--dc-dark);color:#ffffff !important;border-color:var(--dc-dark)}
  .dc-btn-primary:hover{background:var(--dc-accent);border-color:var(--dc-accent);transform:translateY(-2px);box-shadow:var(--dc-shadow-walnut);color:#fff !important}
  .dc-btn-accent{background:var(--dc-accent);color:#ffffff !important;border-color:var(--dc-accent)}
  .dc-btn-accent:hover{background:var(--dc-accent-hover);border-color:var(--dc-accent-hover);transform:translateY(-2px);box-shadow:var(--dc-shadow-walnut);color:#fff !important}
  .dc-btn-outline{background:transparent;color:var(--dc-dark) !important;border:2px solid var(--dc-border)}
  .dc-btn-outline:hover{border-color:var(--dc-accent);color:var(--dc-accent) !important;transform:translateY(-1px)}
  .dc-btn-white-outline{background:transparent;color:#ffffff !important;border:2px solid rgba(255,255,255,0.45)}
  .dc-btn-white-outline:hover{border-color:#fff;background:rgba(255,255,255,0.12);transform:translateY(-1px);color:#fff !important}
  .dc-btn-ghost-dark{background:rgba(255,255,255,0.1);color:#ffffff !important;border:1.5px solid rgba(255,255,255,0.3)}
  .dc-btn-ghost-dark:hover{background:rgba(255,255,255,0.18);border-color:rgba(255,255,255,0.55);color:#fff !important}
  .dc-btn-sm{padding:11px 24px;font-size:14px}
  /* Product card & sidebar CTAs — force white text */
  .dc-wrap .dc-product-card-cta{color:#ffffff !important}
  .dc-wrap .dc-product-card-cta:hover{color:#ffffff !important}
  .dc-wrap .dc-model-sidebar-cta{color:#ffffff !important}
  .dc-wrap .dc-model-sidebar-cta:hover{color:#ffffff !important}

  /* ---- SECTIONS ---- */
  .dc-section{padding:96px 0}
  .dc-section-alt{background:var(--dc-surface)}
  .dc-section-warm{background:var(--dc-surface-warm)}
  .dc-section-header{text-align:center;margin-bottom:64px}
  .dc-section-header .dc-eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:12px;letter-spacing:0.22em;text-transform:uppercase;color:var(--dc-accent);margin-bottom:16px;font-weight:700}
  .dc-section-header .dc-eyebrow::before{content:'';width:20px;height:2px;background:linear-gradient(90deg,var(--dc-accent),var(--dc-accent-warm));border-radius:2px}
  .dc-section-header h2{font-size:44px !important;margin-bottom:16px;letter-spacing:-0.02em}
  .dc-section-header p{font-size:18px;color:var(--dc-muted);max-width:700px;margin:0 auto;line-height:1.82}
  .dc-section-header.dc-left-align{text-align:left}
  .dc-section-header.dc-left-align p{margin:0}

  .dc-accent-heading::after{content:'';display:block;width:48px;height:3px;margin-top:12px;background:linear-gradient(90deg,var(--dc-accent),var(--dc-accent-warm));border-radius:4px}
  .dc-section-header .dc-accent-heading::after{margin-left:auto;margin-right:auto}
  .dc-section-header.dc-left-align .dc-accent-heading::after{margin-left:0}

  /* standalone eyebrow */
  .dc-eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:12px;letter-spacing:0.22em;text-transform:uppercase;color:var(--dc-accent);margin-bottom:16px;font-weight:700}
  .dc-eyebrow::before{content:'';width:20px;height:2px;background:linear-gradient(90deg,var(--dc-accent),var(--dc-accent-warm));border-radius:2px}

  /* ---- HERO ---- */
  .dc-hero{position:relative;min-height:94vh;display:flex;align-items:center;background:var(--dc-dark2);overflow:hidden}
  .dc-hero-bg{position:absolute;inset:0;background-size:cover;background-position:center 30%;opacity:0.42;z-index:0}
  .dc-hero-grain{position:absolute;inset:0;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.048'/%3E%3C/svg%3E");z-index:1;opacity:0.5;animation:dcGrainFloat 8s linear infinite;pointer-events:none}
  .dc-hero-overlay{position:absolute;inset:0;background:linear-gradient(115deg,rgba(8,6,3,0.92) 18%,rgba(15,10,5,0.68) 55%,rgba(40,25,8,0.30) 100%);z-index:2}
  .dc-hero-glow{position:absolute;width:700px;height:700px;border-radius:50%;background:radial-gradient(circle,rgba(138,107,58,0.10) 0%,transparent 70%);right:-150px;top:-100px;z-index:2;animation:dcShimmer 6s ease-in-out infinite}
  .dc-hero-stripe{position:absolute;left:0;bottom:0;width:100%;height:3px;background:linear-gradient(90deg,var(--dc-accent),var(--dc-accent-warm),transparent 70%);z-index:3}
  .dc-hero-content{position:relative;z-index:4;padding:80px 0 96px}
  .dc-hero-eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:12px;letter-spacing:0.22em;text-transform:uppercase;color:var(--dc-accent-warm);font-weight:700;margin-bottom:26px;background:rgba(138,107,58,0.09);padding:6px 16px;border-radius:50px;border:1px solid rgba(138,107,58,0.18)}
  .dc-hero-eyebrow::before{content:'●';font-size:7px;animation:dcPulseDot 2.8s infinite}
  .dc-hero h1{font-size:64px !important;color:#fff;max-width:820px;margin-bottom:26px;font-weight:700;line-height:1.07;letter-spacing:-0.025em;text-shadow:0 4px 32px rgba(0,0,0,0.35)}
  .dc-hero-tag{display:inline;background:linear-gradient(135deg,var(--dc-accent-warm),#d4a96a);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
  .dc-hero-sub{font-size:18px;color:rgba(255,255,255,0.74);max-width:620px;margin-bottom:10px;font-weight:400;line-height:1.75}
  .dc-hero-note{font-size:15px;color:rgba(255,255,255,0.42);max-width:560px;margin-bottom:42px;line-height:1.7}
  .dc-hero-ctas{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:56px}
  .dc-hero-stats{display:flex;gap:0;padding-top:40px;border-top:1px solid rgba(255,255,255,0.07);flex-wrap:wrap}
  .dc-hero-stat{padding-right:40px;margin-right:40px;border-right:1px solid rgba(255,255,255,0.07)}
  .dc-hero-stat:last-child{border-right:none;margin-right:0}
  .dc-hero-stat-num{font-size:30px;font-weight:900;color:#fff;display:block;line-height:1;margin-bottom:5px;background:linear-gradient(135deg,#fff,rgba(255,255,255,0.65));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;font-family:'Inter',sans-serif}
  .dc-hero-stat-label{font-size:12px;color:rgba(255,255,255,0.38);text-transform:uppercase;letter-spacing:0.13em;font-weight:600}

  /* ---- TRUST BAR ---- */
  .dc-trust-bar{background:var(--dc-surface);border-bottom:1px solid var(--dc-border-light);padding:44px 0}
  .dc-trust-bar-inner{display:flex;justify-content:center;align-items:center;flex-wrap:wrap}
  .dc-trust-item{display:flex;align-items:center;gap:14px;padding:8px 32px;transition:var(--dc-transition)}
  .dc-trust-item:hover{transform:translateY(-3px)}
  .dc-trust-icon{width:50px;height:50px;background:var(--dc-accent-light);border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:var(--dc-transition)}
  .dc-trust-item:hover .dc-trust-icon{background:var(--dc-accent)}
  .dc-trust-item:hover .dc-trust-icon svg{fill:#fff}
  .dc-trust-icon svg{width:23px;height:23px;fill:var(--dc-accent);transition:fill 0.3s}
  .dc-trust-text{display:flex;flex-direction:column}
  .dc-trust-text strong{font-size:15px;font-weight:700;color:var(--dc-dark);line-height:1.3}
  .dc-trust-text span{font-size:12px;color:var(--dc-light-text);line-height:1.4}
  .dc-trust-divider{width:1px;height:44px;background:var(--dc-border);flex-shrink:0}

  /* ---- PRODUCT CARDS ---- */
  .dc-product-cards-section{background:var(--dc-bg);padding:80px 0}
  .dc-product-cards-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:32px}
  .dc-product-card{background:var(--dc-white);border-radius:var(--dc-radius-xl);overflow:hidden;border:1px solid var(--dc-border);box-shadow:var(--dc-card-shadow);transition:var(--dc-transition);position:relative;display:flex;flex-direction:column}
  .dc-product-card:hover{transform:translateY(-7px);box-shadow:var(--dc-card-shadow-hover);border-color:rgba(138,107,58,0.18)}
  .dc-product-card-badge{position:absolute;top:14px;left:14px;z-index:2;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:0.14em;padding:5px 12px;border-radius:50px;background:var(--dc-dark);color:#fff}
  .dc-product-card-badge.sale{background:linear-gradient(135deg,var(--dc-accent),var(--dc-accent-warm))}
  .dc-product-card-img-wrap{background:var(--dc-surface);padding:32px 24px 16px;display:flex;align-items:center;justify-content:center;min-height:220px;overflow:hidden;border-bottom:1px solid var(--dc-border-light);text-decoration:none;cursor:pointer;display:flex}
  .dc-product-card-img-wrap img{width:100%;max-height:200px;object-fit:contain;mix-blend-mode:multiply;transition:transform 0.45s ease}
  .dc-product-card:hover .dc-product-card-img-wrap img{transform:scale(1.06)}
  .dc-product-card-body{padding:26px 28px;flex:1;display:flex;flex-direction:column}
  .dc-product-card-tier{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:0.18em;color:var(--dc-accent);margin-bottom:8px}
  .dc-product-card-title{font-size:18px;font-weight:700;color:var(--dc-dark);margin-bottom:8px;font-family:'Inter',sans-serif;line-height:1.3}
  .dc-product-card-tagline{font-size:14px;color:var(--dc-muted);line-height:1.7;margin-bottom:20px;flex:1}
  .dc-product-card-price-row{display:flex;align-items:baseline;gap:10px;margin-bottom:22px}
  .dc-product-card-price{font-size:26px;font-weight:900;color:var(--dc-dark);font-family:'Inter',sans-serif;line-height:1}
  .dc-product-card-was{font-size:13px;color:var(--dc-light-text);text-decoration:line-through}
  .dc-product-features{list-style:none;margin:0 0 20px;padding:0}
  .dc-product-features li{font-size:13px;color:var(--dc-muted);padding:4px 0;display:flex;align-items:flex-start;gap:8px;border-bottom:1px solid var(--dc-border-light);line-height:1.5}
  .dc-product-features li:last-child{border-bottom:none}
  .dc-product-features li::before{content:'•';color:var(--dc-accent);font-size:8px;margin-top:6px;flex-shrink:0}
  .dc-product-card-cta{display:block;background:var(--dc-dark);color:#fff;text-align:center;padding:14px;border-radius:var(--dc-radius-sm);font-size:14px;font-weight:700;transition:var(--dc-transition);letter-spacing:0.02em;text-decoration:none}
  .dc-product-card-cta:hover{background:var(--dc-accent);transform:translateY(-2px);box-shadow:var(--dc-shadow-walnut);color:#fff}
  .dc-product-card-sub{display:block;text-align:center;font-size:12px;color:var(--dc-light-text);margin-top:10px}
  @media(max-width:1100px){.dc-product-cards-grid{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:700px){.dc-product-cards-grid{grid-template-columns:1fr}}

  /* ---- INTRO ---- */
  .dc-intro-lead{font-size:21px;color:var(--dc-text);line-height:1.82;margin-bottom:44px;max-width:820px}
  .dc-intro-lead strong{color:var(--dc-dark);font-weight:700}
  .dc-intro-lead em{font-style:italic;color:var(--dc-accent)}
  .dc-intro-pillars{display:grid;grid-template-columns:repeat(3,1fr);gap:36px}
  .dc-intro-pillar{padding:30px 26px;border-left:3px solid var(--dc-accent);background:linear-gradient(135deg,var(--dc-accent-light),transparent);border-radius:0 var(--dc-radius-sm) var(--dc-radius-sm) 0}
  .dc-intro-pillar h3{font-size:16px !important;font-family:'Inter',sans-serif;font-weight:700;margin-bottom:8px;color:var(--dc-dark)}
  .dc-intro-pillar p{font-size:14px;color:var(--dc-muted);line-height:1.72;margin:0}

  /* ---- QUICK ANSWER ---- */
  .dc-quick-answer{background:linear-gradient(145deg,#0f0c08 0%,#1e1509 100%);border-radius:var(--dc-radius-xl);padding:56px;border:1px solid rgba(138,107,58,0.14);position:relative;overflow:hidden}
  .dc-quick-answer::before{content:'';position:absolute;width:400px;height:400px;border-radius:50%;background:radial-gradient(circle,rgba(138,107,58,0.08) 0%,transparent 70%);right:-100px;bottom:-100px;pointer-events:none}
  .dc-quick-answer h2{color:#fff;margin-bottom:8px;font-size:32px !important}
  .dc-qa-intro{color:rgba(255,255,255,0.52);font-size:16px;max-width:600px;margin-bottom:40px;line-height:1.78}
  .dc-qa-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:22px}
  .dc-qa-item{background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.07);border-radius:var(--dc-radius);padding:26px;transition:var(--dc-transition)}
  .dc-qa-item:hover{background:rgba(138,107,58,0.06);border-color:rgba(138,107,58,0.18);transform:translateY(-2px)}
  .dc-qa-item h3{color:var(--dc-accent-warm);font-size:13px;text-transform:uppercase;letter-spacing:0.15em;margin-bottom:12px;font-weight:800;font-family:'Inter',sans-serif}
  .dc-qa-item p{font-size:15px;color:rgba(255,255,255,0.65);line-height:1.82;margin:0}

  /* ---- PILLAR CARDS ---- */
  .dc-pillar-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:26px}
  .dc-pillar-card{background:var(--dc-white);border:1px solid var(--dc-border);border-radius:var(--dc-radius-lg);padding:34px;transition:var(--dc-transition);position:relative;overflow:hidden}
  .dc-pillar-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--dc-accent),var(--dc-accent-warm));transform:scaleX(0);transform-origin:left;transition:transform 0.32s}
  .dc-pillar-card:hover::before{transform:scaleX(1)}
  .dc-pillar-card:hover{transform:translateY(-5px);box-shadow:var(--dc-card-shadow-hover);border-color:transparent}
  .dc-pillar-icon{width:52px;height:52px;background:var(--dc-accent-light);border-radius:15px;display:flex;align-items:center;justify-content:center;margin-bottom:18px;transition:var(--dc-transition)}
  .dc-pillar-card:hover .dc-pillar-icon{background:linear-gradient(135deg,var(--dc-accent),var(--dc-accent-warm))}
  .dc-pillar-icon svg{width:24px;height:24px;fill:var(--dc-accent);transition:fill 0.3s}
  .dc-pillar-card:hover .dc-pillar-icon svg{fill:#fff}
  .dc-pillar-card h3{font-size:16px;margin-bottom:10px;font-family:'Inter',sans-serif;color:var(--dc-dark)}
  .dc-pillar-card p{font-size:14px;color:var(--dc-muted);margin:0;line-height:1.75}

  /* ---- EXPERIENCE GRID ---- */
  .dc-exp-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:0}
  .dc-exp-panel{padding:48px;border-right:1px solid var(--dc-border-light);border-bottom:1px solid var(--dc-border-light);transition:var(--dc-transition)}
  .dc-exp-panel:nth-child(even){border-right:none}
  .dc-exp-panel:nth-child(n+5){border-bottom:none}
  .dc-exp-panel:hover{background:var(--dc-surface)}
  .dc-exp-num{font-size:11px;font-weight:800;letter-spacing:0.2em;color:var(--dc-accent);margin-bottom:14px}
  .dc-exp-panel h3{font-size:18px;font-family:'Playfair Display',serif;font-weight:600;margin-bottom:12px;color:var(--dc-dark)}
  .dc-exp-panel p{font-size:14px;color:var(--dc-muted);line-height:1.78;margin:0}

  /* ---- MODEL SPOTLIGHT ---- */
  .dc-model-spotlight{border-radius:var(--dc-radius-xl);overflow:hidden;border:1px solid var(--dc-border);background:var(--dc-white);margin-bottom:48px;transition:box-shadow 0.38s;box-shadow:var(--dc-card-shadow)}
  .dc-model-spotlight:hover{box-shadow:var(--dc-card-shadow-hover)}
  .dc-model-spotlight-header{background:linear-gradient(160deg,#0e0b07 0%,#1d150a 100%);padding:44px 52px;position:relative;overflow:hidden}
  .dc-model-spotlight-header::after{content:'';position:absolute;width:320px;height:320px;border-radius:50%;background:radial-gradient(circle,rgba(138,107,58,0.09) 0%,transparent 70%);right:-80px;top:-80px;pointer-events:none}
  .dc-model-spotlight-header::before{content:'';position:absolute;bottom:0;left:0;width:100%;height:2px;background:linear-gradient(90deg,var(--dc-accent),var(--dc-accent-warm),transparent 80%)}
  .dc-model-tier-label{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:0.2em;color:var(--dc-accent-warm);margin-bottom:8px;display:inline-flex;align-items:center;gap:8px}
  .dc-model-tier-label::before{content:'';width:16px;height:2px;background:var(--dc-accent);border-radius:2px}
  .dc-model-spotlight-header h2{color:#fff;font-size:36px !important;margin-bottom:10px;letter-spacing:-0.02em}
  .dc-model-tagline{color:rgba(255,255,255,0.52);font-size:16px !important;max-width:600px;line-height:1.72;margin:0}

  .dc-model-spotlight-body{display:grid;grid-template-columns:370px 1fr;gap:0}
  .dc-model-sidebar{background:var(--dc-surface);padding:38px;display:flex;flex-direction:column;border-right:1px solid var(--dc-border-light)}
  .dc-model-sidebar-imgbox{background:var(--dc-white);border-radius:var(--dc-radius);padding:32px 24px;margin-bottom:24px;overflow:hidden;display:flex;align-items:center;justify-content:center;min-height:240px;border:1px solid var(--dc-border-light);text-decoration:none;cursor:pointer}
  .dc-model-sidebar-imgbox img{width:100%;max-height:260px;object-fit:contain;mix-blend-mode:multiply;transition:transform 0.42s ease}
  .dc-model-spotlight:hover .dc-model-sidebar-imgbox img{transform:scale(1.04)}
  .dc-model-price-tag{font-size:26px;font-weight:900;color:var(--dc-dark);font-family:'Inter',sans-serif;margin-bottom:4px;line-height:1}
  .dc-model-price-note{font-size:13px;color:var(--dc-light-text);margin-bottom:20px;line-height:1.5}
  .dc-model-price-note s{color:var(--dc-light-text);text-decoration:line-through}
  .dc-model-sidebar-cta{display:block;text-align:center;background:var(--dc-dark);color:#fff;padding:13px;border-radius:var(--dc-radius-sm);font-size:14px;font-weight:700;transition:var(--dc-transition);letter-spacing:0.02em;margin-bottom:12px;text-decoration:none}
  .dc-model-sidebar-cta:hover{background:var(--dc-accent);transform:translateY(-2px);box-shadow:var(--dc-shadow-walnut);color:#fff}
  .dc-model-sidebar-link{display:block;text-align:center;color:var(--dc-muted);font-size:13px;font-weight:600;transition:color 0.2s;text-decoration:none}
  .dc-model-sidebar-link:hover{color:var(--dc-accent)}

  .dc-model-content{padding:38px 46px}
  .dc-model-best-for{display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:0.13em;color:var(--dc-accent);background:var(--dc-accent-light);padding:5px 13px;border-radius:50px;margin-bottom:20px;border:1px solid rgba(138,107,58,0.18)}
  .dc-model-content h3{font-size:18px;margin-bottom:12px;font-family:'Inter',sans-serif;color:var(--dc-dark)}
  .dc-model-content p{font-size:15px;color:var(--dc-muted);line-height:1.86;margin-bottom:16px}
  .dc-model-traits{display:flex;gap:8px;flex-wrap:wrap;margin-top:20px}
  .dc-trait-pill{font-size:12px;font-weight:700;padding:5px 12px;border-radius:20px;background:var(--dc-surface);border:1px solid var(--dc-border);color:var(--dc-muted);transition:var(--dc-transition)}
  .dc-trait-pill:hover{background:var(--dc-accent-light);border-color:var(--dc-accent);color:var(--dc-accent)}
  .dc-model-feature-list{list-style:none;margin:16px 0 0;padding:0}
  .dc-model-feature-list li{display:flex;align-items:flex-start;gap:10px;font-size:14px;color:var(--dc-muted);padding:6px 0;border-bottom:1px solid var(--dc-border-light);line-height:1.6}
  .dc-model-feature-list li:last-child{border-bottom:none}
  .dc-model-feature-list li::before{content:'•';color:var(--dc-accent);font-size:9px;margin-top:5px;flex-shrink:0}

  /* ---- COMPARISON TABLE ---- */
  .dc-compare-wrap{overflow-x:auto;border-radius:var(--dc-radius-lg);border:1px solid var(--dc-border);box-shadow:var(--dc-card-shadow)}
  .dc-compare-table{width:100%;border-collapse:collapse;font-size:14px;min-width:680px}
  .dc-compare-table th{background:var(--dc-dark);color:#fff;padding:16px 20px;text-align:left;font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:0.07em}
  .dc-compare-table th:first-child{background:#0f0d0a}
  .dc-compare-table td{padding:14px 20px;border-bottom:1px solid var(--dc-border);color:var(--dc-muted);vertical-align:middle}
  .dc-compare-table tr:last-child td{border-bottom:none}
  .dc-compare-table tr:hover td{background:var(--dc-surface)}
  .dc-compare-table .dc-col-feat{font-weight:700;color:var(--dc-dark);white-space:nowrap}
  .dc-highlight-col{background:rgba(138,107,58,0.04)}
  .dc-check{color:var(--dc-accent);font-weight:800}
  .dc-cross{color:#d4d0ca}

  /* ---- BUYER CARDS ---- */
  .dc-buyer-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:26px}
  .dc-buyer-card{background:var(--dc-white);border:1px solid var(--dc-border);border-radius:var(--dc-radius-lg);padding:34px;transition:var(--dc-transition);position:relative;overflow:hidden}
  .dc-buyer-card::after{content:'';position:absolute;bottom:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--dc-accent),var(--dc-accent-warm));transform:scaleX(0);transform-origin:left;transition:transform 0.3s}
  .dc-buyer-card:hover::after{transform:scaleX(1)}
  .dc-buyer-card:hover{border-color:rgba(138,107,58,0.22);box-shadow:var(--dc-card-shadow-hover);transform:translateY(-4px)}
  .dc-buyer-icon{width:50px;height:50px;background:var(--dc-accent-light);border-radius:14px;display:flex;align-items:center;justify-content:center;margin-bottom:20px;transition:var(--dc-transition)}
  .dc-buyer-card:hover .dc-buyer-icon{background:var(--dc-accent)}
  .dc-buyer-icon svg{width:24px;height:24px;fill:var(--dc-accent);transition:fill 0.3s}
  .dc-buyer-card:hover .dc-buyer-icon svg{fill:#fff}
  .dc-buyer-card h3{font-size:16px;margin-bottom:8px;font-family:'Inter',sans-serif;color:var(--dc-dark)}
  .dc-buyer-card p{font-size:14px;color:var(--dc-muted);margin:0;line-height:1.75}
  .dc-buyer-rec{display:flex;align-items:center;gap:6px;margin-top:16px;font-size:12px;font-weight:800;color:var(--dc-accent)}
  .dc-buyer-rec::before{content:'→'}

  /* ---- WHY BUY HERE ---- */
  .dc-trust-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:30px}
  .dc-trust-card{background:var(--dc-white);border:1px solid var(--dc-border);border-radius:var(--dc-radius-lg);padding:32px;transition:var(--dc-transition)}
  .dc-trust-card:hover{transform:translateY(-5px);box-shadow:var(--dc-card-shadow-hover);border-color:rgba(138,107,58,0.2)}
  .dc-trust-card-icon{width:50px;height:50px;background:var(--dc-accent-light);border-radius:14px;display:flex;align-items:center;justify-content:center;margin-bottom:20px;transition:var(--dc-transition)}
  .dc-trust-card:hover .dc-trust-card-icon{background:linear-gradient(135deg,var(--dc-accent),var(--dc-accent-warm))}
  .dc-trust-card-icon svg{width:24px;height:24px;fill:var(--dc-accent);transition:fill 0.3s}
  .dc-trust-card:hover .dc-trust-card-icon svg{fill:#fff}
  .dc-trust-card h3{font-size:16px;margin-bottom:10px;font-family:'Inter',sans-serif;color:var(--dc-dark)}
  .dc-trust-card p{font-size:14px;color:var(--dc-muted);margin:0;line-height:1.75}

  /* ---- TESTIMONIALS ---- */
  .dc-testimonials-strip{display:grid;grid-template-columns:repeat(3,1fr);gap:26px}
  .dc-testimonial-card{background:var(--dc-white);border:1px solid var(--dc-border);border-radius:var(--dc-radius-lg);padding:32px;transition:var(--dc-transition);position:relative}
  .dc-testimonial-card::before{content:'"';position:absolute;top:20px;right:24px;font-size:60px;font-family:'Playfair Display',serif;color:var(--dc-border);line-height:1}
  .dc-testimonial-card:hover{box-shadow:var(--dc-card-shadow-hover);transform:translateY(-3px)}
  .dc-testimonial-card p{font-size:15px;color:var(--dc-muted);line-height:1.8;margin-bottom:16px;font-style:italic}
  .dc-testimonial-meta{font-size:12px;font-weight:700;color:var(--dc-accent);text-transform:uppercase;letter-spacing:0.12em}
  .dc-stars{color:var(--dc-accent-warm);font-size:14px;margin-bottom:12px}

  /* ---- FAQ ---- */
  .dc-faq-list{border-top:1px solid var(--dc-border)}
  .dc-faq-item{border-bottom:1px solid var(--dc-border)}
  .dc-faq-q{display:flex;justify-content:space-between;align-items:center;padding:24px 0;cursor:pointer;gap:16px;user-select:none}
  .dc-faq-q h3{font-size:16px !important;font-family:'Inter',sans-serif;font-weight:700;margin:0;flex:1;line-height:1.4;transition:color 0.2s;color:var(--dc-dark)}
  .dc-faq-q:hover h3{color:var(--dc-accent)}
  .dc-faq-toggle{width:36px;height:36px;border-radius:50%;background:var(--dc-surface);display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:300;color:var(--dc-accent);flex-shrink:0;transition:var(--dc-transition)}
  .dc-faq-item.open .dc-faq-toggle{background:var(--dc-accent);color:#fff;transform:rotate(45deg)}
  .dc-faq-a{max-height:0;overflow:hidden;transition:max-height 0.38s cubic-bezier(0.4,0,0.2,1)}
  .dc-faq-a-inner{padding:0 0 28px}
  .dc-faq-a-inner p{font-size:16px;color:var(--dc-muted);line-height:1.87;margin:0}

  /* ---- FEATURES VISUAL ---- */
  .dc-features-visual-img{width:100%;border-radius:var(--dc-radius-xl);overflow:hidden;box-shadow:0 24px 80px rgba(0,0,0,0.13);display:block;border:1px solid var(--dc-border)}

  /* ---- FINAL CTA ---- */
  .dc-final-cta{background:linear-gradient(160deg,#0e0b07 0%,#1d150a 100%);border-radius:var(--dc-radius-xl);padding:80px 64px;color:#fff;position:relative;overflow:hidden;text-align:center}
  .dc-final-cta::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--dc-accent),var(--dc-accent-warm),var(--dc-accent));background-size:200% 100%;animation:dcGradientShift 5s ease infinite}
  .dc-final-cta::after{content:'';position:absolute;width:500px;height:500px;background:radial-gradient(circle,rgba(138,107,58,0.08) 0%,transparent 70%);bottom:-200px;right:-100px;pointer-events:none}
  .dc-final-cta .dc-eyebrow{color:var(--dc-accent-warm)}
  .dc-final-cta h2{color:#fff;font-size:40px !important;margin-bottom:16px;line-height:1.15}
  .dc-final-cta p{color:rgba(255,255,255,0.62);font-size:16px !important;max-width:680px;margin:0 auto 40px;line-height:1.82}
  .dc-final-cta-btns{display:flex;flex-wrap:wrap;gap:16px;justify-content:center}

  /* ---- SUPPORT BAR ---- */
  .dc-support-bar{background:var(--dc-white);padding:64px 0;border-top:1px solid var(--dc-border-light);border-bottom:1px solid var(--dc-border-light)}
  .dc-support-bar-inner{display:flex;justify-content:center;align-items:center;flex-wrap:wrap}
  .dc-support-item{display:flex;align-items:center;gap:16px;padding:8px 40px;transition:var(--dc-transition)}
  .dc-support-item:hover{transform:translateY(-3px)}
  .dc-support-icon{width:52px;height:52px;background:var(--dc-accent-light);border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:var(--dc-transition)}
  .dc-support-item:hover .dc-support-icon{background:var(--dc-accent)}
  .dc-support-item:hover .dc-support-icon svg{fill:#fff}
  .dc-support-icon svg{width:24px;height:24px;fill:var(--dc-accent);transition:fill 0.3s}
  .dc-support-text{display:flex;flex-direction:column}
  .dc-support-text strong{font-size:15px;font-weight:700;color:var(--dc-dark);line-height:1.3}
  .dc-support-text span{font-size:13px;color:var(--dc-light-text)}
  .dc-support-divider{width:1px;height:48px;background:var(--dc-border);flex-shrink:0}

  .dc-grad-divider{height:1px;background:linear-gradient(90deg,transparent,var(--dc-border),transparent)}
  .dc-walnut-band{height:4px;background:linear-gradient(90deg,var(--dc-accent-walnut),var(--dc-accent),var(--dc-accent-warm),var(--dc-accent),transparent);opacity:0.5}

  /* ---- RESPONSIVE ---- */
  @media(max-width:1100px){
    .dc-pillar-grid{grid-template-columns:repeat(2,1fr)}
    .dc-buyer-grid{grid-template-columns:repeat(2,1fr)}
    .dc-model-spotlight-body{grid-template-columns:1fr}
    .dc-model-sidebar{border-right:none;border-bottom:1px solid var(--dc-border-light)}
    .dc-testimonials-strip{grid-template-columns:1fr;gap:16px}
    .dc-trust-grid{grid-template-columns:repeat(2,1fr)}
    .dc-exp-grid{grid-template-columns:1fr}
    .dc-exp-panel{border-right:none}
  }
  @media(max-width:900px){
    .dc-qa-grid,.dc-pillar-grid,.dc-trust-grid,.dc-buyer-grid,.dc-intro-pillars{grid-template-columns:1fr}
    .dc-hero-stats{gap:24px}
    .dc-hero-stat{padding-right:24px;margin-right:24px}
  }
  @media(max-width:768px){
    .dc-hero{min-height:78vh}
    .dc-hero-content{padding:48px 0 64px}
    .dc-hero h1{font-size:34px}
    .dc-section{padding:64px 0}
    .dc-section-header{margin-bottom:40px}
    .dc-model-spotlight-header{padding:32px 24px}
    .dc-model-content{padding:32px 24px}
    .dc-model-sidebar{padding:32px 24px}
    .dc-quick-answer{padding:32px 24px}
    .dc-final-cta{padding:48px 32px}
    .dc-support-bar-inner{flex-direction:column;gap:24px;align-items:flex-start;padding:0 20px}
    .dc-support-divider{width:100%;height:1px}
    .dc-support-item{padding:0}
    .dc-container{padding:0 20px}
    .dc-exp-panel{padding:32px 24px}
  }
  @media(max-width:480px){
    .dc-hero-ctas,.dc-final-cta-btns{flex-direction:column;align-items:center}
    .dc-btn{padding:14px 28px;font-size:14px}
  }
</style>

