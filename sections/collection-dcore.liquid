<script>
/* ========================================================
   DYNAMIC PRODUCT DATA — Shopify /products/[handle].js API
   ======================================================== */
function dcFormatPrice(cents) {
  return '$' + (cents / 100).toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
}

function dcLoadProduct(handle, config) {
  fetch('/products/' + handle + '.js')
    .then(function(r) { return r.ok ? r.json() : Promise.reject(); })
    .then(function(data) {
      if (!data) return;
      var imgEl = document.getElementById(config.imgId);
      if (imgEl && data.featured_image) { imgEl.src = 'https:' + data.featured_image; imgEl.alt = data.title; }
      var priceEl = document.getElementById(config.priceId);
      if (priceEl && data.price) { priceEl.textContent = dcFormatPrice(data.price); }
      var compareEl = document.getElementById(config.compareId);
      if (compareEl && data.compare_at_price && data.compare_at_price > data.price) {
        var s = compareEl.querySelector('s');
        if (s) { s.textContent = dcFormatPrice(data.compare_at_price); }
      }
      var tableEl = document.getElementById(config.tableId);
      if (tableEl && data.price) { tableEl.textContent = dcFormatPrice(data.price); }
    })
    .catch(function() {});
}

function dcLoadCard(handle, config) {
  fetch('/products/' + handle + '.js')
    .then(function(r) { return r.ok ? r.json() : Promise.reject(); })
    .then(function(data) {
      if (!data) return;
      var imgEl = document.getElementById(config.imgId);
      if (imgEl && data.featured_image) { imgEl.src = 'https:' + data.featured_image; imgEl.alt = data.title; }
      var priceEl = document.getElementById(config.priceId);
      if (priceEl && data.price) { priceEl.textContent = dcFormatPrice(data.price); }
      var wasEl = document.getElementById(config.wasId);
      if (wasEl && data.compare_at_price && data.compare_at_price > data.price) {
        wasEl.textContent = dcFormatPrice(data.compare_at_price);
      } else if (wasEl) { wasEl.style.display = 'none'; }
    })
    .catch(function() {});
}

document.addEventListener('DOMContentLoaded', function() {
  dcLoadProduct('d-core-stratus-jp-massage-chair', { imgId:'dc-stratus-img', priceId:'dc-stratus-price', compareId:'dc-stratus-compare', tableId:'dc-table-stratus-price' });
  dcLoadProduct('d-core-cirrus-jp-massage-chair', { imgId:'dc-cirrus-img', priceId:'dc-cirrus-price', compareId:'dc-cirrus-compare', tableId:'dc-table-cirrus-price' });
  dcLoadProduct('d-core-2-massage-chair', { imgId:'dc-dcore2-img', priceId:'dc-dcore2-price', compareId:'dc-dcore2-compare', tableId:'dc-table-dcore2-price' });
  dcLoadCard('d-core-stratus-jp-massage-chair', { imgId:'dc-pc-stratus-img', priceId:'dc-pc-stratus-price', wasId:'dc-pc-stratus-was' });
  dcLoadCard('d-core-cirrus-jp-massage-chair', { imgId:'dc-pc-cirrus-img', priceId:'dc-pc-cirrus-price', wasId:'dc-pc-cirrus-was' });
  dcLoadCard('d-core-2-massage-chair', { imgId:'dc-pc-dcore2-img', priceId:'dc-pc-dcore2-price', wasId:'dc-pc-dcore2-was' });
});

/* ---- FAQ ACCORDION ---- */
function dcToggleFaq(el) {
  var item = el.closest('.dc-faq-item');
  var answer = item.querySelector('.dc-faq-a');
  var isOpen = item.classList.contains('open');
  document.querySelectorAll('.dc-faq-item.open').forEach(function(o) {
    o.classList.remove('open');
    o.querySelector('.dc-faq-a').style.maxHeight = '0';
  });
  if (!isOpen) {
    item.classList.add('open');
    answer.style.maxHeight = answer.scrollHeight + 'px';
  }
}

/* ---- SUBNAV ACTIVE STATE ---- */
var dcSubnavLinks = document.querySelectorAll('.dc-subnav-inner a');
var dcSections = document.querySelectorAll('section[id], div[id]');
var dcObserver = new IntersectionObserver(function(entries) {
  entries.forEach(function(entry) {
    if (entry.isIntersecting) {
      dcSubnavLinks.forEach(function(link) {
        link.classList.remove('active');
        if (link.getAttribute('href') === '#' + entry.target.id) { link.classList.add('active'); }
      });
    }
  });
}, { root: null, rootMargin: '-80px 0px -60% 0px', threshold: 0 });
dcSections.forEach(function(s) { dcObserver.observe(s); });

/* ---- SCROLL ANIMATIONS ---- */
var dcFadeEls = document.querySelectorAll('.dc-pillar-card, .dc-buyer-card, .dc-trust-card, .dc-testimonial-card, .dc-model-spotlight, .dc-exp-panel');
var dcScrollObs = new IntersectionObserver(function(entries) {
  entries.forEach(function(entry) {
    if (entry.isIntersecting) {
      entry.target.style.opacity = '1';
      entry.target.style.transform = 'translateY(0)';
      dcScrollObs.unobserve(entry.target);
    }
  });
}, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
dcFadeEls.forEach(function(el) {
  el.style.opacity = '0';
  el.style.transform = 'translateY(20px)';
  el.style.transition = 'opacity 0.55s ease, transform 0.55s ease';
  dcScrollObs.observe(el);
});
</script>

