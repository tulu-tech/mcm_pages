  font-size: 12px;
  font-weight: 950;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.dtm__diagram-label--man1 {
  border-color: rgba(81, 108, 99, 0.25);
  background: #eef4ef;
  color: var(--dtm-sage-dark);
}

.dtm__diagram-micro {
  color: var(--dtm-muted);
  font-size: 12px;
  font-weight: 900;
}

.dtm__diagram-stage {
  position: relative;
  height: clamp(330px, 38vw, 500px);
  margin: 0 20px;
  overflow: hidden;
}

.dtm__diagram-stage img {
  position: absolute;
  inset: 50% auto auto 50%;
  width: 88%;
  height: 86%;
  transform: translate(-50%, -50%);
  object-fit: contain;
  filter: drop-shadow(0 18px 24px rgba(21, 21, 21, 0.16));
}

.dtm__diagram-stage--wide img {
  width: 96%;
  height: 92%;
}

.dtm__diagram-overlay {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.dtm__visual-path {
  fill: none;
  stroke-width: 9;
  stroke-linecap: round;
  opacity: 0.74;
}

.dtm__visual-path--gold {
  stroke: #c5a45c;
}

.dtm__visual-path--sage {
  stroke: #647b70;
}

.dtm__visual-dot {
  stroke: rgba(255, 255, 255, 0.9);
  stroke-width: 8;
}

.dtm__visual-dot--gold {
  fill: #c5a45c;
}

.dtm__visual-dot--sage {
  fill: #647b70;
}

.dtm__visual-ring {
  fill: none;
  stroke-width: 4;
  opacity: 0.35;
}

.dtm__visual-ring--gold {
  stroke: #c5a45c;
}

.dtm__visual-ring--sage {
  stroke: #647b70;
}

.dtm__floating-callout {
  position: absolute;
  z-index: 2;
  max-width: 190px;
  padding: 10px 12px;
  border: 1px solid rgba(222, 216, 204, 0.9);
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.9);
  color: var(--dtm-ink);
  font-size: 12px;
  font-weight: 900;
  line-height: 1.35;
  box-shadow: 0 10px 26px rgba(21, 21, 21, 0.08);
}

.dtm__floating-callout small {
  display: block;
  margin-top: 3px;
  color: var(--dtm-muted);
  font-weight: 700;
}

.dtm__callout--top-left { left: 18px; top: 46px; }
.dtm__callout--top-right { right: 18px; top: 46px; }
.dtm__callout--mid-left { left: 18px; top: 44%; }
.dtm__callout--mid-right { right: 18px; top: 44%; }
.dtm__callout--bottom-left { left: 18px; bottom: 34px; }
.dtm__callout--bottom-right { right: 18px; bottom: 34px; }

.dtm__diagram-caption {
  margin: 0 22px 22px;
  padding: 16px 18px;
  border: 1px solid rgba(222, 216, 204, 0.9);
  border-radius: 8px;
  background: #fbfaf7;
}

.dtm__diagram-caption h3 {
  margin: 0;
  color: var(--dtm-ink);
  font-family: Georgia, "Times New Roman", serif;
  font-size: 22px;
  line-height: 1.14;
}

.dtm__diagram-caption p {
  margin-top: 4px;
  color: var(--dtm-muted);
  font-size: 14px;
  line-height: 1.55;
}

.dtm__insight-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
  margin-top: 18px;
}

.dtm__insight {
  padding: 20px 22px;
  border: 1px solid var(--dtm-line);
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.72);
}

.dtm__insight span {
  display: block;
  margin-bottom: 8px;
  color: var(--dtm-gold);
  font-size: 11px;
  font-weight: 950;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.dtm__insight h3 {
  margin: 0;
  color: var(--dtm-ink);
  font-size: 23px;
  line-height: 1.2;
}

.dtm__insight ul {
  display: grid;
  gap: 9px;
  margin-top: 14px;
  padding-left: 18px;
}

.dtm__visual-pill-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 16px;
}

.dtm__visual-pill {
  display: inline-flex;
  align-items: center;
  min-height: 30px;
  padding: 7px 10px;
  border-radius: 999px;
  background: rgba(167, 126, 67, 0.1);
  color: var(--dtm-ink);
  font-size: 12px;
  font-weight: 850;
}

.dtm__visual-pill--sage {
  background: rgba(81, 108, 99, 0.12);
}

.dtm__demo-question {
  margin-top: 20px;
  padding: 18px 20px;
  border-left: 4px solid var(--dtm-gold);
  background: rgba(255, 255, 255, 0.64);
  color: var(--dtm-ink);
  font-weight: 850;
}

.dtm__navrail {
  position: sticky;
  top: 0;
  z-index: 20;
  border-bottom: 1px solid var(--dtm-line);
  background: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(12px);
}

.dtm__navrail-inner {
  display: flex;
  gap: 6px;
  overflow-x: auto;
  padding: 10px 0;
  scrollbar-width: none;
}

.dtm__navrail-inner::-webkit-scrollbar {
  display: none;
}

.dtm__navrail a {
  flex: 0 0 auto;
  padding: 9px 12px;
  border-radius: 999px;
  color: var(--dtm-ink);
  font-size: 13px;
  font-weight: 850;
}

.dtm__navrail a:hover {
  background: var(--dtm-linen);
}

.dtm__grid-2 {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22px;
}

.dtm__grid-3 {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.dtm__card,
.dtm__product-card,
.dtm__scenario,
.dtm__reaction,
.dtm__feature,
.dtm__price-card,
.dtm__matrix-item,
.dtm__stat {
  border: 1px solid var(--dtm-line);
  border-radius: var(--dtm-radius);
  background: #ffffff;
  box-shadow: 0 10px 28px rgba(21, 21, 21, 0.07);
}

.dtm__card {
  padding: clamp(22px, 3vw, 34px);
}

.dtm__kicker {
  display: block;
  margin-bottom: 10px;
  color: var(--dtm-gold);
  font-size: 12px;
  font-weight: 900;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.dtm__card h3,
.dtm__product-card h3,
.dtm__scenario h3,
.dtm__feature h3,
.dtm__price-card h3,
.dtm__home-copy h3,
.dtm__feel-copy h3 {
  margin: 0;
  color: var(--dtm-ink);
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(23px, 2.3vw, 32px);
  line-height: 1.14;
}

.dtm__checks {
  display: grid;
  gap: 11px;
  margin-top: 18px;
  list-style: none;
}

.dtm__checks li {
  position: relative;
  padding-left: 30px;
}

.dtm__checks li::before {
  content: "";
  position: absolute;
  left: 0;
  top: 7px;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: var(--dtm-sage);
  box-shadow: inset 0 0 0 5px #ffffff, 0 0 0 1px rgba(81, 108, 99, 0.32);
}

.dtm__checks--gold li::before {
  background: var(--dtm-gold);
}

.dtm__summary-line,
.dtm__note,
.dtm__interpretation {
  margin-top: 24px;
  padding: 22px;
  border: 1px solid var(--dtm-line);
  border-radius: var(--dtm-radius);
  background: linear-gradient(135deg, #ffffff, #f5f1e9);
}

.dtm__product-card {
  overflow: hidden;
}

.dtm__product-media {
  min-height: 360px;
  background: transparent;
  display: grid;
  place-items: center;
  padding: 28px;
}

.dtm__product-media img {
  width: 100%;
  height: 320px;
  object-fit: contain;
  filter: drop-shadow(0 16px 22px rgba(21, 21, 21, 0.15));
}

.dtm__product-body {
  padding: 28px;
}

.dtm__price-row {
  display: flex;
  align-items: baseline;
  gap: 12px;
  margin-top: 18px;
}

.dtm__old {
  color: var(--dtm-muted);
  font-size: 20px;
  text-decoration: line-through;
}

.dtm__new {
  color: var(--dtm-ink);
  font-size: 34px;
  font-weight: 950;
}

.dtm__micro {
  margin-top: 6px !important;
  color: var(--dtm-muted) !important;
  font-size: 13px !important;
}

.dtm__chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 18px;
}

.dtm__chip {
  display: inline-flex;
  align-items: center;
  min-height: 31px;
  padding: 6px 10px;
  border: 1px solid var(--dtm-line);
  border-radius: 999px;
  background: #fbfaf7;
  color: var(--dtm-ink-soft);
  font-size: 12px;
  font-weight: 800;
}

.dtm__table-scroll {
  overflow-x: auto;
  border: 1px solid var(--dtm-line);
  border-radius: var(--dtm-radius);
  background: #ffffff;
  box-shadow: var(--dtm-shadow);
}

.dtm__table {
  width: 100%;
  min-width: 980px;
  border-collapse: collapse;
}

.dtm__table th,
.dtm__table td {
  padding: 17px 18px;
  border-bottom: 1px solid var(--dtm-line);
  border-right: 1px solid var(--dtm-line);
  text-align: left;
  vertical-align: top;
  font-size: 14px;
  line-height: 1.55;
}

.dtm__table th {
  position: sticky;
  top: 0;
  z-index: 1;
  background: #171817;
  color: #ffffff;
  font-size: 13px;
  font-weight: 950;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.dtm__table td:first-child {
  width: 210px;
  color: var(--dtm-ink);
  font-weight: 900;
}

.dtm__table tr:last-child td {
  border-bottom: 0;
}

.dtm__table a {
  color: var(--dtm-sage-dark);
  font-weight: 900;
  text-decoration: underline;
  text-underline-offset: 3px;
}

.dtm__matrix {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
}

.dtm__matrix-item {
  padding: 20px;
}

.dtm__matrix-item span {
  color: var(--dtm-copper);
  font-size: 12px;
  font-weight: 950;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.dtm__matrix-item strong {
  display: block;
  margin-top: 8px;
  font-size: 24px;
}

.dtm__meter {
  height: 9px;
  margin-top: 16px;
  overflow: hidden;
  border-radius: 999px;
  background: #e8e2d7;
}

.dtm__meter i {
  display: block;
  height: 100%;
  width: var(--value);
  border-radius: inherit;
  background: linear-gradient(90deg, var(--dtm-sage), var(--dtm-gold));
}

.dtm__zone-map {
  display: grid;
  grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
  gap: 28px;
  align-items: center;
}

.dtm__body-zones {
  position: relative;
  min-height: 500px;
  border-radius: 8px;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.09), rgba(255, 255, 255, 0.02)),
    #171817;
  overflow: hidden;
}

.dtm__body-zones::before {
  content: "";
  position: absolute;
  inset: 42px 50% auto;
  width: 96px;
  height: 380px;
  transform: translateX(-50%);
  border: 2px solid rgba(230, 198, 125, 0.68);
  border-radius: 50px 50px 60px 60px;
  background: linear-gradient(180deg, rgba(81, 108, 99, 0.4), rgba(167, 126, 67, 0.16));
}

.dtm__body-zones::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 92px;
  width: 42px;
  height: 42px;
  transform: translateX(-50%);
  border: 2px solid rgba(230, 198, 125, 0.7);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.dtm__zone {
  position: absolute;
  display: grid;
  gap: 3px;
  max-width: 190px;
  padding: 11px 13px;
  border: 1px solid rgba(255, 255, 255, 0.16);
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.08);
  color: #ffffff;
  backdrop-filter: blur(10px);
}

.dtm__zone b {
  color: #ffffff;
  font-size: 14px;
}

.dtm__zone small {
  color: rgba(255, 255, 255, 0.68);
  font-size: 12px;
  line-height: 1.4;
}

.dtm__zone--neck { left: 30px; top: 70px; }
.dtm__zone--back { right: 28px; top: 145px; }
.dtm__zone--glutes { left: 32px; bottom: 126px; }
.dtm__zone--calves { right: 30px; bottom: 54px; }

.dtm__feel-grid,
.dtm__home-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
}

.dtm__feel-card,
.dtm__home-visual {
  position: relative;
  min-height: 520px;
  overflow: hidden;
  border-radius: 8px;
  background: #151615;
}

.dtm__feel-card img,
.dtm__home-visual img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0.78;
}

.dtm__feel-card::after,
.dtm__home-visual::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.08), rgba(0, 0, 0, 0.78));
}

.dtm__feel-copy,
.dtm__home-copy {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
  padding: clamp(24px, 4vw, 42px);
}

.dtm__feel-copy h3,
.dtm__home-copy h3 {
  color: #ffffff;
}

.dtm__feel-copy p,
.dtm__home-copy p {
  margin-top: 12px;
  color: rgba(255, 255, 255, 0.78) !important;
}

.dtm__scan-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24px;
  align-items: stretch;
}

.dtm__scan-card {
  padding: 28px;
  border: 1px solid rgba(255, 255, 255, 0.16);
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.06);
}

.dtm__scan-card h3 {
  margin: 0;
  color: #ffffff;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 30px;
}

.dtm__scan-card ul {
  display: grid;
  gap: 12px;
  margin-top: 18px;
  padding-left: 20px;
}

.dtm__scan-card li {
  color: rgba(255, 255, 255, 0.78);
}

.dtm__price-board {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
}

.dtm__price-card {
  padding: clamp(24px, 3vw, 34px);
}

.dtm__price-card h3 {
  font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: clamp(32px, 4vw, 52px);
  font-weight: 950;
}

.dtm__price-track {
  height: 14px;
  margin-top: 22px;
  overflow: hidden;
  border-radius: 999px;
  background: #e8e2d7;
}

.dtm__price-track i {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, var(--dtm-sage), var(--dtm-gold));
}

.dtm__price-track--dual i { width: 72%; }
.dtm__price-track--man1 i { width: 84%; }

.dtm__price-caption {
  display: flex;
  justify-content: space-between;
  gap: 18px;
  margin-top: 9px;
  color: var(--dtm-muted);
  font-size: 12px;
  font-weight: 800;
}

.dtm__feature-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22px;
  align-items: start;
}

.dtm__feature-column {
  display: grid;
  gap: 12px;
}

.dtm__feature-title {
  display: grid;
  gap: 4px;
  padding: 22px;
  border-radius: 8px;
  background: var(--dtm-ink);
  color: #ffffff;
}

.dtm__feature-title b {
  color: #ffffff;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 28px;
}

.dtm__feature-title span {
  color: rgba(255, 255, 255, 0.72);
}

.dtm__feature {
  display: grid;
  grid-template-columns: 48px 1fr;
  gap: 15px;
  padding: 20px;
}

.dtm__feature-num {
  display: grid;
  place-items: center;
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: var(--dtm-linen);
  color: var(--dtm-gold);
  font-size: 12px;
  font-weight: 950;
}

.dtm__feature p {
  margin-top: 8px;
  font-size: 14px;
}

.dtm__spec-strip {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
  margin-top: 22px;
}

.dtm__stat {
  padding: 18px;
}

.dtm__stat span {
  display: block;
  color: var(--dtm-muted);
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.dtm__stat strong {
  display: block;
  margin-top: 5px;
  font-size: 20px;
}

.dtm__scenario-grid,
.dtm__reactions {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
}

.dtm__scenario,
.dtm__reaction {
  padding: 22px;
}

.dtm__scenario small,
.dtm__reaction span {
  display: inline-flex;
  margin-bottom: 12px;
  color: var(--dtm-gold);
  font-size: 11px;
  font-weight: 950;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.dtm__scenario p {
  margin-top: 10px;
}

.dtm__section--dark .dtm__reaction {
  border-color: rgba(255, 255, 255, 0.14);
  background: rgba(255, 255, 255, 0.07);
  box-shadow: none;
}

.dtm__section--dark .dtm__reaction p {
  color: rgba(255, 255, 255, 0.84) !important;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 20px;
  line-height: 1.45;
}

.dtm__answer {
  max-width: 980px;
  margin: 0 auto;
  padding: clamp(28px, 5vw, 54px);
  border: 1px solid rgba(255, 255, 255, 0.16);
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.06);
}

.dtm__showroom {
  min-height: 640px;
  background:
    linear-gradient(110deg, rgba(21, 21, 21, 0.94), rgba(41, 67, 62, 0.78)),
    #151615;
  color: #ffffff;
}

.dtm__showroom-grid {
  display: grid;
  grid-template-columns: minmax(0, 0.98fr) minmax(400px, 1.02fr);
  gap: 36px;
  align-items: center;
  padding: clamp(60px, 8vw, 110px) 0;
}

.dtm__showroom h2 {
  max-width: 820px;
  margin: 0;
  color: #ffffff;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(34px, 5vw, 58px);
  line-height: 1.05;
}

.dtm__showroom-copy p {
  margin-top: 18px;
  font-size: 18px;
}

.dtm__showroom-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
  margin: 24px 0;
  list-style: none;
}

.dtm__showroom-list li {
  padding: 13px;
  border: 1px solid rgba(255, 255, 255, 0.16);
  border-radius: 8px;
  color: rgba(255, 255, 255, 0.82);
  background: rgba(255, 255, 255, 0.07);
  font-weight: 800;
}

.dtm__showroom-visual {
  display: grid;
  gap: 14px;
}

.dtm__showroom-card {
  display: grid;
  grid-template-columns: 148px 1fr;
  gap: 18px;
  align-items: center;
  padding: 16px;
  border: 1px solid rgba(255, 255, 255, 0.16);
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.09);
}

.dtm__showroom-card img {
  width: 148px;
  height: 148px;
  object-fit: contain;
  border-radius: 6px;
  background: rgba(255, 255, 255, 0.86);
}

.dtm__showroom-card span {
  display: grid;
  gap: 5px;
  color: rgba(255, 255, 255, 0.74);
}

.dtm__showroom-card small {
  color: #e6c67d;
  font-size: 11px;
  font-weight: 950;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.dtm__showroom-card strong {
  color: #ffffff;
  font-size: 25px;
}

.dtm__showroom-vs {
  justify-self: center;
  display: grid;
  place-items: center;
  width: 46px;
  height: 46px;
  border-radius: 50%;
  background: var(--dtm-gold);
  color: #ffffff;
  font-weight: 950;
  text-transform: uppercase;
}

.dtm__faq {
  display: grid;
  gap: 12px;
  max-width: 980px;
  margin: 0 auto;
}

.dtm__faq details {
  border: 1px solid var(--dtm-line);
  border-radius: 8px;
  background: #ffffff;
  box-shadow: 0 8px 18px rgba(21, 21, 21, 0.05);
}

.dtm__faq summary {
  cursor: pointer;
  padding: 18px 22px;
  color: var(--dtm-ink);
  font-weight: 900;
  list-style: none;
}

.dtm__faq summary::-webkit-details-marker {
  display: none;
