.cp-guide-link{display:inline-flex;align-items:center;gap:6px;margin-top:14px;color:var(--accent) !important;font-weight:700 !important;font-size:15px !important}
.cp-guide-link svg{width:16px;height:16px;fill:var(--accent)}

/* ===== MAP ===== */
.cp-map{position:relative;height:400px;overflow:hidden}
.cp-map iframe{width:100%;height:100%;border:none;filter:grayscale(.3) contrast(1.05)}

/* ===== CTA ===== */
.cp-cta{padding:80px 0}
.cp-cta-box{background:var(--dark);border-radius:var(--radius-lg);padding:64px;text-align:center;position:relative;overflow:hidden}
.cp-cta-box::before{content:'';position:absolute;top:0;left:0;right:0;height:4px;background:linear-gradient(90deg,var(--accent),#d4b06a,var(--accent))}
.cp-cta-box::after{content:'';position:absolute;top:-50%;right:-20%;width:500px;height:500px;background:radial-gradient(circle,rgba(184,148,79,.08) 0%,transparent 70%);border-radius:50%;pointer-events:none}
.cp-cta-box .cp-eyebrow{display:inline-block;font-size:12px !important;letter-spacing:.18em;text-transform:uppercase;color:var(--accent);margin-bottom:14px;font-weight:700 !important;position:relative;z-index:1}
.cp-cta-box h2{color:#fff !important;font-size:36px !important;margin-bottom:14px !important;position:relative;z-index:1}
.cp-cta-box p{color:rgba(255,255,255,.7) !important;font-size:17px !important;max-width:600px;margin:0 auto 28px !important;position:relative;z-index:1}
.cp-cta-btns{display:flex;justify-content:center;gap:16px;flex-wrap:wrap;position:relative;z-index:1}
.cp-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:16px 36px !important;font-size:16px !important;font-weight:700 !important;border-radius:50px !important;text-decoration:none !important;transition:var(--transition);border:2px solid transparent !important;cursor:pointer;letter-spacing:.02em;font-family:'Inter',sans-serif !important}
.cp-btn-accent{background:var(--accent) !important;color:#fff !important;border-color:var(--accent) !important}
.cp-btn-accent:hover{background:var(--accent-hover) !important;border-color:var(--accent-hover) !important;transform:translateY(-2px);box-shadow:0 10px 30px rgba(184,148,79,.25)}
.cp-btn-wo{background:transparent !important;color:#fff !important;border:2px solid rgba(255,255,255,.3) !important}
.cp-btn-wo:hover{border-color:#fff !important;background:rgba(255,255,255,.08) !important}
.cp-btn svg{width:18px;height:18px;fill:currentColor}

/* ===== RESPONSIVE ===== */
@media(max-width:1024px){
  .cp-sh-grid{grid-template-columns:repeat(2,1fr)}
  .cp-grid{gap:40px}
  .cp-hero h1{font-size:42px !important}
}
@media(max-width:768px){
