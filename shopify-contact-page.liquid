  .cp-hero .cp-container{padding:56px 20px}
  .cp-hero h1{font-size:32px !important}
  .cp-hero p{font-size:15px !important}
  .cp-quick-inner{grid-template-columns:1fr;margin:0 16px;border-radius:16px}
  .cp-quick-item{border-right:none !important;border-bottom:1px solid var(--border-light);padding:16px 20px}
  .cp-quick-item:last-child{border-bottom:none}
  .cp-qt strong{font-size:14px !important}
  .cp-main{padding:48px 0}
  .cp-grid{grid-template-columns:1fr;gap:32px}
  .cp-form-wrap{padding:24px 20px}
  .cp-form-row{grid-template-columns:1fr}
  .cp-form-hdr h2{font-size:24px !important}
  .cp-showrooms{padding:48px 0}
  .cp-sh-hdr{margin-bottom:32px}
  .cp-sh-hdr h2{font-size:28px !important}
  .cp-sh-grid{grid-template-columns:1fr;gap:16px}
  .cp-sh-card{padding:22px}
  .cp-sh-card h3{font-size:18px !important}
  .cp-cta{padding:48px 0}
  .cp-cta-box{padding:40px 20px;border-radius:16px}
  .cp-cta-box h2{font-size:26px !important}
  .cp-cta-btns{flex-direction:column;align-items:stretch}
  .cp-btn{justify-content:center;padding:14px 24px !important;font-size:15px !important}
  .cp-map{height:280px}
  .cp-container{padding:0 16px}
  .cp-card{padding:22px}
  .cp-card h3{font-size:16px !important}
}
@media(max-width:480px){
  .cp-hero{min-height:35vh}
  .cp-hero h1{font-size:26px !important}
  .cp-hero p{font-size:14px !important}
  .cp-hero .cp-container{padding:44px 16px}
  .cp-sh-card h3{font-size:17px !important}
  .cp-form-hdr h2{font-size:22px !important}
  .cp-cta-box h2{font-size:22px !important}
  .cp-cta-box{padding:32px 16px}
}
</style>

